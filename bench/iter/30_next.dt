#! bench: it.next(), the real thing
#! n: 6000000
#
# The whole of what the two rows above cost, driven by the real iterator.
use std::io::print;
use std::option::Option;
use std::array;

fun main() {
    var xs = array::fill(6000000, 1);
    var sum = 0;
    var it = xs.iter();
    while var Option::Some(x) = it.next() {
        sum += x;
    }
    print("{sum}");
}
