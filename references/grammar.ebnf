(* ducktape grammar — matches src/parser.c as implemented.
   Notation: | alternation, ? optional, * zero-or-more, "" literals.
   Comments run from `#` to end of line. The test harness reads two comment
   prefixes (`#! expect:`, `#>`) but the language treats them as comments. *)

program        = decl* ;

(* ── declarations ─────────────────────────────────────────────────────── *)

decl           = attribute* "pub"? ( useDecl | modDecl | varDecl | funDecl
                                   | structDecl | enumDecl | traitDecl
                                   | implDecl ) ;
                 (* a decl may carry at most one *body* attribute
                    (@native/@intrinsic, funDecl only), at most one @lang marker
                    (funDecl, traitDecl or enumDecl), and any number of @allow —
                    one per lint, since an attribute takes exactly one key. Each
                    is parsed here and rejected on a decl kind it cannot mark,
                    so the mistake is reported rather than reparsed; @allow has
                    no placement rule, covering whatever the decl contains *)

attribute      = "@" ( "native" | "intrinsic" | "lang" | "allow" )
                 "(" STRING ")" ;
                 (* native/intrinsic: a key into C's registry (the fun is
                    bodyless — the attribute *is* the body). lang: a marker that
                    the definition is a compiler lang item, honoured only in the
                    standard library. allow: the name of a warning to silence
                    over this declaration — language.md "Native functions",
                    "Lang items" and "Warnings and `@allow`" *)

modDecl        = "mod" IDENT ";" ;
                 (* declares a child module: it is part of this build unit and
                    is compiled whether or not anything imports it. Where its
                    source lives follows from the tree — a root's children sit
                    beside it, a non-root module's in a directory named after
                    it — so there is nothing else to write down. The name is
                    bound alongside the module's items, so a name is a child or
                    an item and never both. `pub mod` exports the child;
                    `mod` grants no names and no impls, which is what `use` is
                    for — language.md "Modules" *)

useDecl        = "use" usePath ( "as" IDENT )? ";" ;
usePath        = path ( "::" ( "{" useItem ( "," useItem )* ","? "}"
                             | "*" ) )? ;
useItem        = IDENT ( "as" IDENT )? ;
                 (* A path is ABSOLUTE: it is walked from the program root,
                    or from the library root when its first segment is the
                    reserved `std`, consuming a segment for as long as one
                    names a DECLARED child. What is left over says what the
                    import is. Braced: nothing left over means the brace group
                    names items, one segment left names an *enum* whose
                    variants they are. Bare (no braces): nothing left over is a
                    *module import* — the last segment (or the `as` alias)
                    becomes a qualifier, so `use a::b; b::thing` names an item
                    of b without importing it; one segment left is an item, two
                    are an enum and one of its variants. Nothing here asks
                    whether a file exists. Where the walk consumes nothing
                    below the root, the head is read as an enum already in
                    SCOPE, so `use E::V;` names no module at all. `*` takes
                    every variant of the enum; there is no module glob, and a
                    glob takes no `as`. `pub use` re-exports each alias —
                    language.md "Modules" *)

varDecl        = "var" pattern ( ":" type )? "=" expr
                 ( "else" block )? ";" ;
                 (* without the "else" the pattern must be irrefutable, with it
                    refutable — checked, not parsed. The "else" block must
                    diverge. No lookahead disambiguates it from an "if"'s: an
                    "if" initializer has already taken its own.
                    file-scope var parses but is rejected later — known gap *)

funDecl        = "fun" IDENT typeParams? "(" paramList? ")"
                 ( "->" type )? whereClause?
                 ( "=>" expr | block | ";" ) ;
                 (* the ";" form requires an attribute and the other two
                    forbid one: the attribute *is* the body *)
paramList      = param ( "," param )* ;
param          = "self" | IDENT ":" type ;   (* self only in impl methods *)

structDecl     = "struct" IDENT typeParams?
                 ( "{" fieldDecl ( "," fieldDecl )* ","? "}"       (* named  *)
                 | "(" ( "pub"? type ) ( "," "pub"? type )* ")"    (* tuple  *)
                 | ";" ) ;                                         (* unit   *)
fieldDecl      = "pub"? IDENT ":" type ;   (* per-field visibility, private by default *)

enumDecl       = "enum" IDENT typeParams?
                 "{" variantDecl ( "," variantDecl )* ","? "}" ;
(* a variant's payload takes no per-field "pub": it is as visible as its enum *)
variantDecl    = IDENT ( "(" type ( "," type )* ")"
                       | "{" variantFieldDecl ( "," variantFieldDecl )* ","? "}" )? ;
variantFieldDecl = IDENT ":" type ;

traitDecl      = "trait" IDENT typeParams? ( ":" traitBound )?
                 "{" traitItem* "}" ;
                 (* the bound after ":" is the trait's *supertraits*: every type
                    implementing this trait must implement those too, and every
                    bound on this trait offers their methods and associated
                    types. Spelled like a type parameter's bound because that is
                    what it is — a bound on `Self`, which has no `<..>` list to
                    sit in *)
traitItem      = "type" IDENT ";"
               | "fun" IDENT typeParams? "(" paramList? ")"
                 ( "->" type )? whereClause?
                 ( ";" | "=>" expr ";" | block ) ;
                 (* no attribute: a trait method's body is generic over `Self`
                    so it can be neither native nor a lang item, and an `@allow`
                    over a default body is written on the trait.
                    the whereClause may constrain the method's own type
                    parameters and, uniquely here, `Self`'s associated types:
                    `where Self.Item: Ord` is what lets a provided method use
                    an element rather than only pass it along (Iterator::max).
                    A bound on `Self` itself is rejected here — a supertrait is
                    a property of the trait, so it has the one spelling above *)

implDecl       = "impl" typeParams? type ( "for" type )? whereClause?
                 "{" implItem* "}" ;
                 (* with "for": first type is the trait, second is self *)
implItem       = "type" IDENT "=" type ";"
               | attribute* funDecl ;
                 (* method; no "pub" inside impls. An `@native`/`@intrinsic`
                    method has its body in C, exactly like a top-level fun; an
                    `@allow` here sits one scope inside the impl's own. A method
                    is never a lang item, so `@lang` here is rejected —
                    language.md "Native functions" *)

typeParams     = "<" typeParam ( "," typeParam )* ">" ;
typeParam      = IDENT ( ":" traitBound )? ( "=" type )? ;
                 (* a bound may name an earlier parameter of the same list
                    (<T, U: Into<T>>), or the parameter it is itself bounding
                    (<T: Add<T>>).
                    The "=" default is accepted here for every declaration and
                    rejected in sema for all but a *trait*: only a trait is
                    named with arguments after it is declared, so only there is
                    there a place for a default to be read. Defaults must be a
                    suffix of the list, and `Self` in one means the type the
                    trait is being applied to — the impl's self type at an impl
                    head, the bounded parameter at a bound *)
whereClause    = "where" wherePred ( "," wherePred )* ;
wherePred      = ( IDENT | "Self" ) ( "." IDENT )? ":" traitBound ;
                 (* the left side is a type *parameter* of the enclosing
                    declaration, not a general type. With a ".", it is one of
                    that parameter's associated types (`where I.Item: Ord`) —
                    the only way to constrain what an impl binds it to. Deeper
                    paths parse and are then rejected: nothing names the trait
                    a second step would project through.
                    "Self" is legal only in a trait method's clause, and only
                    with a "." — it is the receiver, so the bound is a promise
                    each *call site* discharges rather than an instantiation *)
traitBound     = traitRef ( "+" traitRef )* ;
traitRef       = IDENT dynArgs? ;
                 (* the same bracket a `dyn` takes, and the same parser: the
                    trait's own type arguments (T: Into<Int>) and then its
                    associated-type bindings (J: Iterator<Item = I.Item>).
                    A binding is an *equality* predicate — it says which type
                    the projection is, not which traits it satisfies — and it
                    constrains the parameter being bounded, not the trait, so
                    two bounds naming one trait with different bindings still
                    name one trait *)

(* ── types ────────────────────────────────────────────────────────────── *)

type           = "(" ")"                          (* unit *)
               | "(" type ( "," type )* ")"       (* tuple; single = group *)
               | "fun" "(" ( type ( "," type )* )? ")" "->" type
               | "[" type "]"                     (* array *)
               | "dyn" IDENT dynArgs?             (* trait object *)
               | "Self" assocSuffix?
               | typePath assocSuffix? ;
                 (* "dyn" is required: a bare trait name in type position is
                    the bound spelling (impl/where), never a value type *)
dynArgs        = "<" dynArg ( "," dynArg )* ">" ;
dynArg         = type                             (* the trait's own arg *)
               | IDENT "=" type ;                 (* associated-type binding *)
                 (* two lists in one bracket pair: the trait's type arguments
                    are positional and come first, then one binding per
                    associated type the trait declares, all required. The path
                    after "dyn" is parsed without type arguments, so this "<"
                    is read here rather than by the path *)
typePath       = pathSeg ( "::" pathSeg )* ;
pathSeg        = IDENT ( "::"? "<" type ( "," type )* ">" )? ;
                 (* in type position "::" before "<" is optional *)
assocSuffix    = ( "." IDENT )+ ;                 (* associated types *)

(* ── statements and blocks ────────────────────────────────────────────── *)

block          = "{" stmt* expr? "}" ;
                 (* the trailing expr (no ";") is the block's value; a
                    trailing block-form if/match/loop also counts as the tail *)

stmt           = varDecl
               | "return" expr? ";"
               | "break" expr? ";"
                 (* the value is a `loop`'s; a while/for break may not have one *)
               | "continue" ";"
               | expr ";"
               | ifExpr | matchExpr | whileExpr | loopExpr | forExpr ;
                 (* block-form expressions need no ";" as statements *)

(* ── expressions (lowest to highest precedence) ───────────────────────── *)

expr           = assign ;
assign         = range ( ( "=" | "+=" | "-=" | "*=" | "/=" | "%=" ) assign )? ;
range          = or ( ( ".." | "..=" ) or )? ;         (* Int-only ranges *)
or             = and ( "or" and )* ;
and            = equality ( "and" equality )* ;
equality       = comparison ( ( "==" | "!=" ) comparison )* ;
comparison     = bitor ( ( "<" | "<=" | ">" | ">=" ) bitor )* ;
bitor          = bitxor ( "|" bitxor )* ;
bitxor         = bitand ( "^" bitand )* ;
bitand         = shift ( "&" shift )* ;
shift          = addition ( ( "<<" | ">>" | ">>>" ) addition )* ;
                 (* Int-only, like every bitwise operator here. The bitwise
                    levels sit *above* comparison, which is Rust's ordering:
                    `a & b == c` is `(a & b) == c`, not C's `a & (b == c)`.

                    "<<", ">>" and ">>>" are **not tokens**. A nested generic
                    closes with a run of ">" (`Map<K, Vec<V>>`) that `type`
                    consumes one at a time, so the scanner emits single angle
                    brackets and this rule fuses adjacent ones, requiring that
                    no whitespace separate them — `a > > b` is two comparisons.
                    ">>>" is tried before ">>". *)
addition       = multiply ( ( "+" | "-" ) multiply )* ;
multiply       = unary ( ( "*" | "/" | "%" ) unary )* ;
unary          = ( "not" | "-" | "~" ) unary | postfix ;
postfix        = primary postfixOp* ;
postfixOp      = "(" ( expr ( "," expr )* )? ")"        (* call *)
               | "." IDENT ( "::" "<" type ( "," type )* ">" )?
                 ( "(" ( expr ( "," expr )* )? ")" )?   (* method / field *)
                 (* the turbofish is required, matching `pathSegE`: a bare
                    "<" here would be ambiguous with `comparison`, since
                    `a.b < c` could open a type-argument list. The "::" says
                    which before either side is parsed, so a "<" after a
                    field or method access is always the operator and
                    `a.b < c > (d)` is two comparisons. *)
               | "." INT                                (* tuple access *)
               | "[" expr "]"                           (* index *)
               | "as" "?"? type                         (* cast / downcast *)
                 (* `as` converts between numbers and cannot fail; `as?`
                    downcasts a trait object to one concrete type and yields
                    an `Option`. No type begins with "?", so the peek after
                    the keyword is all that tells the two apart. *)
               | "?" ;                                  (* propagate *)

primary        = INT | FLOAT | CHAR | STRING | interpString
               | "true" | "false"
               | "(" ")"                                (* unit *)
               | "(" expr ( "," expr )* ","? ")"        (* tuple / group *)
               | "[" ( expr ( "," expr )* ","? )? "]"   (* array literal *)
               | closure
               | ifExpr | matchExpr | whileExpr | loopExpr | forExpr
               | block
               | exprPath structInit? ;

closure        = "|" ( closureParam ( "," closureParam )* )? "|"
                 ( "->" type )? ( block | expr ) ;
                 (* `block` is tried first, so a body starting with "{" is a
                    block and never a struct initializer *)
closureParam   = IDENT ( ":" type )? ;

exprPath       = pathSegE ( "::" pathSegE )* ;
                 (* a bare path may also be a value: a unit struct or a unit
                    enum variant, rewritten to an initializer by the checker *)
pathSegE       = IDENT ( "::" "<" type ( "," type )* ">" )? ;
                 (* expression position requires turbofish: Point::<Int>:: *)
structInit     = "{" fieldInit ( "," fieldInit )* ","? "}" ;
fieldInit      = IDENT ":" expr | IDENT ;
                 (* disallowed directly in if/match/while headers *)

ifExpr         = "if" condHead block ( "else" ( ifExpr | block ) )? ;
whileExpr      = "while" condHead block ;
loopExpr       = "loop" block ;
                 (* no header: an endless loop is a shape the grammar has,
                    rather than a condition the checker would have to read *)
condHead       = ( "var" pattern "=" )? expr ;
                 (* with the "var" prefix the expr is the *subject* — matched
                    against the pattern instead of tested as a Bool — and the
                    branch (or the next turn) is taken when it matches. "var"
                    cannot start an expr, so the two forms never collide, and
                    the pattern's own "{" is unambiguous because it sits to the
                    left of the "=" *)
forExpr        = "for" IDENT "in" expr block ;
matchExpr      = "match" expr "{" ( matchArm ","? )* "}" ;
matchArm       = pattern ( "if" expr )? "=>" expr ;

pattern        = "_"
               | INT | FLOAT | CHAR | STRING | "true" | "false"
               | "(" pattern ( "," pattern )* ")"
               | path ( "(" pattern ( "," pattern )* ")"
                      | "{" fieldPat ( "," fieldPat )* ","? "}" )?
               | IDENT ;                                (* binding *)
                 (* a bare IDENT naming a unit struct is that struct's
                    pattern, not a binding — decided by the checker *)
fieldPat       = IDENT ( ":" pattern )? ;

path           = IDENT ( "::" IDENT )* ;

(* ── numbers ──────────────────────────────────────────────────────────── *)

INT            = DIGIT+ ;
FLOAT          = DIGIT+ ( "." DIGIT+ )? EXPONENT
               | DIGIT+ "." DIGIT+ ;
EXPONENT       = ( "e" | "E" ) ( "+" | "-" )? DIGIT+ ;
                 (* an exponent with no digits is not consumed: `1e` scans as
                    INT 1 then IDENT e *)

(* ── strings and characters ───────────────────────────────────────────── *)

interpString   = '"' ( TEXT | "{" expr formatSpec? "}" )* '"' ;
                 (* segments must be Int/Float/Bool/Char/String, or a type
                    implementing std::fmt::Display; escapes:
                    \n \t \r \" \\ \{ *)
formatSpec     = ":" ( CHAR? ( "<" | ">" | "^" ) INT ( "." INT )?
                     | "." INT ) ;
                 (* sugar the checker desugars to std::string::pad_* and
                    std::fmt::float; the fill CHAR defaults to ' '. A width
                    and precision written together ("8.3") lex as one FLOAT. *)

CHAR           = "'" ( UTF8CHAR | CHARESCAPE ) "'" ;
CHARESCAPE     = "\" ( "n" | "t" | "r" | "\\" | "'" | '"' )
               | "\u{" HEXDIGIT{1,6} "}" ;
                 (* exactly one Unicode scalar value: a surrogate half or
                    anything past U+10FFFF is rejected by the scanner. The
                    escape set is the string one with \{ traded for \' —
                    a character literal has no interpolation, and a quote is
                    what closes it *)
