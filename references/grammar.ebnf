(* ducktape grammar — matches src/parser.c as implemented.
   Notation: | alternation, ? optional, * zero-or-more, "" literals.
   Comments run from `#` to end of line. The test harness reads two comment
   prefixes (`#! expect:`, `#>`) but the language treats them as comments. *)

program        = decl* ;

(* ── declarations ─────────────────────────────────────────────────────── *)

decl           = attribute? "pub"? ( useDecl | varDecl | funDecl | structDecl
                                   | enumDecl | traitDecl | implDecl ) ;
                 (* an attribute is only accepted on a funDecl — parsed here
                    and rejected on anything else, so the mistake is reported
                    rather than reparsed *)

attribute      = "@" ( "native" | "intrinsic" ) "(" STRING ")" ;
                 (* the string is a key into C's registry — language.md
                    "Native functions" *)

useDecl        = "use" usePath ";" ;
usePath        = path ( "::" "{" useItem ( "," useItem )* ","? "}" )? ;
useItem        = IDENT ( "as" IDENT )? ;
                 (* leading segments name the file, the last segment or the
                    brace group names the items. `pub use` re-exports each
                    alias as an item of the importing module — language.md
                    "Modules" *)

varDecl        = "var" pattern ( ":" type )? "=" expr ";" ;
                 (* the pattern must be irrefutable — checked, not parsed;
                    file-scope var parses but is rejected later — known gap *)

funDecl        = "fun" IDENT typeParams? "(" paramList? ")"
                 ( "->" type )? whereClause?
                 ( "=>" expr | block | ";" ) ;
                 (* the ";" form requires an attribute and the other two
                    forbid one: the attribute *is* the body *)
paramList      = param ( "," param )* ;
param          = "self" | IDENT ":" type ;   (* self only in impl methods *)

structDecl     = "struct" IDENT typeParams?
                 ( "{" fieldDecl ( "," fieldDecl )* ","? "}"   (* named  *)
                 | "(" type ( "," type )* ")"                  (* tuple  *)
                 | ";" ) ;                                     (* unit   *)
fieldDecl      = IDENT ":" type ;

enumDecl       = "enum" IDENT typeParams?
                 "{" variantDecl ( "," variantDecl )* ","? "}" ;
variantDecl    = IDENT ( "(" type ( "," type )* ")"
                       | "{" fieldDecl ( "," fieldDecl )* ","? "}" )? ;

traitDecl      = "trait" IDENT typeParams? "{" traitItem* "}" ;
traitItem      = "type" IDENT ";"
               | "fun" IDENT typeParams? "(" paramList? ")"
                 ( "->" type )? whereClause?
                 ( ";" | "=>" expr ";" | block ) ;

implDecl       = "impl" typeParams? type ( "for" type )? whereClause?
                 "{" implItem* "}" ;
                 (* with "for": first type is the trait, second is self *)
implItem       = "type" IDENT "=" type ";"
               | funDecl ;    (* method; no "pub" inside impls *)

typeParams     = "<" typeParam ( "," typeParam )* ">" ;
typeParam      = IDENT ( ":" traitBound )? ;
                 (* inline bounds parse; the checker rejects them for now *)
whereClause    = "where" wherePred ( "," wherePred )* ;
wherePred      = type ":" traitBound ;
traitBound     = path ( "+" path )* ;

(* ── types ────────────────────────────────────────────────────────────── *)

type           = "(" ")"                          (* unit *)
               | "(" type ( "," type )* ")"       (* tuple; single = group *)
               | "fun" "(" ( type ( "," type )* )? ")" "->" type
               | "[" type "]"                     (* array *)
               | "dyn" typePath                   (* trait object *)
               | "Self" assocSuffix?
               | typePath assocSuffix? ;
                 (* "dyn" is required: a bare trait name in type position is
                    the bound spelling (impl/where), never a value type *)
typePath       = pathSeg ( "::" pathSeg )* ;
pathSeg        = IDENT ( "::"? "<" type ( "," type )* ">" )? ;
                 (* in type position "::" before "<" is optional *)
assocSuffix    = ( "." IDENT )+ ;                 (* associated types *)

(* ── statements and blocks ────────────────────────────────────────────── *)

block          = "{" stmt* expr? "}" ;
                 (* the trailing expr (no ";") is the block's value; a
                    trailing block-form if/match also counts as the tail *)

stmt           = varDecl
               | "return" expr? ";"
               | "break" ";"
               | "continue" ";"
               | expr ";"
               | ifExpr | matchExpr | whileExpr | forExpr ;
                 (* block-form expressions need no ";" as statements *)

(* ── expressions (lowest to highest precedence) ───────────────────────── *)

expr           = assign ;
assign         = range ( ( "=" | "+=" | "-=" | "*=" | "/=" ) assign )? ;
range          = or ( ( ".." | "..=" ) or )? ;         (* Int-only ranges *)
or             = and ( "or" and )* ;
and            = equality ( "and" equality )* ;
equality       = comparison ( ( "==" | "!=" ) comparison )* ;
comparison     = addition ( ( "<" | "<=" | ">" | ">=" ) addition )* ;
addition       = multiply ( ( "+" | "-" ) multiply )* ;
multiply       = unary ( ( "*" | "/" | "%" ) unary )* ;
unary          = ( "not" | "-" ) unary | postfix ;
postfix        = primary postfixOp* ;
postfixOp      = "(" ( expr ( "," expr )* )? ")"        (* call *)
               | "." IDENT ( "<" type ( "," type )* ">" )?
                 ( "(" ( expr ( "," expr )* )? ")" )?   (* method / field *)
               | "." INT                                (* tuple access *)
               | "[" expr "]"                           (* index *)
               | "as" type                              (* cast *)
               | "?" ;                                  (* propagate *)

primary        = INT | FLOAT | STRING | interpString | "true" | "false"
               | "(" ")"                                (* unit *)
               | "(" expr ( "," expr )* ","? ")"        (* tuple / group *)
               | "[" ( expr ( "," expr )* ","? )? "]"   (* array literal *)
               | closure
               | ifExpr | matchExpr | whileExpr | forExpr
               | block
               | exprPath structInit? ;

closure        = "|" ( closureParam ( "," closureParam )* )? "|"
                 ( "->" type )? ( "=>" expr | block ) ;
closureParam   = IDENT ( ":" type )? ;

exprPath       = pathSegE ( "::" pathSegE )* ;
                 (* a bare path may also be a value: a unit struct or a unit
                    enum variant, rewritten to an initializer by the checker *)
pathSegE       = IDENT ( "::" "<" type ( "," type )* ">" )? ;
                 (* expression position requires turbofish: Point::<Int>:: *)
structInit     = "{" fieldInit ( "," fieldInit )* ","? "}" ;
fieldInit      = IDENT ":" expr | IDENT ;
                 (* disallowed directly in if/match/while headers *)

ifExpr         = "if" expr block ( "else" ( ifExpr | block ) )? ;
whileExpr      = "while" expr block ;
forExpr        = "for" IDENT "in" expr block ;
matchExpr      = "match" expr "{" ( matchArm ","? )* "}" ;
matchArm       = pattern ( "if" expr )? "=>" expr ;

pattern        = "_"
               | INT | FLOAT | STRING | "true" | "false"
               | "(" pattern ( "," pattern )* ")"
               | path ( "(" pattern ( "," pattern )* ")"
                      | "{" fieldPat ( "," fieldPat )* ","? "}" )?
               | IDENT ;                                (* binding *)
                 (* a bare IDENT naming a unit struct is that struct's
                    pattern, not a binding — decided by the checker *)
fieldPat       = IDENT ( ":" pattern )? ;

path           = IDENT ( "::" IDENT )* ;

(* ── numbers ──────────────────────────────────────────────────────────── *)

INT            = DIGIT+ ;
FLOAT          = DIGIT+ ( "." DIGIT+ )? EXPONENT
               | DIGIT+ "." DIGIT+ ;
EXPONENT       = ( "e" | "E" ) ( "+" | "-" )? DIGIT+ ;
                 (* an exponent with no digits is not consumed: `1e` scans as
                    INT 1 then IDENT e *)

(* ── strings ──────────────────────────────────────────────────────────── *)

interpString   = '"' ( TEXT | "{" expr "}" )* '"' ;
                 (* segments must be Int/Float/Bool/String; escapes:
                    \n \t \r \" \\ \{ *)
