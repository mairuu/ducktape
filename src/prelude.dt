trait Iterator {
  fun has_next(self);
  fun next(self);
  fun map(self, fn) {
    var inner = self;
    return impl Iterator {
      fun next(self) => fn(inner.next());
      fun has_next(self) => inner.has_next();
    };
  }
  fun filter(self, pred) {
    var inner = self;
    var peeked = nil;
    return impl Iterator {
      fun has_next(self) {
        if peeked != nil {
          return true;
        }
        for inner.has_next() {
          var v = inner.next();
          if pred(v) {
              peeked = v;
              return true;
          }
        }
        return false;
      }
      fun next(self) {
        self.has_next();
        var v = peeked;
        peeked = nil;
        return v;
      }
    };
  }
  fun skip(self, n) {
    var inner = self;
    return impl Iterator {
      fun has_next(self) {
        for n > 0 and inner.has_next() {
          inner.next();
          n -= 1;
        }
        return inner.has_next();
      } 
      fun next(self) => inner.next();
    };
  }
  fun take(self, n) {
    var inner = self;
    var i = -1;
    return impl Iterator {
      fun has_next(self) => (i += 1) < n and inner.has_next();
      fun next(self) => inner.next();
    };
  }
  fun collect(self) {
    var res = array();
    for self.has_next() {
      res.push(self.next());
    }
    return res;
  }
}

trait Iterable {
  fun iter(self) => self as Iterator;
}

{
  var bind = __builtin_bind;
  bind(__BUILTIN_ITERATOR, Iterator);
  bind(__BUILTIN_ITERABLE, Iterable);
}