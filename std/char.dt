# std::char — a Unicode scalar value.
#
# A `String` is bytes and a `char` is a character, and those are two different
# things: `std::string::len` counts bytes, `slice` cuts at byte offsets, and
# `compare` walks bytes. That was consistent while nothing could look *inside*
# a String, and a char is the first thing that can — so the two views stay
# apart and the crossing between them is `std::string::chars`, a conversion,
# never an index. There is deliberately no `char_at(s, i)`: a byte offset is
# not a character position, and that spelling would make confusing the two the
# default rather than the mistake.
#
# What a char cannot express about itself is its *number*, so `code` and
# `from_code` are the whole of this module's C surface and everything below
# them is ordinary ducktape. That is milestone 23's rule, and it cuts deeper
# here than it did for arrays: a code point is an int, so every classification
# is a range test and every case conversion is an addition. Nothing in this
# file needed a native, and nothing in it needed the compiler to know anything
# about `char` beyond the name of the type.
#
# `std::char` ships one impl, on its own `char` (milestone 40): the
# classifications and case conversions are **methods** now — `c.is_alpha()`,
# `c.to_upper()`, `c.code()` — and `from_code` is the associated constructor
# `char::from_code(n)`. The module it imports (`std::panic`, for `to_digit`)
# ships none, so importing `std::char` hands a program methods on `char` and
# nothing more. That `char` impl is the whole of what `std::cmp` inherits by
# depending on this module for `impl Ord for char` — a cost paid in one type's
# methods rather than in a trait impl coherence could take away.
#
# **The classifications are ASCII-only.** `'é'.is_alpha()` is false and
# `'é'.to_upper()` is `'é'` unchanged. Full Unicode case mapping is a table
# large enough to be its own project, and it is not one a range test can
# approximate: the honest thing is to say the limit out loud rather than to
# ship something that is right for English and quietly wrong elsewhere.

use std::panic::panic;

impl char {
    # The scalar value, as a number: 'A' is 65, '😀' is 128512.
    @native("char_code")
    fun code(self) -> int;

    # The inverse. A runtime error if `n` is not a Unicode scalar value —
    # negative, past U+10FFFF, or one half of a surrogate pair, none of which is
    # a character. That check is what lets every other part of the runtime take
    # for granted that a char it holds can be encoded.
    @native("char_from_code")
    fun from_code(n: int) -> char;

    fun is_ascii(self) -> bool {
        return self.code() < 128;
    }

    fun is_digit(self) -> bool {
        var n = self.code();
        return n >= '0'.code() and n <= '9'.code();
    }

    fun is_lower(self) -> bool {
        var n = self.code();
        return n >= 'a'.code() and n <= 'z'.code();
    }

    fun is_upper(self) -> bool {
        var n = self.code();
        return n >= 'A'.code() and n <= 'Z'.code();
    }

    fun is_alpha(self) -> bool {
        return self.is_lower() or self.is_upper();
    }

    fun is_alnum(self) -> bool {
        return self.is_alpha() or self.is_digit();
    }

    fun is_whitespace(self) -> bool {
        return self == ' ' or self == '\t' or self == '\n' or self == '\r';
    }

    # ASCII case conversion; anything else is returned unchanged. The distance
    # between the two alphabets is a constant, which is the whole implementation
    # — and also the whole reason this cannot be generalised, since no other
    # script is laid out that obligingly.
    fun to_upper(self) -> char {
        if self.is_lower() {
            return char::from_code(self.code() - 'a'.code() + 'A'.code());
        }
        return self;
    }

    fun to_lower(self) -> char {
        if self.is_upper() {
            return char::from_code(self.code() - 'A'.code() + 'a'.code());
        }
        return self;
    }

    # The digit a character spells, or a runtime error if it spells none. `'7'`
    # is 55 as a code point and 7 as a digit; nothing but subtraction tells them
    # apart, which is why this is a method rather than a cast.
    fun to_digit(self) -> int {
        if not self.is_digit() {
            return panic("not a digit");
        }
        return self.code() - '0'.code();
    }
}
