# std::cmp — ordering.
#
# Written in ducktape, not in C: `impl Ord for int` is legal, so the standard
# library can extend the primitives with the same trait machinery user code
# uses. Only `String` reaches for a native, and it does so through
# `std::string` rather than declaring one here.
#
# That import is the module's one real cost, because impl visibility is
# transitive: importing `std::string` hands every dependent of `std::cmp`
# whatever impls `std::string` ships. It ships none — it is a module of free
# functions — so the set grows by exactly the `impl Ord for String` below. The
# other direction would not have been so cheap: putting the impl in
# `std::string` would hand a program that only wanted `len` the three impls
# here, and with them coherence's refusal to let it write its own `impl Ord
# for int`. With transitive visibility an import is measured in impls, not in
# code, so the dependency points at the impl-poor module.
#
# Placing the impl beside the *trait* is also what `std::fmt` already does:
# `impl Display for String` lives there, not in `std::string`.
#
# `Ord` is deliberately *not* object-safe — `other: Self` means a caller has to
# know the concrete type — so it is a bound, never a `dyn Ord`. That is the
# rule working as intended: object safety is only demanded where `dyn` is
# written (see language.md "Trait objects").

# Imported as modules, not by item: `compare` and `code` are methods now
# (milestone 40), and a method travels with its impl by reachability rather than
# through a named import — so the `use` is only here to make `impl String` and
# `impl char` visible, and the receiver spellings `self.compare(..)` /
# `self.code()` do the rest.
use std::string;
use std::char;

# `len` again, spelled here rather than reached through `std::array`. `impl Ord
# for [T]` below needs an array's length, but `use std::array` cannot be written:
# `std::array` reaches `std::option`, which reaches this module, so the import
# would close a cycle the dependency graph rejects — and now that `len` is a
# *method* on `[T]` (milestone 40), reaching it means having `std::array`'s impl
# visible, which is exactly the import the cycle forbids. An `@intrinsic` free
# function is the way out and stays one: an intrinsic is not a definition owned
# by a module, it is a *spelling for an opcode*. `OP_LEN` is program-wide, so
# naming it a second time costs nothing and depends on nothing, and the cycle
# that blocks the *method* does not block the length it needs. Private and a
# free function, since `xs.len()` is the method a program calls.
@intrinsic("array_len")
fun len<T>(xs: [T]) -> int;

@lang("ord")
pub trait Ord {
    # <0 if self sorts before other, 0 if equal, >0 if after.
    fun cmp(self, other: Self) -> int;

    fun lt(self, other: Self) -> bool { return self.cmp(other) < 0; }
    fun gt(self, other: Self) -> bool { return self.cmp(other) > 0; }
    fun le(self, other: Self) -> bool { return self.cmp(other) <= 0; }
    fun ge(self, other: Self) -> bool { return self.cmp(other) >= 0; }
}

impl Ord for int {
    fun cmp(self, other: int) -> int {
        if self < other {
            return 0 - 1;
        }
        if self > other {
            return 1;
        }
        return 0;
    }
}

# IEEE comparison alone is not a total order: every `<`/`>`/`==` involving a NaN
# is false, so the naive three-branch `cmp` returns 0 for `NaN.cmp(x)` at every
# `x` — NaN compares *equal to everything*, and `max`/`min`/sort give an answer
# that depends on argument order. `Ord` promises a total order, so this impl
# decides where NaN goes: **NaN sorts after every real number, and all NaNs are
# equal to each other.** That is the one placement that keeps `cmp` transitive
# (a real x is < NaN for all x, and NaN is neither < nor > another NaN) while
# needing nothing the language cannot already express — the sign bit and the
# payload are ignored, so a `-NaN` and a `+NaN` are the same order, unlike Rust's
# `total_cmp`. `self != self` is the NaN test: only NaN is unequal to itself, and
# `!=` is IEEE on float (`value_equal` compares the bits with `==`).
impl Ord for float {
    fun cmp(self, other: float) -> int {
        if self != self {
            if other != other {
                return 0;
            }
            return 1;
        }
        if other != other {
            return 0 - 1;
        }
        if self < other {
            return 0 - 1;
        }
        if self > other {
            return 1;
        }
        return 0;
    }
}

# The one impl here that is not a comparison the VM could already make. `<` and
# `>` stay numeric-only opcodes — ordering anything else is a trait, not an
# operator — so this is the whole of how a program compares two Strings.
impl Ord for String {
    fun cmp(self, other: String) -> int {
        return self.compare(other);
    }
}

# Code-point order, which is what a char *is*: unlike `String` this needs no
# native at all, because `c.code()` already hands the comparison two ints and
# `<` is a numeric opcode. The dependency costs only `std::char`'s own `char`
# methods — it ships that one impl and nothing else, and neither does what it
# imports.
#
# It agrees with `impl Ord for String` on one-character strings, since UTF-8
# byte order and code-point order are the same order. It disagrees with a
# reader's expectations in the same places: 'Z' sorts before 'a'.
impl Ord for char {
    fun cmp(self, other: char) -> int {
        var a = self.code();
        var b = other.code();
        if a < b {
            return 0 - 1;
        }
        if a > b {
            return 1;
        }
        return 0;
    }
}

# ── the containers ────────────────────────────────────────────────────────────
#
# An array and a tuple have no module of their own, so their impls live beside
# the trait — exactly where `std::fmt` keeps `Display for [T]` and `Display for
# (A, B)`, and for the same reason: the impl belongs next to the type, and the
# trait's module is the closest thing an array or a tuple has to one.

# Lexicographic order: the first element that differs decides, and if one array
# is a prefix of the other the shorter sorts first. The element goes through
# `Ord` in turn, so `[Point]` orders by `Point`'s own `cmp` — the bound is what
# makes that a compile-time error where the element has none, checked (since
# milestone 20) where the impl is selected.
impl<T: Ord> Ord for [T] {
    fun cmp(self, other: [T]) -> int {
        var n = len(self);
        var m = len(other);
        var i = 0;
        while i < n {
            if i >= m {
                return 1;
            }
            var c = self[i].cmp(other[i]);
            if c != 0 {
                return c;
            }
            i = i + 1;
        }
        if m > n {
            return 0 - 1;
        }
        return 0;
    }
}

# Arity is per-impl: a tuple's length is part of its type and the language has no
# way to be generic over it, so a 3-tuple would need its own impl — the same
# limit `std::fmt` records. Each field is ordered in turn, `.0` before `.1`.
impl<A: Ord, B: Ord> Ord for (A, B) {
    fun cmp(self, other: (A, B)) -> int {
        var c = self.0.cmp(other.0);
        if c != 0 {
            return c;
        }
        return self.1.cmp(other.1);
    }
}

pub fun max<T: Ord>(a: T, b: T) -> T {
    if a.cmp(b) < 0 {
        return b;
    }
    return a;
}

pub fun min<T: Ord>(a: T, b: T) -> T {
    if a.cmp(b) < 0 {
        return a;
    }
    return b;
}

pub fun clamp<T: Ord>(v: T, lo: T, hi: T) -> T {
    return min(max(v, lo), hi);
}
