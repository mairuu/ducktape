# std::cmp — ordering.
#
# Written in ducktape, not in C: `impl Ord for Int` is legal, so the standard
# library can extend the primitives with the same trait machinery user code
# uses. Nothing here needs a native.
#
# `Ord` is deliberately *not* object-safe — `other: Self` means a caller has to
# know the concrete type — so it is a bound, never a `dyn Ord`. That is the
# rule working as intended: object safety is only demanded where `dyn` is
# written (see language.md "Trait objects").

pub trait Ord {
    # <0 if self sorts before other, 0 if equal, >0 if after.
    fun cmp(self, other: Self) -> Int;

    fun lt(self, other: Self) -> Bool { return self.cmp(other) < 0; }
    fun gt(self, other: Self) -> Bool { return self.cmp(other) > 0; }
    fun le(self, other: Self) -> Bool { return self.cmp(other) <= 0; }
    fun ge(self, other: Self) -> Bool { return self.cmp(other) >= 0; }
}

impl Ord for Int {
    fun cmp(self, other: Int) -> Int {
        if self < other {
            return 0 - 1;
        }
        if self > other {
            return 1;
        }
        return 0;
    }
}

impl Ord for Float {
    fun cmp(self, other: Float) -> Int {
        if self < other {
            return 0 - 1;
        }
        if self > other {
            return 1;
        }
        return 0;
    }
}

pub fun max<T: Ord>(a: T, b: T) -> T {
    if a.cmp(b) < 0 {
        return b;
    }
    return a;
}

pub fun min<T: Ord>(a: T, b: T) -> T {
    if a.cmp(b) < 0 {
        return a;
    }
    return b;
}

pub fun clamp<T: Ord>(v: T, lo: T, hi: T) -> T {
    return min(max(v, lo), hi);
}
