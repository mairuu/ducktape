# std::cmp — ordering.
#
# Written in ducktape, not in C: `impl Ord for Int` is legal, so the standard
# library can extend the primitives with the same trait machinery user code
# uses. Only `String` reaches for a native, and it does so through
# `std::string` rather than declaring one here.
#
# That import is the module's one real cost, because impl visibility is
# transitive: importing `std::string` hands every dependent of `std::cmp`
# whatever impls `std::string` ships. It ships none — it is a module of free
# functions — so the set grows by exactly the `impl Ord for String` below. The
# other direction would not have been so cheap: putting the impl in
# `std::string` would hand a program that only wanted `len` the three impls
# here, and with them coherence's refusal to let it write its own `impl Ord
# for Int`. With transitive visibility an import is measured in impls, not in
# code, so the dependency points at the impl-poor module.
#
# Placing the impl beside the *trait* is also what `std::fmt` already does:
# `impl Display for String` lives there, not in `std::string`.
#
# `Ord` is deliberately *not* object-safe — `other: Self` means a caller has to
# know the concrete type — so it is a bound, never a `dyn Ord`. That is the
# rule working as intended: object safety is only demanded where `dyn` is
# written (see language.md "Trait objects").

use std::string::compare;
use std::char::code;

pub trait Ord {
    # <0 if self sorts before other, 0 if equal, >0 if after.
    fun cmp(self, other: Self) -> Int;

    fun lt(self, other: Self) -> Bool { return self.cmp(other) < 0; }
    fun gt(self, other: Self) -> Bool { return self.cmp(other) > 0; }
    fun le(self, other: Self) -> Bool { return self.cmp(other) <= 0; }
    fun ge(self, other: Self) -> Bool { return self.cmp(other) >= 0; }
}

impl Ord for Int {
    fun cmp(self, other: Int) -> Int {
        if self < other {
            return 0 - 1;
        }
        if self > other {
            return 1;
        }
        return 0;
    }
}

impl Ord for Float {
    fun cmp(self, other: Float) -> Int {
        if self < other {
            return 0 - 1;
        }
        if self > other {
            return 1;
        }
        return 0;
    }
}

# The one impl here that is not a comparison the VM could already make. `<` and
# `>` stay numeric-only opcodes — ordering anything else is a trait, not an
# operator — so this is the whole of how a program compares two Strings.
impl Ord for String {
    fun cmp(self, other: String) -> Int {
        return compare(self, other);
    }
}

# Code-point order, which is what a Char *is*: unlike `String` this needs no
# native at all, because `std::char::code` already hands the comparison two
# Ints and `<` is a numeric opcode. The import costs nothing beyond the
# function — `std::char` ships no impls, and neither does what it imports.
#
# It agrees with `impl Ord for String` on one-character strings, since UTF-8
# byte order and code-point order are the same order. It disagrees with a
# reader's expectations in the same places: 'Z' sorts before 'a'.
impl Ord for Char {
    fun cmp(self, other: Char) -> Int {
        var a = code(self);
        var b = code(other);
        if a < b {
            return 0 - 1;
        }
        if a > b {
            return 1;
        }
        return 0;
    }
}

pub fun max<T: Ord>(a: T, b: T) -> T {
    if a.cmp(b) < 0 {
        return b;
    }
    return a;
}

pub fun min<T: Ord>(a: T, b: T) -> T {
    if a.cmp(b) < 0 {
        return a;
    }
    return b;
}

pub fun clamp<T: Ord>(v: T, lo: T, hi: T) -> T {
    return min(max(v, lo), hi);
}
