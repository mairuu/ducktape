# std::collections — the group's module, and the group's facade.
#
# The directory is not the module: this file is, and `pub mod` below is what
# puts anything under `std/collections/` on a path at all. The `pub use` lines
# beside them are the short spelling — `use std::collections::HashMap;` without
# naming the module the type happens to live in.
pub mod hashmap;
pub mod hashset;

pub use std::collections::hashmap::{HashMap, MapIter};
pub use std::collections::hashset::HashSet;
