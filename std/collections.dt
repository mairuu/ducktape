# std::collections — the group's facade.
#
# A directory is a path prefix, not a module: `std/collections/` alone would
# make `use std::collections::HashMap;` an error and force every caller to name
# the module the type happens to live in. This file sits beside that directory
# and re-exports what is under it, which is the whole of what makes a group
# nameable. Nothing generates it — a module added below has to be added here too
# or it is reachable only by its full path.
pub use std::collections::hashmap::{HashMap, MapIter};
pub use std::collections::hashset::HashSet;
