# std::collections — the group's module, and the group's facade.
#
# The directory is not the module: this file is, and `mod` below is what puts
# anything under `std/collections/` on a path at all. Both children are private,
# so the `pub use` lines are not a *short* spelling but the only one: a type has
# one name, and which file holds it is a layout decision this group keeps to
# itself. `hashset` still reaches `hashmap` — a private module is reachable from
# everything in its declarer's subtree, which is where the two siblings live.
#
# Globbed rather than listed, because a facade that names its types has to be
# edited every time one is added — and a type added below a private child with
# nothing re-exporting it is reachable from nowhere, silently. `*` is the whole
# export set by construction, which is what a facade means.
mod hashmap;
mod hashset;

pub use std::collections::hashmap::*;
pub use std::collections::hashset::*;
