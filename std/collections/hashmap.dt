# std::collections::hashmap — a `HashMap<K, V>`. The `HashSet<T>` written on it
# is the sibling module `std::collections::hashset`.
#
# Open addressing with linear probing: one array of slots, and a key that finds
# its slot occupied walks forward until it finds a free one. The alternative —
# a bucket array of chains — needs an allocation per entry and a `[[(K, V)]]`
# whose inner arrays are mostly length one, so it costs more memory to store
# less locality. This is also the shape the VM's own string table already has
# (`heap->strings`, open-addressed and tombstoned), which makes this module the
# ducktape rewrite of a map the runtime was already keeping.
#
# **What this milestone set out to answer is what it does *not* need.** The
# roadmap held `Eq` back until a consumer asked for it, and a hash map keyed by
# user types was named as that consumer. It turns out not to be one: `==` in
# ducktape is a structural primitive with no trait behind it, so `k == key`
# below type-checks on a `K` whose only bound is `Hash`, and it compares ints,
# Strings, structs and tuples alike with one opcode. A map needs equality, gets
# it from the language, and spends its bound entirely on *hashing*. So the trait
# a table wants is `Hash`, and `Eq` goes on waiting for a different consumer.
#
# It also makes the `Hash`/`Eq` contract — the thing that is easy to break in a
# language with a custom equality — nearly unbreakable here. Equal values must
# hash equal; equality is structural and cannot be overridden; so any `hash` that
# reads only the value's own contents is correct by construction.

use std::option::Option;
use std::hash::{Hash, hash_of};
use std::panic::panic;
use std::iter::Iterator;
use std::array;

# The three states a slot can be in. `Tomb` is the price of open addressing: a
# removal cannot simply empty a slot, because a probe that stopped there would
# fail to find keys that had walked *past* it on the way in. So a removed slot
# stays a wall to probes and becomes free again only at the next rehash.
#
# An enum, rather than the parallel `[K]` + `[V]` + `[int]` a C implementation
# would reach for, because the array of keys is the problem: `[K]` has to be
# *filled* with something at every empty slot, and a generic `K` has no default
# value to fill it with. A payload variant sidesteps the question — `Empty` holds
# nothing, so there is nothing to invent.
#
# Private: which slot a key landed in is not something a caller can act on.
enum Slot<K, V> {
    Empty,
    Tomb,
    Full(K, V),
}

# `Empty` carries no payload, so every free slot is the *same* interned instance
# (milestone 67) — which is exactly the condition `fill` needs. Its one trap is
# that it copies rather than clones, and a copied reference is n names for one
# object; here that was already the case, because the loop this replaced pushed
# the same singleton `n` times. A fieldless variant has no observable identity
# for the sharing to be observable *through*.
fun empty_slots<K, V>(n: int) -> [Slot<K, V>] {
    return array::fill(n, Slot::Empty);
}

# The smallest power of two at least `n`, and never below 8 — a table small
# enough to grow on its second insert is not worth the arithmetic.
#
# **Capacities are powers of two, and the reduction is a mask.** This module
# used primes and `%` until milestone 66, for the blunt reason that the language
# had no `&`: without a mask nothing pushed toward powers of two, and a prime is
# `%`'s natural partner. The operators exist now, so the ordinary choice is
# available and this takes it.
#
# What made it safe to take is a decision `std::hash` had already made. Masking
# reads only the *low* bits of a hash, so it is the arrangement that a hash with
# structure down there ruins — which is why a prime is worth paying for when a
# table cannot know what it will be handed. This table does know: `Hash` writes
# into a `Hasher` rather than returning a number, so **every hash that reaches
# here has been through `mix`**, whose last step is a shift-xor that brings the
# high bits down. A program cannot hand this table a raw hash even if it wants
# to. The trait shape milestone 63 chose for one reason turns out to buy this
# for another.
fun capacity_for(n: int) -> int {
    var c = 8;
    # `c > 0` is a termination guard rather than a real case: reaching it means
    # `c` has overflowed past 2^62 slots, and an array that long exhausts memory
    # a long way before the arithmetic runs out.
    while c < n and c > 0 {
        c = c << 1;
    }
    return c;
}

# How many *slots* a table needs so that `n` *entries* fit without rehashing.
#
# **These are two different numbers, and confusing them is what this milestone
# is about.** A caller counts entries; the table counts slots; the load factor
# is the conversion between them, and until now every caller had to apply it by
# hand. `rehash` takes slots, so `m.rehash(1000)` gives 1024 of them and the
# 769th insert rehashes anyway — the pre-size is lost for every `n` in the top
# quarter of a power-of-two range, which is to say for a quarter of all
# arguments and for the round ones people actually type.
#
# Growth triggers when `(used + 1) * 4 > slots * 3`, so `n` entries need
# `slots * 3 >= n * 4`, and the smallest such slot count is `ceil(4n/3)` rounded
# up to a power of two. `(n * 4 + 2) / 3` is that ceiling in integer division.
fun slots_for(n: int) -> int {
    return capacity_for((n * 4 + 2) / 3);
}

# `live` is the number of entries a caller can see; `used` counts those *and*
# the tombstones, because it is occupancy of the probe sequence rather than
# population that decides when probing gets slow. Keeping both is what lets a
# table that has had everything removed from it shrink at the next rehash
# instead of growing forever.
pub struct HashMap<K: Hash, V> {
    slots: [Slot<K, V>],
    live: int,
    used: int,
}

impl<K: Hash, V> HashMap<K, V> {
    fun new() -> HashMap<K, V> {
        return HashMap::with_capacity(0);
    }

    # A map that can take `n` entries before it rehashes — the whole of
    # pre-sizing, in the units a caller has.
    #
    # `n` is an *entry* count, not a slot count, which is the one thing that
    # makes this more than an alias for `new` plus `rehash`. It is also a
    # promise the type can keep: nothing else has touched the table, so there
    # are no tombstones to eat into the room and no live entries to raise the
    # floor. `with_capacity(0)` is `new` — `slots_for(0)` is the same minimum 8
    # that `capacity_for` imposes on everything else.
    fun with_capacity(n: int) -> HashMap<K, V> {
        var slots: [Slot<K, V>] = empty_slots(slots_for(n));
        return HashMap { slots: slots, live: 0, used: 0 };
    }

    # How many entries the map holds. Tombstones are not entries.
    fun len(self) -> int {
        return self.live;
    }

    # How much the table has room for before the next rehash, in entries.
    #
    # **What it counts is occupancy, not population.** `capacity() - len()` is
    # therefore the room left only in a map nothing has been removed from: a
    # tombstone occupies the probe sequence and counts toward the load, so a map
    # that has had removals takes fewer further entries than that subtraction
    # suggests. The rehash they eventually trigger clears them, which is what
    # makes this a smaller promise rather than a broken one.
    #
    # It exists because the slot array is private and a rehash is otherwise
    # unobservable — a program cannot tell a pre-sized build from a grown one,
    # and neither could a test. Timing would be the alternative, and a timing
    # test is not a test.
    fun capacity(self) -> int {
        return self.slots.len() * 3 / 4;
    }

    # Make room for `more` further entries, rehashing once if the table does not
    # already have it.
    #
    # The pair to `with_capacity` for a map that already exists — and the two
    # counters part company here the way they do in `reserve_one`. Whether to
    # act reads `used`, because tombstones are what will actually be in the way;
    # the size to ask for reads `live`, because a rehash drops them. A map whose
    # capacity is spent entirely on tombstones therefore reserves by *cleaning*
    # and may not grow at all.
    fun reserve(self, more: int) {
        if (self.used + more) * 4 <= self.slots.len() * 3 {
            return;
        }
        self.rehash(slots_for(self.live + more));
    }

    fun is_empty(self) -> bool {
        return self.live == 0;
    }

    # The mask that turns a hash, or a walked index, into a slot. One less than
    # the capacity, which is all a power of two needs.
    fun mask(self) -> int {
        return self.slots.len() - 1;
    }

    # Where `key`'s probe sequence begins.
    #
    # **The sign takes care of itself here**, which it did not under `%`. A hash
    # spans the whole of `int`, negatives included, and `%` keeps the sign of its
    # left operand — so the modulo form had to fold a negative result back into
    # range, and getting that wrong was an out-of-bounds read rather than merely
    # a bad distribution. Masking against a positive mask clears the high bits
    # along with the sign, so the fold has nothing left to do and this is one
    # expression again.
    fun start(self, key: K) -> int {
        return hash_of(key) & self.mask();
    }

    # Make sure one more entry fits, rehashing if it would not.
    #
    # The load factor is 3/4 and it is measured against `used`, so tombstones
    # count toward triggering a rehash even though they are not entries — that is
    # what stops a workload of insert-then-remove from filling the table with
    # walls nothing ever clears. The *target* size is computed from `live`, so
    # such a workload rehashes at the same capacity rather than doubling: the
    # cleanup and the growth are the same operation, told apart by which counter
    # they read.
    fun reserve_one(self) {
        if (self.used + 1) * 4 <= self.slots.len() * 3 {
            return;
        }
        self.rehash(self.live * 2 + 1);
    }

    # Rebuild the table, dropping every tombstone on the way.
    #
    # **`cap` is a number of slots**, and that is why this is no longer the
    # documented way to pre-size a map: `with_capacity` and `reserve` are, and
    # they take entries. This one stays public and stays the primitive both of
    # them are written on, since the rebuild is the same operation whichever
    # number asks for it.
    #
    # **`cap` is a request rather than a command**, and it has to be, because an
    # impl method has no visibility control — every method on this type is public
    # whether or not it wants to be, so this one is reachable with any int a
    # program cares to pass. Masking only works on a power of two: given 5 slots
    # the mask would be 4, every probe would visit slots 0 and 4 alone, and
    # `(i + 1) & 4` would never leave 0. So the request is rounded up to a power
    # of two, and raised to what the live entries need if it is below that.
    # Under the old prime-and-modulo scheme any capacity at all was merely
    # suboptimal; under a mask a wrong one is silently broken, which is what
    # makes the rounding part of the change rather than a nicety.
    #
    # Rounding is also what keeps the re-insert loop from recursing: the result
    # is at least `2 * live + 1`, so every one of the `live` inserts stays under
    # the 3/4 load and none of them triggers a rehash of its own.
    fun rehash(self, cap: int) {
        var want = cap;
        var need = self.live * 2 + 1;
        if want < need {
            want = need;
        }
        var old = self.slots;
        var fresh: [Slot<K, V>] = empty_slots(capacity_for(want));
        self.slots = fresh;
        self.live = 0;
        self.used = 0;
        var i = 0;
        while i < old.len() {
            match old[i] {
                Slot::Full(k, v) => {
                    self.insert(k, v);
                },
                _ => {},
            }
            i += 1;
        }
    }

    # Associate `value` with `key`, answering the value that was there before.
    #
    # Insertion prefers the *first tombstone* seen over the empty slot that ended
    # the probe, which is what keeps a table from lengthening its own probe
    # sequences: reusing a wall shortens the walk for every later lookup of this
    # key. It has to keep walking to the empty slot first, though — stopping at
    # the tombstone would risk inserting a duplicate of a key sitting further
    # along.
    fun insert(self, key: K, value: V) -> Option<V> {
        self.reserve_one();
        var i = self.start(key);
        var tomb = 0 - 1;
        # Bounded like the two searches below, rather than the `while true` this
        # used to be. The probe genuinely cannot run out of slots — `reserve_one`
        # has just guaranteed a free one — so the bound is never what ends the
        # loop, and it is here for what happens when the invariant it rests on is
        # broken. Masking makes that failure sharp: a capacity that is not a
        # power of two leaves `(i + 1) & mask` cycling over a handful of indices
        # forever, so an unbounded probe would hang the program rather than
        # report anything. A wrong answer is bad and a diagnosable error is
        # tolerable; a hang tells nobody anything.
        var steps = 0;
        while steps <= self.slots.len() {
            match self.slots[i] {
                Slot::Empty => {
                    if tomb < 0 {
                        self.slots[i] = Slot::Full(key, value);
                        self.used += 1;
                    } else {
                        # the tombstone was already counted in `used`
                        self.slots[tomb] = Slot::Full(key, value);
                    }
                    self.live += 1;
                    return Option::None;
                },
                Slot::Tomb => {
                    if tomb < 0 {
                        tomb = i;
                    }
                },
                Slot::Full(k, v) => {
                    if k == key {
                        self.slots[i] = Slot::Full(key, value);
                        return Option::Some(v);
                    }
                },
            }
            i = (i + 1) & self.mask();
            steps += 1;
        }
        return panic("std::collections: probe found no free slot — capacity is not a power of two");
    }

    # The value filed under `key`, or `None`.
    #
    # The walk stops at the first `Empty` and steps over every `Tomb`, which is
    # exactly the asymmetry that makes removal need tombstones at all.
    fun get(self, key: K) -> Option<V> {
        var i = self.start(key);
        var steps = 0;
        while steps < self.slots.len() {
            match self.slots[i] {
                Slot::Empty => {
                    return Option::None;
                },
                Slot::Tomb => {},
                Slot::Full(k, v) => {
                    if k == key {
                        return Option::Some(v);
                    }
                },
            }
            i = (i + 1) & self.mask();
            steps += 1;
        }
        return Option::None;
    }

    fun contains_key(self, key: K) -> bool {
        match self.get(key) {
            Option::Some(_) => {
                return true;
            },
            Option::None => {
                return false;
            },
        }
    }

    # Take `key` out, answering the value it held.
    #
    # The slot becomes a `Tomb` rather than `Empty`: some other key may have
    # walked past this position on its way in, and emptying the slot would hide
    # it from every future probe.
    fun remove(self, key: K) -> Option<V> {
        var i = self.start(key);
        var steps = 0;
        while steps < self.slots.len() {
            match self.slots[i] {
                Slot::Empty => {
                    return Option::None;
                },
                Slot::Tomb => {},
                Slot::Full(k, v) => {
                    if k == key {
                        self.slots[i] = Slot::Tomb;
                        self.live -= 1;
                        return Option::Some(v);
                    }
                },
            }
            i = (i + 1) & self.mask();
            steps += 1;
        }
        return Option::None;
    }

    # Drop every entry. The map is the same object afterwards, so anything else
    # holding it sees the emptying too — and the slot array is replaced rather
    # than walked, so the tombstones go with the entries.
    fun clear(self) {
        var fresh: [Slot<K, V>] = empty_slots(8);
        self.slots = fresh;
        self.live = 0;
        self.used = 0;
    }

    # Walk the entries as `(key, value)` pairs, so the `std::iter` combinators
    # apply: `m.iter().map(f)`, `m.iter().count()`.
    #
    # **The order is unspecified** — it is slot order, which is hash order, and
    # it changes when the table rehashes. A program that needs an order has to
    # impose one (`std::sort` over `collect()`), and a test that prints a map has
    # to do the same or it is testing the hash function.
    #
    # The iterator holds the *current* slot array, not the map, so an insert that
    # rehashes during a walk leaves the walk on the old array rather than
    # corrupting it. That is the same choice `CharIter` makes and the opposite of
    # `ArrayIter`'s, and it is forced here rather than chosen: a rehash moves
    # every entry, so an index into the old table means nothing in the new one.
    fun iter(self) -> MapIter<K, V> {
        return MapIter { slots: self.slots, at: 0 };
    }

    # The keys, in the same unspecified order.
    #
    # The walk is over slots and cannot be shortened, but the answer's length is
    # known before it starts — so `reserve` trades the log(live) regrowths, each
    # copying everything written so far, for one allocation.
    fun keys(self) -> [K] {
        var out: [K] = array::with_capacity(self.live);
        var it = self.iter();
        for pair in it {
            out.push(pair.0);
        }
        return out;
    }

    fun values(self) -> [V] {
        var out: [V] = array::with_capacity(self.live);
        var it = self.iter();
        for pair in it {
            out.push(pair.1);
        }
        return out;
    }
}

pub struct MapIter<K: Hash, V> {
    slots: [Slot<K, V>],
    at: int,
}

impl<K: Hash, V> Iterator for MapIter<K, V> {
    type Item = (K, V);

    fun next(self) -> Option<(K, V)> {
        while self.at < self.slots.len() {
            var slot = self.slots[self.at];
            self.at += 1;
            match slot {
                Slot::Full(k, v) => {
                    return Option::Some((k, v));
                },
                _ => {},
            }
        }
        return Option::None;
    }
}
