# std::fmt — turning a value into text.
#
# `Display` is the one name the compiler knows out of the whole standard
# library. Every other std module is anonymous to it — `Option` is an ordinary
# enum, `Ord` an ordinary trait — but interpolation has to decide *which*
# `to_string` a `"{v}"` segment means, and that cannot be left to whatever
# happens to be in scope. So `"{v}"` on anything but a primitive is checked
# against this trait and rewritten into the call `v.to_string()`.
#
# The primitives are not routed through it: the VM has always rendered an int,
# float, bool and string itself, which is what lets a program interpolate one
# without importing anything. The impls below exist for the *other* direction —
# so a `T: Display` generic can be instantiated at a primitive — and each is
# written by interpolating `self`, which is that same built-in path. That makes
# them the one place in std where a trait impl is genuinely free.
#
# `print` is deliberately *not* held to `Display`: it renders any value
# structurally, through the runtime's own walk. "Show me what this is" is a
# debugging view the runtime can always answer; "render this for a reader" is
# the type's own decision, and only the second needs a trait.

@lang("display")
pub trait Display {
  fun to_string(self) -> string;
}

impl Display for int {
  fun to_string(self) -> string {
    return "{self}";
  }
}

impl Display for float {
  fun to_string(self) -> string {
    return "{self}";
  }
}

impl Display for bool {
  fun to_string(self) -> string {
    return "{self}";
  }
}

impl Display for char {
  fun to_string(self) -> string {
    return "{self}";
  }
}

impl Display for string {
  fun to_string(self) -> string {
    return self;
  }
}

# ── the containers ────────────────────────────────────────────────────────────
#
# An array and a tuple are the two types with no module of their own, so their
# impls live here; every other container implements `Display` beside its own
# definition (`std::option`, `std::result`), the same way it already implements
# `Ord` there. Nothing structural allowed these before milestone 19: an impl was
# program-global, so shipping one would have silently claimed the rendering of
# `[T]` for every program whether it imported `std::fmt` or not.
#
# The element goes through `Display` in turn, which is the whole point — a
# `[Point]` renders with `Point`'s own `to_string`, not with the runtime's
# structural walk. It also means a `string` element renders bare: `Display`
# answers "render this for a reader", and quoting is a debugging affordance.
# `print` still shows the structural view, and the two only agree by
# coincidence of taste on the separators below.
#
# The bound is on the *impl's* type param, and since milestone 20 that is
# checked where the impl is selected — so `"{v}"` on a `[Widget]` whose element
# has no `Display` is an error at the interpolation, naming `Widget`.

impl<T: Display> Display for [T] {
  fun to_string(self) -> string {
    var out = "[";
    var first = true;
    for item in self {
      if not first {
        out = out + ", ";
      }
      out = out + item.to_string();
      first = false;
    }
    return out + "]";
  }
}

# Arity is per-impl: a tuple's length is part of its type and the language has
# no way to be generic over it, so a 3-tuple would need its own impl below.
impl<A: Display, B: Display> Display for (A, B) {
  fun to_string(self) -> string {
    return "(" + self.0.to_string() + ", " + self.1.to_string() + ")";
  }
}

# The trait as a function, for the places a method call cannot go: a value
# passed to something expecting a `string`, or a pipe stage.
pub fun to_string<T: Display>(value: T) -> string {
  return value.to_string();
}

# `value` to a fixed number of decimal places, which interpolation cannot ask
# for: `"{f}"` renders the shortest decimal that reads back as the same float,
# and that is the *only* rendering the VM has. A negative precision is a
# runtime error.
@native("fmt_float")
@lang("float")
pub fun float(value: float, precision: int) -> string;
