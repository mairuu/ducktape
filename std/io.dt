# std::io — what a program can print, read and write.
#
# The first module whose bodies are *not* written in ducktape. `print` cannot
# be: it has to reach `value_print`, and no expression in the language does
# that. So the declaration is bodyless and an attribute names the C function
# to call — the signature stays ducktape, and the checker treats this like any
# other generic function.
#
# `print<T>` is generic and yet is never monomorphised: the runtime is uniform
# in type arguments, so one C body serves every `T`. That is the same
# observation monomorphisation itself rests on, read from the other side.

use std::bytes;
use std::result::Result;

@native("io_print")
pub fun print<T>(value: T);

# Append a file's contents to `out`, answering the failure — empty when there
# was none. Private, and the shape is forced: a native cannot mint a `Result`
# (it has no handle on the `VariantDef` a variant instance needs), so the two
# answers have to leave by different doors. The bytes go out through the
# parameter, which is the one out-parameter a *mutable* object makes possible,
# and the message comes back as the return.
#
# A successful read has no message, so the empty string is a sentinel nothing
# else can produce. On failure `out` is left exactly as it was found.
@native("io_read_file")
fun read_file_into(path: string, out: Bytes) -> string;

# A file's bytes, or why they could not be had.
#
# The answer is `Bytes` rather than `string` because a file is arbitrary octets
# and a `string` is guaranteed valid UTF-8 (milestone 101) — so a read that
# promised text would have to fail on a file that is merely not text. Decoding
# is a separate, visible step: `string::from_utf8(b)`.
pub fun read_file(path: string) -> Result<Bytes, string> {
    var out = Bytes::new();
    var err = read_file_into(path, out);
    if err.len() == 0 {
        return Result::Ok(out);
    }
    return Result::Err(err);
}

# The empty message, turned back into the `Ok` no native could mint. Every call
# below leaves by this door.
fun answer(err: string) -> Result<(), string> {
    if err.len() == 0 {
        return Result::Ok(());
    }
    return Result::Err(err);
}

@native("io_write_file")
fun write_file_raw(path: string, data: Bytes, append: bool) -> string;

# Write `data` to `path`, replacing whatever was there — creating the file if it
# was not there at all.
#
# The promise is weaker than `read_file`'s, and deliberately: a failed read
# leaves the caller's buffer as it found it, while a failed write leaves the
# *file* however far it got. Nothing can un-write bytes the disk accepted, so an
# `Err` here says the write did not finish and nothing about what is on disk.
# A program that needs all-or-nothing writes a temporary and renames it, which
# is a policy this is the primitive for.
pub fun write_file(path: string, data: Bytes) -> Result<(), string> {
    return answer(write_file_raw(path, data, false));
}

# The same write, starting at the end of what is already there.
pub fun append_file(path: string, data: Bytes) -> Result<(), string> {
    return answer(write_file_raw(path, data, true));
}

@native("io_read_lines")
fun read_lines_raw(path: string, f: fun(string) -> bool) -> string;

# Read `path` one line at a time, handing each to `f` — which answers whether to
# keep going, so a program looking for one line stops at it.
#
# **The line arrives, rather than being asked for**, and that is the answer to
# the question this module was left holding: who closes a file. A pull shape —
# `for line in io::lines(path)` — needs a value holding the open file, and a
# `break` abandons it. ducktape has no destructors and a panic does not unwind
# (a `defer` does not run on that path), so nothing could be made to close it:
# a handle would be a promise the language cannot check. Pushing keeps the
# open/close pair inside one native, where the close happens on every path.
#
# A line is a `string`, so a file that is not valid UTF-8 fails at the line that
# is not — the `Bytes`/`string` boundary (milestone 101) reaching the read side.
# The line separator is `\n` and is not part of the line; a `\r` before it goes
# too, so a CRLF file reads the same as an LF one. A file not ending in a
# newline still ends in a line.
pub fun read_lines(path: string, f: fun(string) -> bool) -> Result<(), string> {
    return answer(read_lines_raw(path, f));
}
