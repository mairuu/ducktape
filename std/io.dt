# std::io — output, and the first thing a program can read.
#
# The first module whose bodies are *not* written in ducktape. `print` cannot
# be: it has to reach `value_print`, and no expression in the language does
# that. So the declaration is bodyless and an attribute names the C function
# to call — the signature stays ducktape, and the checker treats this like any
# other generic function.
#
# `print<T>` is generic and yet is never monomorphised: the runtime is uniform
# in type arguments, so one C body serves every `T`. That is the same
# observation monomorphisation itself rests on, read from the other side.

use std::bytes;
use std::iter::Iterator;
use std::option::Option;
use std::result::Result;

@native("io_print")
pub fun print<T>(value: T);

# Append a file's contents to `out`, answering the failure — empty when there
# was none. Private, and the shape is forced: a native cannot mint a `Result`
# (it has no handle on the `VariantDef` a variant instance needs), so the two
# answers have to leave by different doors. The bytes go out through the
# parameter, which is the one out-parameter a *mutable* object makes possible,
# and the message comes back as the return.
#
# A successful read has no message, so the empty string is a sentinel nothing
# else can produce. On failure `out` is left exactly as it was found.
@native("io_read_file")
fun read_file_into(path: string, out: Bytes) -> string;

# A file's bytes, or why they could not be had.
#
# The answer is `Bytes` rather than `string` because a file is arbitrary octets
# and a `string` is guaranteed valid UTF-8 (milestone 101) — so a read that
# promised text would have to fail on a file that is merely not text. Decoding
# is a separate, visible step: `string::from_utf8(b)`.
pub fun read_file(path: string) -> Result<Bytes, string> {
    var out = Bytes::new();
    var err = read_file_into(path, out);
    if err.len() == 0 {
        return Result::Ok(out);
    }
    return Result::Err(err);
}

# ── A file held open ────────────────────────────────────────────────────────
#
# `read_file` reads a whole file because it is the shape that needs no handle,
# and the reason to want one is everything that shape cannot do: stopping early,
# and reading a file too big to hold. Both need the file to stay open across
# more than one call, which means something has to close it — and this language
# has no destructor, so that something is the program.
#
# `defer` is what makes that a fair ask. It covers every way out of the block
# the handle was bound in, `break` and `?` included, so the close sits one line
# under the open and is not repeated at each exit:
#
#     var h = File::open(path)?;
#     defer h.close();
#     for line in h {
#         if line == "stop" { break; }   # the defer closes on the way out
#     }
#
# What it does not cover is an abort, which runs no defers — a panic mid-loop
# leaks the descriptor into a process that is exiting anyway. That is the whole
# of the cost, and it is why `read_file` stays: a program that wants the file
# and not the bookkeeping should not open one.
#
# A dropped handle is the other half of the same fact. Forgetting to close is
# not an error and not caught; the file stays open until the process ends.

# The C half. A `File` is an int naming an entry in the runtime's table, so
# these take the name rather than the handle — a native has no way to read a
# struct's field. `open_raw` answers 0 for "no file", since no entry is ever
# named 0, and the reason is left where `error_raw` finds it.
@native("file_open")
fun open_raw(path: string) -> int;

@native("file_close")
fun close_raw(id: int) -> bool;

@native("file_is_open")
fun is_open_raw(id: int) -> bool;

# 1 = a line was appended to `out`, 0 = end of file, -1 = the read failed.
@native("file_read_line")
fun read_line_raw(id: int, out: Bytes) -> int;

@native("file_error")
fun error_raw() -> string;

# An open file, read a line at a time.
#
# The fields are private, so the only `File` a program can have is one `open`
# handed it — but the runtime does not rely on that. A forged or stale id names
# no entry, and every operation here answers that case rather than trusting it.
pub struct File {
    id: int,
    # The line under construction, reused across `next` so a file costs one
    # buffer rather than one per line.
    buf: Bytes,
    # Why the iteration stopped, when it was not the end of the file. `next`
    # answers `None` for both, so this is the difference, and it is read after
    # the loop rather than during it.
    fault: string,
}

impl File {
    # Open `path` for reading.
    fun open(path: string) -> Result<File, string> {
        var id = open_raw(path);
        if id == 0 {
            return Result::Err(error_raw());
        }
        return Result::Ok(File { id: id, buf: Bytes::new(), fault: "" });
    }

    # Release the file. Closing twice is harmless — an explicit close followed
    # by a deferred one is the ordinary shape, and neither call is the wrong
    # one — so this is safe to `defer` unconditionally.
    fun close(self) {
        if not close_raw(self.id) {
            self.fault = error_raw();
        }
    }

    fun is_open(self) -> bool {
        return is_open_raw(self.id);
    }

    # Empty unless a read failed. `close` reports through here too, so one check
    # after the block covers the whole handle.
    fun error(self) -> string {
        return self.fault;
    }
}

# Lines, pulled. The newline is not part of the line, and a final line without
# one is still a line.
#
# A read error and the end of the file are both `None`: `Option` has no arm for
# a failure and `Iterator` was not going to grow one for this. So a loop that
# must know checks `error()` after it, which is the same order the fault is
# written in.
impl Iterator for File {
    type Item = string;

    fun next(self) -> Option<string> {
        self.buf.clear();
        var got = read_line_raw(self.id, self.buf);
        if got < 0 {
            self.fault = error_raw();
            return Option::None;
        }
        if got == 0 {
            return Option::None;
        }
        match string::from_utf8(self.buf) {
            Option::Some(line) => Option::Some(line),
            Option::None => {
                self.fault = "line is not valid UTF-8";
                Option::None
            },
        }
    }
}
