# std::iter — a value that yields a sequence, one element at a time.
#
# `Iterator` is the trait a `for` loop speaks. `for x in it` drives `it.next()`
# until it yields `None`, binding each `Some`'s payload to `x`. The advancing
# cursor is the iterator's own state — a mutable field (milestone 43) that a
# `pub` type can keep private (milestone 44), which is what lets an iterator hide
# where it is.
#
# The trait is a lang item: `for x in it` never writes the name `Iterator`,
# `next`, or `Option`, so the language rather than an import has to decide what
# they mean. Like `Display` and `Ord` it is preluded, so `impl Iterator for T`
# needs no `use`.
#
# A std module gets no prelude of its own, so `Option` is imported here by hand.
# `collect` builds an array, so `std::array` is imported for its `push` method.
# `std::ops` is what makes `sum`/`product` expressible: a reduce needs to know
# the element can be *combined*, which before milestone 55 no bound could say.
# `std::string` and `std::char` are the sources' business rather than the
# combinators': `CharIter` needs `len` on one and `code` on the other. Both
# arrive transitively through `std::cmp` already — they are written out because
# an impl this file *calls* should not be reachable only by accident.
use std::option::Option;
use std::array;
use std::cmp::Ord;
use std::ops::{Add, Mul};
use std::string;
use std::char;

@lang("iterator")
pub trait Iterator {
    type Item;

    # The next element, or `None` once the sequence is spent. Advancing the
    # cursor is a side effect: calling `next` again yields the element after.
    fun next(self) -> Option<Self.Item>;

    # ── Combinators, as provided methods ────────────────────────────────────
    #
    # `map`/`filter`/`collect` are the pipeline written left to right:
    # `it.map(f).filter(p).collect()`. Each has a default body, so *every*
    # iterator gets them for free — an impl fills in `next` and inherits the
    # rest. They compose by wrapping `self` in an adapter (below), so the source
    # iterator's cursor lives inside the returned one and advances in place.
    #
    # None of these can sit in a `dyn Iterator` vtable: `map` has a type
    # parameter of its own and `filter` returns a `Self`-shaped adapter, so
    # object safety excludes them from dispatch (they type-check on a concrete
    # or bounded receiver, but not through a trait object — the compiler says so
    # at the call). `collect` returns `[Self.Item]`, a projection the trait
    # object still names, so it *stays* dispatchable and a `dyn Iterator` keeps
    # it. That partition is what lets the combinators be methods without taking
    # `dyn Iterator` away — milestone 48.

    # Adapt so each element is passed through `f`. Lazy: the work happens one
    # `next()` at a time, so the chain allocates no intermediate sequence.
    fun map<B>(self, f: fun(Self.Item) -> B) -> Map<Self, B> {
        return Map { inner: self, f: f };
    }

    # Adapt to skip elements failing `pred`. Lazy in the same way.
    fun filter(self, pred: fun(Self.Item) -> Bool) -> Filter<Self> {
        return Filter { inner: self, pred: pred };
    }

    # Map each element to a whole *iterator* and yield those flattened end to
    # end. `map` with a closure returning an iterator would give a sequence of
    # sequences; this drains each one before pulling the next element.
    #
    # This is the combinator that waited on machinery rather than on appetite:
    # its adapter's element type is `J.Item`, a projection over a *bound
    # parameter*, and until milestone 50 a projection could not survive to
    # codegen to key an instantiation.
    fun flat_map<J: Iterator>(self, f: fun(Self.Item) -> J) -> FlatMap<Self, J> {
        return FlatMap { inner: self, f: f, cur: Option::None };
    }

    # Drain into an array, in order — the eager end of a pipeline. The element
    # annotation seeds the array's type from `Self.Item` (an empty literal has
    # nothing else to infer it from) and `push` grows it. A `while` over
    # `self.next()` rather than `for x in self`: a bound method call needs no
    # lang item, so the drain works even when this file is run by path (where
    # the `iterator` gate that `for` consults is inert).
    fun collect(self) -> [Self.Item] {
        var out: [Self.Item] = [];
        loop {
            match self.next() {
                Option::Some(x) => { out.push(x); },
                Option::None => { return out; },
            }
        }
    }

    # Yield at most the first `n` elements, then stop — a lazy adapter holding a
    # countdown of its own.
    fun take(self, n: Int) -> Take<Self> {
        return Take { inner: self, remaining: n };
    }

    # Yield this sequence, then `other`'s. The two must agree on their element
    # type, and saying so is what needed a language feature rather than a
    # library one: `Chain`'s `Item` is *this* iterator's, so `other.next()`
    # would be yielding some unrelated `J.Item` unless a bound could state that
    # the two are the same type. `Iterator<Item = Self.Item>` is that statement
    # — an equality binding (milestone 54), the predicate kind that says which
    # type a projection *is* rather than which traits it satisfies.
    fun chain<J: Iterator<Item = Self.Item>>(self, other: J) -> Chain<Self, J> {
        return Chain { first: self, second: other, first_done: false };
    }

    # Drop the first `n` elements and yield the rest. The mirror of `take`, and
    # lazy in the same way: nothing is pulled until the first `next()`, which is
    # then the call that does the dropping.
    fun skip(self, n: Int) -> Skip<Self> {
        return Skip { inner: self, remaining: n };
    }

    # Yield elements while `pred` holds, then stop for good. Where `filter`
    # asks the question of every element, this one asks until the first `false`
    # and then never again — so the adapter carries a `done` flag rather than
    # re-testing a source it has already given up on. The element that failed is
    # pulled and dropped: there is no way to put one back.
    fun take_while(self, pred: fun(Self.Item) -> Bool) -> TakeWhile<Self> {
        return TakeWhile { inner: self, pred: pred, done: false };
    }

    # Drop elements while `pred` holds, then yield everything after — the mirror
    # of `take_while`, and the mirror of `skip` in the way `take_while` mirrors
    # `take`. The subtlety is at the seam: the first element that *fails* the
    # predicate is the first one yielded, not the one dropped to notice the
    # skipping is over.
    fun skip_while(self, pred: fun(Self.Item) -> Bool) -> SkipWhile<Self> {
        return SkipWhile { inner: self, pred: pred, skipping: true };
    }

    # Pair each element with its position: `(0, a), (1, b), ...`. The element
    # type is a tuple, so the adapter's `Item` is `(Int, Self.Item)`.
    fun enumerate(self) -> Enumerate<Self> {
        return Enumerate { inner: self, i: 0 };
    }

    # Walk two iterators in lockstep, yielding pairs until *either* runs out. The
    # second iterator's type is a parameter of the method itself, so like `map`
    # this one is excluded from a `dyn Iterator` vtable.
    fun zip<J: Iterator>(self, other: J) -> Zip<Self, J> {
        return Zip { a: self, b: other };
    }

    # Reduce to a single value, left to right: `f` folds each element into the
    # accumulator, seeded by `init`. The eager sibling of `map` — a consumer, not
    # an adapter, so there is no struct, just a drain. `B` is the accumulator's
    # type, a parameter of the method.
    fun fold<B>(self, init: B, f: fun(B, Self.Item) -> B) -> B {
        var acc = init;
        loop {
            match self.next() {
                Option::Some(x) => { acc = f(acc, x); },
                Option::None => { return acc; },
            }
        }
    }

    # ── Short-circuiting consumers ──────────────────────────────────────────
    #
    # Each drains the source, but only as far as it has to: `any` stops at the
    # first element that passes, `all` at the first that fails, `find` and
    # `position` at the first match. That is not an optimisation but part of
    # what they mean — the source's cursor is left *where the answer was found*,
    # so a caller may keep driving it, and a source that would not terminate is
    # still usable if the answer comes early enough.
    #
    # All six sit in a `dyn Iterator` vtable, and the reason is worth stating
    # because it draws the partition object safety has been making since
    # milestone 48 along a line the library already had: **an adapter returns a
    # `Self`-shaped type and a consumer does not**. `take_while` returns
    # `TakeWhile<Self>`, so `Self` escapes the receiver and there is nothing to
    # dispatch; `any` returns a `Bool` and `find` an `Option<Self.Item>`, a
    # projection the trait object pins. What excludes a *consumer* is a type
    # parameter of its own (`fold`) or a bound on the element (`max`), and none
    # of these has either.

    # Is `pred` true of any element? `false` for an empty sequence.
    fun any(self, pred: fun(Self.Item) -> Bool) -> Bool {
        loop {
            match self.next() {
                Option::Some(x) => { if pred(x) { return true; } },
                Option::None => { return false; },
            }
        }
    }

    # Is `pred` true of every element? `true` for an empty sequence — there is
    # no element it fails on, which is the only answer that keeps `all` and
    # `any` mirrors of each other.
    fun all(self, pred: fun(Self.Item) -> Bool) -> Bool {
        loop {
            match self.next() {
                Option::Some(x) => { if not pred(x) { return false; } },
                Option::None => { return true; },
            }
        }
    }

    # The first element `pred` accepts, or `None`. The element itself — its
    # *index* is `position`, and the two are separate rather than one returning
    # a pair because a caller almost always wants one and would have to unpack
    # the other.
    fun find(self, pred: fun(Self.Item) -> Bool) -> Option<Self.Item> {
        loop {
            match self.next() {
                Option::Some(x) => { if pred(x) { return Option::Some(x); } },
                Option::None => { return Option::None; },
            }
        }
    }

    # The index of the first element `pred` accepts, counted from where the
    # cursor is *now* rather than from the sequence's start — the iterator does
    # not know how far it has already come, and nothing can ask it.
    fun position(self, pred: fun(Self.Item) -> Bool) -> Option<Int> {
        var i = 0;
        loop {
            match self.next() {
                Option::Some(x) => {
                    if pred(x) { return Option::Some(i); }
                    i += 1;
                },
                Option::None => { return Option::None; },
            }
        }
    }

    # How many elements are left. The one consumer here that cannot short-
    # circuit: the answer is only known once the sequence has ended, so this
    # drains it and an endless source never comes back.
    fun count(self) -> Int {
        var n = 0;
        loop {
            match self.next() {
                Option::Some(x) => { n += 1; },
                Option::None => { return n; },
            }
        }
    }

    # Run `f` on every element, for its effect. The same walk `for x in it`
    # does, spelled as a method so it can end a pipeline
    # (`it.filter(p).for_each(f)`) without the chain having to be broken open
    # into a loop.
    #
    # The closure returns `Unit`, and there is no discard coercion: a shorthand
    # closure *is* its expression, so `|x| f(x)` only fits when `f` returns
    # nothing. `|x| { f(x); }` is the way round it, and the trailing `;` doing
    # the dropping is the ordinary block rule rather than anything this method
    # asked for.
    fun for_each(self, f: fun(Self.Item) -> Unit) {
        loop {
            match self.next() {
                Option::Some(x) => { f(x); },
                Option::None => { return; },
            }
        }
    }

    # The largest element, or `None` for an empty sequence. `min` is the mirror.
    #
    # These are the first combinators that need to *use* an element rather than
    # only pass it along, and what says they may is `where Self.Item: Ord` — a
    # bound on the signature's associated type, which a trait method's `where`
    # clause could not carry until milestone 53. Without it a reduce has to take
    # its operation as a closure, which is why `fold` does.
    #
    # The bound is discharged at each call against whatever receiver it has:
    # `Counter.Item` is `Int`, so the question is about a real type; a bounded
    # `I: Iterator` answers with its own `where I.Item: Ord`, and so has to
    # declare one. Neither can sit in a `dyn Iterator` vtable — whether the
    # bound holds is a question about the concrete type, which is what the
    # coercion erased — so both are excluded from dispatch like `map` is, and
    # `dyn Iterator` keeps `collect`.
    fun max(self) -> Option<Self.Item> where Self.Item: Ord {
        var best = self.next();
        loop {
            match self.next() {
                Option::Some(v) => {
                    match best {
                        Option::Some(b) => { if v > b { best = Option::Some(v); } },
                        Option::None => { best = Option::Some(v); },
                    }
                },
                Option::None => { return best; },
            }
        }
    }

    # The smallest element, or `None` for an empty sequence.
    fun min(self) -> Option<Self.Item> where Self.Item: Ord {
        var best = self.next();
        loop {
            match self.next() {
                Option::Some(v) => {
                    match best {
                        Option::Some(b) => { if v < b { best = Option::Some(v); } },
                        Option::None => { best = Option::Some(v); },
                    }
                },
                Option::None => { return best; },
            }
        }
    }

    # The sum of every element, or `None` for an empty sequence. `product` is
    # the mirror, over `Mul`.
    #
    # The same shape as `max`, one trait over — and the reason it returns an
    # `Option` rather than starting from zero is the same reason `max` does:
    # there is no way to write "the identity element of `T`". That would need a
    # second method on the trait (Rust's `Sum`, or a `Default`), and the value
    # it would produce for an empty sequence is exactly the value the caller has
    # an opinion about. `it.sum().unwrap_or(0)` says which one it wants.
    #
    # `where Self.Item: Add` is what milestone 55 makes writable. Before it, `+`
    # on an element had nothing to bound: the operators were built-in numeric
    # opcodes, so a sequence of anything else could only be reduced through
    # `fold` with a closure spelling the operation out.
    #
    # `Output = Self.Item` is milestone 76's half, and it is what a reduce is:
    # an accumulator only accumulates if adding to it gives back its own type.
    # Without the binding `t + v` is a `Self.Item.Output`, which is opaque and
    # cannot go back into `total`. It is a binding whose subject is a
    # *projection*, which is the language piece that milestone bought.
    fun sum(self) -> Option<Self.Item> where Self.Item: Add<Output = Self.Item> {
        var total = self.next();
        loop {
            match self.next() {
                Option::Some(v) => {
                    match total {
                        Option::Some(t) => { total = Option::Some(t + v); },
                        Option::None => { total = Option::Some(v); },
                    }
                },
                Option::None => { return total; },
            }
        }
    }

    # The product of every element, or `None` for an empty sequence.
    fun product(self) -> Option<Self.Item>
        where Self.Item: Mul<Output = Self.Item> {
        var total = self.next();
        loop {
            match self.next() {
                Option::Some(v) => {
                    match total {
                        Option::Some(t) => { total = Option::Some(t * v); },
                        Option::None => { total = Option::Some(v); },
                    }
                },
                Option::None => { return total; },
            }
        }
    }
}

# ── Driving a sequence from both ends ────────────────────────────────────────

# A sequence that can also be walked backwards. `next_back` yields from the far
# end and advances *that* end inward, so the two cursors meet in the middle and
# a source can be driven from either side, or both.
#
# It is a **supertrait** of `Iterator` (milestone 58), and that is the whole
# reason the trait can exist at all: `next_back` returns `Option<Self.Item>`, and
# `Item` is `Iterator`'s associated type. Written as an independent trait it
# would have to declare an `Item` of its own, and nothing would make the two
# agree — a type could bind them to different types and both impls would check.
# `: Iterator` says the promise `Iterator` makes is already made, so `Self.Item`
# here *is* that one.
#
# The other half of what a supertrait buys shows up at `Rev` below: `impl<I:
# DoubleEnded> Iterator for Rev<I>` calls `self.inner.next()` — a method `I` was
# never directly bounded to have. It has it because `DoubleEnded` promised it.
#
# Not a lang item, and not preluded: nothing the compiler desugars names it, so
# it is imported like any ordinary trait.
pub trait DoubleEnded: Iterator {
    # The last element not yet yielded, or `None` once the two ends have met.
    fun next_back(self) -> Option<Self.Item>;

    # Yield the same elements in the opposite order. Lazy like every other
    # adapter — `rev` swaps which end each `next()` reads, it does not collect.
    #
    # Excluded from a `dyn DoubleEnded` vtable, for `filter`'s reason: it
    # returns a `Rev<Self>`, so `Self` appears outside the receiver. A trait
    # object may still be *reversed* by a `<I: DoubleEnded>` function, since the
    # body is monomorphised at `Self = dyn DoubleEnded` like any other instance.
    fun rev(self) -> Rev<Self> {
        return Rev { inner: self };
    }
}

# `Rev` reads the source from the far end: its `next` is the source's
# `next_back` and its `next_back` is the source's `next`, which is the whole
# implementation. Reversing a `Rev` gives back the original order, at the cost
# of one wrapper.
pub struct Rev<I: DoubleEnded> {
    inner: I,
}

impl<I: DoubleEnded> Iterator for Rev<I> {
    type Item = I.Item;

    fun next(self) -> Option<I.Item> {
        return self.inner.next_back();
    }
}

impl<I: DoubleEnded> DoubleEnded for Rev<I> {
    fun next_back(self) -> Option<I.Item> {
        return self.inner.next();
    }
}

# ── Adapters ─────────────────────────────────────────────────────────────────
#
# An adapter is an ordinary struct with an `impl Iterator`. The source iterator
# is a field (`inner`), so its cursor is *inside* the adapter and advances in
# place as the adapter's own `next()` calls it. The transform is a closure held
# in a `fun(..)` field — nothing here is built into the language; a program can
# write the same shape. The combinator methods above name these by returning
# them, and each adapter's bound names `Iterator` back: the two-pass name
# resolver (declaration order no longer matters) is what closes that cycle.

# `Map` yields `f(x)` for each `x` the source yields. `B` is the mapped element
# type — the closure's return — carried as a second parameter because nothing
# can project "the return type of `F`".
pub struct Map<I: Iterator, B> {
    inner: I,
    f: fun(I.Item) -> B,
}

impl<I: Iterator, B> Iterator for Map<I, B> {
    type Item = B;

    fun next(self) -> Option<B> {
        match self.inner.next() {
            Option::Some(x) => { return Option::Some((self.f)(x)); },
            Option::None => { return Option::None; },
        }
    }
}

# Mapping does not care which end an element came from, so `Map` is reversible
# exactly when its source is — a *second* impl, on a stricter bound than the
# `Iterator` one above. Two impls of two traits for one type is not a coherence
# problem; what it costs is that the stricter one is selected only where the
# bound holds, which is precisely the condition being stated.
#
# Adapters that are deliberately *not* double-ended, each for a reason of its
# own: `Take` and `Skip` would have to know how far the far end is from a length
# nobody holds; `Enumerate`'s index counts from the front, so a back element
# cannot be numbered without one either; `Zip` pairs by position, so the back of
# the pair sequence is undefined unless both sources agree on a length; and
# `Chain` driven from both ends needs its two halves to agree on where they met,
# which two independent `done` flags cannot say.
impl<I: DoubleEnded, B> DoubleEnded for Map<I, B> {
    fun next_back(self) -> Option<B> {
        match self.inner.next_back() {
            Option::Some(x) => { return Option::Some((self.f)(x)); },
            Option::None => { return Option::None; },
        }
    }
}

# `Filter` yields only the elements for which `pred` is true. Its `next` drives
# the source until one passes, so a single `next()` may pull several — the loop
# is where laziness earns its keep.
pub struct Filter<I: Iterator> {
    inner: I,
    pred: fun(I.Item) -> Bool,
}

impl<I: Iterator> Iterator for Filter<I> {
    type Item = I.Item;

    fun next(self) -> Option<I.Item> {
        loop {
            match self.inner.next() {
                Option::Some(x) => {
                    if (self.pred)(x) { return Option::Some(x); }
                },
                Option::None => { return Option::None; },
            }
        }
    }
}

# Filtering is end-agnostic in the same way mapping is: the predicate asks about
# an element, not about where it sat.
impl<I: DoubleEnded> DoubleEnded for Filter<I> {
    fun next_back(self) -> Option<I.Item> {
        loop {
            match self.inner.next_back() {
                Option::Some(x) => {
                    if (self.pred)(x) { return Option::Some(x); }
                },
                Option::None => { return Option::None; },
            }
        }
    }
}

# `Take` yields the source's elements until its own countdown reaches zero, then
# reports the sequence spent — even if the source has more.
pub struct Take<I: Iterator> {
    inner: I,
    remaining: Int,
}

impl<I: Iterator> Iterator for Take<I> {
    type Item = I.Item;

    fun next(self) -> Option<I.Item> {
        if self.remaining <= 0 { return Option::None; }
        self.remaining -= 1;
        return self.inner.next();
    }
}

# `Chain` drains `first`, then `second`. `first_done` is what makes that one
# way: without it a `None` from an exhausted first source would be re-asked for
# on every later `next()`, which for a stateful iterator is not the same
# question twice.
#
# The bound on `J` is the milestone-54 one: `Item = I.Item` says the second
# source's element type *is* the first's, which is what lets `self.second.next()`
# be returned where `Option<I.Item>` is wanted. It is also checked where the
# impl is selected, so a `Chain<Counter, Words>` finds no `Iterator` impl rather
# than quietly compiling a `String` as an `Int`.
pub struct Chain<I: Iterator, J: Iterator> {
    first: I,
    second: J,
    first_done: Bool,
}

impl<I: Iterator, J: Iterator<Item = I.Item>> Iterator for Chain<I, J> {
    type Item = I.Item;

    fun next(self) -> Option<I.Item> {
        if not self.first_done {
            match self.first.next() {
                Option::Some(x) => { return Option::Some(x); },
                Option::None => { self.first_done = true; },
            }
        }
        return self.second.next();
    }
}

# `Skip` discards the first `remaining` elements, then becomes a pass-through.
# The dropping happens on the first `next()` rather than when the adapter is
# built, so `skip` costs nothing until the sequence is actually driven — and a
# source shorter than `n` simply ends.
pub struct Skip<I: Iterator> {
    inner: I,
    remaining: Int,
}

impl<I: Iterator> Iterator for Skip<I> {
    type Item = I.Item;

    fun next(self) -> Option<I.Item> {
        while self.remaining > 0 {
            self.remaining -= 1;
            match self.inner.next() {
                Option::Some(x) => { },
                # the source ran out mid-skip: nothing is left to yield, and
                # zeroing the countdown keeps a later `next()` from re-driving it
                Option::None => {
                    self.remaining = 0;
                    return Option::None;
                },
            }
        }
        return self.inner.next();
    }
}

# `TakeWhile` yields while the predicate holds and is spent the moment it does
# not. `done` is what makes that permanent: without it, a source whose elements
# go true, false, true would resume after the gap, which is `filter`'s meaning
# rather than this one's. The failing element is gone — pulling it is how the
# adapter found out, and there is nowhere to put it back.
pub struct TakeWhile<I: Iterator> {
    inner: I,
    pred: fun(I.Item) -> Bool,
    done: Bool,
}

impl<I: Iterator> Iterator for TakeWhile<I> {
    type Item = I.Item;

    fun next(self) -> Option<I.Item> {
        if self.done { return Option::None; }
        match self.inner.next() {
            Option::Some(x) => {
                if (self.pred)(x) { return Option::Some(x); }
                self.done = true;
                return Option::None;
            },
            Option::None => {
                self.done = true;
                return Option::None;
            },
        }
    }
}

# `SkipWhile` drops elements while the predicate holds, then passes everything
# through. The seam is the interesting part: the element that *ends* the
# skipping is the first one yielded, so the loop returns it rather than
# discarding it and asking again — an off-by-one that would silently eat one
# element of every sequence this is used on. `skipping` then stays false for
# good, so a later element the predicate would have accepted is still yielded.
pub struct SkipWhile<I: Iterator> {
    inner: I,
    pred: fun(I.Item) -> Bool,
    skipping: Bool,
}

impl<I: Iterator> Iterator for SkipWhile<I> {
    type Item = I.Item;

    fun next(self) -> Option<I.Item> {
        while self.skipping {
            match self.inner.next() {
                Option::Some(x) => {
                    if not (self.pred)(x) {
                        self.skipping = false;
                        return Option::Some(x);
                    }
                },
                Option::None => {
                    self.skipping = false;
                    return Option::None;
                },
            }
        }
        return self.inner.next();
    }
}

# `FlatMap` holds two cursors: the source's, and the one belonging to whichever
# iterator the closure most recently produced. `cur` is that inner iterator, or
# `None` between them — so `next` is a loop over "drain the current one, and
# when it is spent, ask the source for another".
#
# Its `Item` is `J.Item`: the element type of an iterator named only by a type
# *parameter*. That is a projection whose base is itself a parameter, which is
# why this adapter could not be written before milestone 50 — the checker was
# always fine with it, but codegen could not key an instantiation on it.
pub struct FlatMap<I: Iterator, J: Iterator> {
    inner: I,
    f: fun(I.Item) -> J,
    cur: Option<J>,
}

impl<I: Iterator, J: Iterator> Iterator for FlatMap<I, J> {
    type Item = J.Item;

    fun next(self) -> Option<J.Item> {
        loop {
            match self.cur {
                Option::Some(it) => {
                    match it.next() {
                        Option::Some(x) => { return Option::Some(x); },
                        # that one is spent — fall through to pull another seed
                        Option::None => { self.cur = Option::None; },
                    }
                },
                Option::None => {
                    match self.inner.next() {
                        Option::Some(seed) => {
                            self.cur = Option::Some((self.f)(seed));
                        },
                        # both cursors are done, so the sequence is
                        Option::None => { return Option::None; },
                    }
                },
            }
        }
    }
}

# `Enumerate` yields `(index, element)`, advancing a counter of its own beside
# the source's cursor.
pub struct Enumerate<I: Iterator> {
    inner: I,
    i: Int,
}

impl<I: Iterator> Iterator for Enumerate<I> {
    type Item = (Int, I.Item);

    fun next(self) -> Option<(Int, I.Item)> {
        match self.inner.next() {
            Option::Some(x) => {
                var idx = self.i;
                self.i += 1;
                return Option::Some((idx, x));
            },
            Option::None => { return Option::None; },
        }
    }
}

# `Zip` pulls one element from each source per step and pairs them; the sequence
# ends the moment either source does, so the shorter one sets the length.
pub struct Zip<I: Iterator, J: Iterator> {
    a: I,
    b: J,
}

impl<I: Iterator, J: Iterator> Iterator for Zip<I, J> {
    type Item = (I.Item, J.Item);

    fun next(self) -> Option<(I.Item, J.Item)> {
        match self.a.next() {
            Option::Some(x) => {
                match self.b.next() {
                    Option::Some(y) => { return Option::Some((x, y)); },
                    Option::None => { return Option::None; },
                }
            },
            Option::None => { return Option::None; },
        }
    }
}

# ── Sources ──────────────────────────────────────────────────────────────────
#
# Every adapter above wraps an iterator, and until milestone 60 the only way to
# get the first one was to write it: `for x in xs` and `for i in 0..n` are
# desugarings over an array and a range *directly*, so neither of the two
# sequence types a program actually has was an `Iterator`, and neither could
# reach a combinator. `xs.iter()` and `(0..n).iter()` are the seeds that close
# that — the whole of milestones 47–59 now applies to both.
#
# They live in this module rather than in `std::array`, and that is the import
# graph's doing rather than a preference: `collect` needs `push`, so `iter`
# imports `array`, and the dependency cannot also run the other way.

# A walk over an array's elements, in order. `xs.iter()` builds one.
#
# **It holds the array, not a borrow.** ducktape has no borrows to hold, so the
# question mutation raises has to be answered rather than prevented — and the
# answer is the one `for x in xs` already gives: nothing is snapshotted. What
# the iterator carries is how far in it has come *from each end*, so both
# `next` and `next_back` re-read `len()` and the two cursors are compared
# against the array as it is now. Growth is seen (an element pushed ahead of
# the front cursor will be yielded); shrinking ends the walk early instead of
# indexing off the end. The one thing that cannot happen is an out-of-bounds
# read, which is what the `taken_back` count buys over a stored end index.
pub struct ArrayIter<T> {
    xs: [T],
    front: Int,      # elements already yielded off the front
    taken_back: Int, # elements already yielded off the back
}

impl<T> Iterator for ArrayIter<T> {
    type Item = T;

    fun next(self) -> Option<T> {
        if self.front >= self.xs.len() - self.taken_back {
            return Option::None;
        }
        var v = self.xs[self.front];
        self.front += 1;
        return Option::Some(v);
    }
}

# An array knows how long it is, so its iterator can be driven from the back —
# `xs.iter().rev()` is a backwards walk with no intermediate array. `stop` is
# recomputed each call for the reason above: it is the live end, not a
# remembered one, and the emptiness test is what keeps `stop - 1` in bounds.
impl<T> DoubleEnded for ArrayIter<T> {
    fun next_back(self) -> Option<T> {
        var stop = self.xs.len() - self.taken_back;
        if self.front >= stop {
            return Option::None;
        }
        self.taken_back += 1;
        return Option::Some(self.xs[stop - 1]);
    }
}

impl<T> [T] {
    # Walk this array's elements as an `Iterator`, so the combinators apply:
    # `xs.iter().map(f).collect()`. The array itself is not copied — the
    # iterator holds it, with the consequences described on `ArrayIter`.
    fun iter(self) -> ArrayIter<T> {
        return ArrayIter { xs: self, front: 0, taken_back: 0 };
    }
}

# A range's two bounds, so the walk `for i in a..b` performs can be written
# here rather than only built into the loop. Both are `@intrinsic`s — the tier
# that gives an opcode a name, so a call costs the opcode and no frame, at the
# price that it can be called but never passed as a value.
#
# `range_start` is `OP_RANGE_START`, which the `for` desugaring already emitted
# and nothing could name; that is milestone 40's `array_len` move exactly.
# `range_stop` is the one new opcode, and it exists because the desugaring's
# other half asks the wrong question: `OP_RANGE_TEST` answers "is `i` still
# inside", which walks forwards and says nothing about where to *start* from
# the back. Answering with the first Int past the end is what folds `..` and
# `..=` into one bound.
#
# Free functions, and deliberately not methods on `Range`: an impl method has
# no visibility control, so a `Range::stop()` would be public API on every
# range in every program, and the exclusive-bound normalisation these two do is
# this module's business. `iter` below is the only thing a range gains.
@intrinsic("range_start")
fun range_start(r: Range) -> Int;

@intrinsic("range_stop")
fun range_stop(r: Range) -> Int;

# A walk over the Ints of a range. `(0..n).iter()` builds one.
#
# Unlike `ArrayIter` this holds no `Range` at all — a range is two numbers and
# a flag, and `range_stop` folds the flag away by answering with the first Int
# *past* the end. `0..3` and `0..=2` are the same three elements, so an
# iterator that had to remember which spelling it came from would be carrying a
# distinction its own sequence does not have.
pub struct RangeIter {
    cur: Int,
    stop: Int, # exclusive
}

impl Iterator for RangeIter {
    type Item = Int;

    fun next(self) -> Option<Int> {
        if self.cur >= self.stop {
            return Option::None;
        }
        var v = self.cur;
        self.cur += 1;
        return Option::Some(v);
    }
}

# Both bounds are numbers the iterator holds, so counting down from the far end
# costs exactly what counting up does: `(0..n).iter().rev()` is `n-1 … 0`.
impl DoubleEnded for RangeIter {
    fun next_back(self) -> Option<Int> {
        if self.cur >= self.stop {
            return Option::None;
        }
        self.stop -= 1;
        return Option::Some(self.stop);
    }
}

impl Range {
    # Walk this range's Ints as an `Iterator`. A range is a value, so unlike an
    # array there is nothing underneath for anyone else to change: the sequence
    # is fixed the moment the range is written.
    fun iter(self) -> RangeIter {
        return RangeIter { cur: range_start(self), stop: range_stop(self) };
    }
}

# The third source, and the one whose sequence is not already a sequence of
# *values*: a String is bytes, and its characters have to be decoded out of
# them. Before milestone 61 that decoding was a native returning the whole
# `[Char]` at once, which made the array the primitive and the walk a thing you
# did to it afterwards. It is the other way round — `s.chars().collect()` is
# that array, and nothing else has to be built to ask for the first character
# or to stop after three.
#
# These two are the whole C surface the walk needs, and they are private free
# functions for `range_start`'s reason: they speak in **byte offsets**, and a
# byte offset is not a character position. Keeping them here is what lets
# `CharIter` be the only thing that ever holds one.
@native("string_char_at")
fun char_at(s: String, at: Int) -> Char;

@native("string_prev_boundary")
fun prev_boundary(s: String, at: Int) -> Int;

# How many bytes `c` occupies in UTF-8. Stepping *forward* needs no native at
# all, because a scalar value determines its own encoding: this is the same
# range test over a code point that every `std::char` classification is, with
# the boundaries the code charts spell 0x80 / 0x800 / 0x10000. Stepping
# backward is not derivable this way and that asymmetry is the encoding's, not
# an oversight — going back there is no character in hand yet, so the only
# thing that says where one begins is the tag on the bytes, which is what
# `prev_boundary` reads.
fun utf8_width(c: Char) -> Int {
    var n = c.code();
    if n < 128 {
        return 1;
    }
    if n < 2048 {
        return 2;
    }
    if n < 65536 {
        return 3;
    }
    return 4;
}

# A walk over a String's characters, in order. `s.chars()` builds one.
#
# **It snapshots its end, where `ArrayIter` refuses to** — and the difference
# is the two objects', not a preference. An array is the one heap object a
# program can grow, so its iterator re-reads `len()` every turn and compares
# its cursors against the array *as it is now*; a String is interned and
# immutable, so there is nothing underneath a byte offset that could change
# and nothing to re-read. Milestone 60 had to answer "what does an iterator
# hold when the language has no borrow"; here the question dissolves, and it is
# immutability that dissolves it.
#
# Both cursors are **byte** offsets, and that is why they are private (milestone
# 44): a byte offset is not a character position, and walking characters without
# a program ever naming one is the whole point of this type.
#
# Laziness moves *when* invalid UTF-8 is reported. The old array conversion
# validated the entire string before yielding anything; a walk decodes one
# character at a time, so a malformed sequence is an error at the character
# that reaches it — and a pipeline that stops first (`s.chars().take(2)`) never
# reaches it at all. That is the ordinary consequence of being lazy rather than
# a weakening: nothing is claimed about bytes nobody looked at.
pub struct CharIter {
    s: String,
    front: Int, # byte offset where the next character begins
    back: Int,  # byte offset one past the last character not yet yielded
}

impl Iterator for CharIter {
    type Item = Char;

    fun next(self) -> Option<Char> {
        if self.front >= self.back {
            return Option::None;
        }
        var c = char_at(self.s, self.front);
        self.front += utf8_width(c);
        return Option::Some(c);
    }
}

# UTF-8 is self-synchronising — a lead byte is distinguishable from a
# continuation byte — so the far end of a string is reachable without walking
# to it, and `s.chars().rev()` costs what the forward walk costs. An encoding
# where it did not would make this impl a lie or an array.
impl DoubleEnded for CharIter {
    fun next_back(self) -> Option<Char> {
        if self.front >= self.back {
            return Option::None;
        }
        self.back = prev_boundary(self.s, self.back);
        return Option::Some(char_at(self.s, self.back));
    }
}

impl String {
    # Walk this string's characters as an `Iterator`. The array of them is
    # `s.chars().collect()`, which is the one call that has to change from
    # before milestone 61 — and the change is the point: `s.chars().count()`,
    # `s.chars().rev()` and `s.chars().take(3)` now build no array at all.
    fun chars(self) -> CharIter {
        return CharIter { s: self, front: 0, back: self.len() };
    }
}
