# std::ops — the arithmetic operators, as traits.
#
# The mirror of what `std::cmp` did for ordering (milestone 38) and `std::fmt`
# for interpolation: once a trait decides what an operator means, `a + b` is not
# an operator on `a` and `b` at all — it is the call `a.add(b)`. So the compiler
# rewrites the node and the operator disappears; nothing below the checker knows
# these traits exist.
#
# A numeric operand never reaches for them. `1 + 2` keeps `OP_ADD` — no import,
# no frame, no impl lookup — exactly as `1 < 2` keeps `OP_LT` and `"{1}"` keeps
# the VM's own rendering. Only a *non-numeric* operand asks a trait what the
# operator means, which is why the impls for `Int` and `Float` below are not
# what makes `1 + 2` work. They exist for the other direction: so a generic
# bounded `T: Add` can instantiate at a primitive.
#
# That is also why each of those impls is free. `self + other` inside `impl Add
# for Int` is two Ints, so it takes the built-in path and compiles to the
# opcode — it does not call itself. `std::fmt`'s four impls are written the same
# way (`return "{self}";`) and carry the same asymmetry, which there is a wart
# (a `Display` impl for a *non*-primitive written that way recurses forever) and
# here is not: an operator's built-in path is decided by the operand types, and
# an impl for a primitive is the only place those types are primitive.
#
# ── the shape of the traits ──────────────────────────────────────────────────
#
# `fun add(self, other: Rhs) -> Self`, where `Rhs` defaults to `Self`
# (milestone 75). The five binary operators are heterogeneous; `Neg`, which has
# no right operand, has no parameter.
#
# Until milestone 75 they were homogeneous, and the note here said a
# heterogeneous one "would type-check its impls and then fail to select them" —
# a generic trait's parameters are never *inferred* where the trait is named,
# and an operator has neither of the written spellings (`Meters::from(x)`,
# `Into::<U>::into(x)`) that selection by argument type had. That diagnosis was
# right and the conclusion was wrong: an operator does not need to *infer* the
# argument, because it has both operand types in hand and can simply write it
# down. `v * 2.0` asks for `Mul<Float>`, `v * w` for `Mul<V2>`, and coherence
# has allowed both impls to stand since milestone 28.
#
# ── why the default is load-bearing ──────────────────────────────────────────
#
# `Rhs = Self` is not a convenience. Without it every existing use would have to
# name the argument, and at a bound that argument is the bounded parameter
# itself — `T: Add<T>` — which is a bound naming its own subject. Milestone 75
# made that expressible too (see references/architecture.md), and the default is
# what saves every `T: Add` and `impl Add for Int` in this file and elsewhere
# from being rewritten. Nothing in `std` moved.
#
# ── why there is no `Output` ─────────────────────────────────────────────────
#
# Rust's `Add` also carries an associated `Output`; ours returns `Self`, so
# `V2 * Float` is a `V2` and a dot product `V2 * V2 -> Float` has no spelling.
# The reason is the mirror of the one above. A generic use would need
# `T: Add<Output = T>`, an equality binding naming its own subject — and while a
# *bound* may now do that, the binding is discharged by rewriting the projection
# to the type it names, so `sum`'s accumulator would be pinned by a promise the
# caller makes rather than by the impl. Adding `Output` would break every
# generic use of these traits before it enabled one, so it stays a wart in
# references/roadmap.md rather than a half-built feature here.
#
# `other: Rhs` still means none of these is object-safe once `Rhs` takes its
# default, so they are bounds and never a `dyn Add` — the same position `Ord`
# is in, and the same rule working as designed: object safety is demanded only
# where `dyn` is written.

@lang("add")
pub trait Add<Rhs = Self> {
    fun add(self, other: Rhs) -> Self;
}

@lang("sub")
pub trait Sub<Rhs = Self> {
    fun sub(self, other: Rhs) -> Self;
}

@lang("mul")
pub trait Mul<Rhs = Self> {
    fun mul(self, other: Rhs) -> Self;
}

@lang("div")
pub trait Div<Rhs = Self> {
    fun div(self, other: Rhs) -> Self;
}

# `%`. Named for the operation rather than the operator, and "remainder" rather
# than "modulo" because that is what the VM computes: the sign follows the
# dividend (C's `%` on Int, `fmod` on Float), so `-7 % 3` is -1 and not 2.
@lang("rem")
pub trait Rem<Rhs = Self> {
    fun rem(self, other: Rhs) -> Self;
}

# Unary `-`. The only one with no right operand, so it is the only one whose
# `Self` appears solely in the return — which does not make it object-safe
# either (`-> Self` is its own object-safety violation: a caller of a `dyn Neg`
# could not name what it got back).
@lang("neg")
pub trait Neg {
    fun neg(self) -> Self;
}

# ── the primitives ───────────────────────────────────────────────────────────
#
# Every body here is the built-in path, so these impls cost a frame at the call
# and nothing else. Shipping them is what lets `T: Add` instantiate at `Int` —
# and, as with `Display` and `Ord`, it takes the pair away from a program that
# would write its own `impl Add for Int`, since naming the trait makes this impl
# visible and coherence rejects the second.

impl Add for Int {
    fun add(self, other: Int) -> Int { return self + other; }
}

impl Sub for Int {
    fun sub(self, other: Int) -> Int { return self - other; }
}

impl Mul for Int {
    fun mul(self, other: Int) -> Int { return self * other; }
}

impl Div for Int {
    fun div(self, other: Int) -> Int { return self / other; }
}

impl Rem for Int {
    fun rem(self, other: Int) -> Int { return self % other; }
}

impl Neg for Int {
    fun neg(self) -> Int { return 0 - self; }
}

impl Add for Float {
    fun add(self, other: Float) -> Float { return self + other; }
}

impl Sub for Float {
    fun sub(self, other: Float) -> Float { return self - other; }
}

impl Mul for Float {
    fun mul(self, other: Float) -> Float { return self * other; }
}

impl Div for Float {
    fun div(self, other: Float) -> Float { return self / other; }
}

impl Rem for Float {
    fun rem(self, other: Float) -> Float { return self % other; }
}

impl Neg for Float {
    fun neg(self) -> Float { return 0.0 - self; }
}

# `+` on two Strings is a built-in concat, decided before any trait is
# consulted, so this impl changes nothing about `s + t`. It is here so that a
# `T: Add` generic can instantiate at `String` — `it.sum()` over a sequence of
# words is the reason it earns its place — and its body is the same built-in
# path the primitives' are.
impl Add for String {
    fun add(self, other: String) -> String { return self + other; }
}
