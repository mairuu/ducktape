# std::option — a value that may be absent.
#
# Like std::cmp, this is written in ducktape and needs no builtin: `Option<T>`
# is an ordinary generic enum, its methods are an ordinary generic inherent
# impl, and the combinators take ordinary closures.
#
use std::cmp::Ord;
use std::fmt::Display;
use std::panic::panic;

# The lang item behind `d as? T`, which evaluates to an `Option<T>`. Every
# other consumer takes an `Option` *apart* and reads its two variants
# structurally; a downcast produces one, and has no operand to read the
# definition off, so it is the one construct that must name this enum.
@lang("option")
pub enum Option<T> {
    Some(T),
    None,
}

# Both variants are preluded, so `Some(v)` and `None` are written bare in any
# module. Re-exported here rather than special-cased in the compiler: the
# prelude imports names from a module, and this is what makes these two names.
pub use Option::{Some, None};

impl<T> Option<T> {
    fun is_some(self) -> Bool {
        match self {
            Option::Some(_) => { return true; },
            Option::None => { return false; },
        }
    }

    fun is_none(self) -> Bool {
        return not self.is_some();
    }

    # The contained value, or `fallback` when there is none. `fallback` is
    # evaluated either way — use `unwrap_or_else` when computing it is costly.
    fun unwrap_or(self, fallback: T) -> T {
        match self {
            Option::Some(v) => { return v; },
            Option::None => { return fallback; },
        }
    }

    # The contained value, or a panic. This is the accessor that waited for
    # `std::panic`: producing a `T` from a `None` has nowhere to go but out.
    # `panic` returns `Never`, which stands in for any type, so the arm
    # type-checks like any other.
    fun unwrap(self) -> T {
        match self {
            Option::Some(v) => { return v; },
            Option::None => {
                return panic("called 'unwrap' on a 'None' value");
            },
        }
    }

    # `unwrap` with a message of your own, saying what was expected.
    fun expect(self, message: String) -> T {
        match self {
            Option::Some(v) => { return v; },
            Option::None => { return panic(message); },
        }
    }

    fun unwrap_or_else(self, fallback: fun() -> T) -> T {
        match self {
            Option::Some(v) => { return v; },
            Option::None => { return fallback(); },
        }
    }

    # Apply `f` to the contained value, if there is one.
    fun map<U>(self, f: fun(T) -> U) -> Option<U> {
        match self {
            Option::Some(v) => { return Option::Some(f(v)); },
            Option::None => { return Option::None; },
        }
    }

    # `map` for an `f` that may itself find nothing — the two `None`s collapse
    # instead of nesting into `Option<Option<U>>`.
    fun and_then<U>(self, f: fun(T) -> Option<U>) -> Option<U> {
        match self {
            Option::Some(v) => { return f(v); },
            Option::None => { return Option::None; },
        }
    }

    # Keep the value only when it satisfies `pred`.
    fun filter(self, pred: fun(T) -> Bool) -> Option<T> {
        match self {
            Option::Some(v) => {
                if pred(v) {
                    return Option::Some(v);
                }
                return Option::None;
            },
            Option::None => { return Option::None; },
        }
    }

    # `self` if it holds a value, otherwise `other`. Not spelled `or`, which is a
    # keyword; the closure-taking form would be the one named `or_else`.
    fun otherwise(self, other: Option<T>) -> Option<T> {
        match self {
            Option::Some(v) => { return Option::Some(v); },
            Option::None => { return other; },
        }
    }
}

# `None` sorts before every `Some`, and two `Some`s compare their contents —
# which is the ordering that makes `min` pick a present value over an absent
# one. Only available where `T` itself is ordered.
impl<T: Ord> Ord for Option<T> {
    fun cmp(self, other: Option<T>) -> Int {
        match self {
            Option::Some(a) => {
                match other {
                    Option::Some(b) => { return a.cmp(b); },
                    Option::None => { return 1; },
                }
            },
            Option::None => {
                match other {
                    Option::Some(_) => { return 0 - 1; },
                    Option::None => { return 0; },
                }
            },
        }
    }
}

# Rendered the way it is written. `Display` lives here rather than in
# `std::fmt` for the same reason `Ord` above does: an impl belongs beside the
# type it is for, and since milestone 19 that also decides who sees it — a
# program that imports `Option` gets its rendering, and one that doesn't is
# free to define its own.
impl<T: Display> Display for Option<T> {
    fun to_string(self) -> String {
        match self {
            Option::Some(v) => { return "Some(" + v.to_string() + ")"; },
            Option::None => { return "None"; },
        }
    }
}
