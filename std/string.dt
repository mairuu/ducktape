# std::string — operations on `String`, and the buffer one is built with.
#
# A `String` is an interned, immutable heap object, so `slice` allocates: it
# is the module that exercises the native calling convention's one real rule,
# that arguments stay on the VM stack across the call and so remain rooted
# through any collection the native triggers.
#
# `slice` is also the one native here that can *fail*. A native reports a
# runtime error by setting `ctx->error`, which the VM turns into an error at
# the call site — the closest thing the language has to a panic until there is
# a real one (roadmap: `std::result`).
#
# `std::string` reaches only `std::strbuf` — the buffer `join` and friends build
# through — and `std::strbuf` imports nothing and ships no impls, so importing
# any of `std::string` still hands a program no impls it did not ask for. That is
# the property `std::cmp` leans on by building `impl Ord for String` on `compare`
# here, and it is what `std::array` stopped being able to promise once `pop`
# started answering with an `Option`. `join` iterating with `for` (whose
# desugaring emits the length opcode itself) rather than importing
# `std::array::len` is the same discipline: reaching `std::array` would reach
# `Option` and close the cycle `string → option → cmp → string`.

use std::strbuf::{new, push, push_char, build};

@native("string_len")
pub fun len(s: String) -> Int;

# `s[from..to)`, indexed in bytes. A runtime error if the range is not within
# the string.
@native("string_slice")
pub fun slice(s: String, from: Int, to: Int) -> String;

# Byte order: <0 if `a` sorts before `b`, 0 if equal, >0 if after. This is what
# `impl Ord for String` is written on, and it has to be a native for the same
# reason `push` does — it is a thing a String cannot express about itself. The
# only handle ducktape has on a String's contents is `slice`, and comparing two
# one-byte slices needs string ordering, which is what was being defined.
#
# Interning contributes nothing here beyond the equal case, which is the limit
# of the gift it made to `==`: two equal strings are one pointer, but pointer
# order is allocation order.
@native("string_cmp")
pub fun compare(a: String, b: String) -> Int;

# The characters `s` is made of, in order. This is the one crossing between
# the two views of text the language has — bytes here, scalar values in
# `std::char` — and it is a *conversion* on purpose: there is no `char_at(s,
# i)`, because `i` would be a byte offset and a byte offset is not a character
# position. Offering that spelling would make confusing the two the default.
#
# A runtime error if `s` is not valid UTF-8, which a program can reach: `slice`
# cuts at byte offsets, so it can halve a multi-byte sequence. A String is a
# byte string; only a Char promises to be a character.
@native("string_chars")
pub fun chars(s: String) -> [Char];

# ── building a string ────────────────────────────────────────────────────────
#
# The buffer these build through lives in `std::strbuf`; here it is only the
# String-shaped conveniences on top of it.

# `sep` between each pair of parts. The buffer is what makes this one pass:
# the same loop written with `+` would intern every prefix along the way.
pub fun join(parts: [String], sep: String) -> String {
    var b = new();
    var first = true;
    for p in parts {
        if not first {
            push(b, sep);
        }
        push(b, p);
        first = false;
    }
    return build(b);
}

pub fun concat(parts: [String]) -> String {
    return join(parts, "");
}

# `chars` the other way round. Ordinary ducktape rather than a fifth native,
# because `push_char` already put the one operation a buffer could not express
# within reach: a String is built out of Chars exactly the way it is built out
# of anything else.
pub fun from_chars(cs: [Char]) -> String {
    var b = new();
    for c in cs {
        push_char(b, c);
    }
    return build(b);
}

# `n` copies of `s`. Nothing here allocates a String per copy — the bytes go
# straight into the buffer — which is the difference a buffer makes that an
# array of parts could not.
pub fun repeat(s: String, n: Int) -> String {
    var b = new();
    var i = 0;
    while i < n {
        push(b, s);
        i = i + 1;
    }
    return build(b);
}

# ── padding to a width ─────────────────────────────────────────────────────────
#
# A rendered value laid out in a field of a given *character* width, `fill`
# making up the difference. Width is a character count rather than a byte count
# because alignment is a display question, and a display question is about
# characters — the same fork `std::text` answered this way (a classification
# crosses to `chars`, only a position stays a byte offset). The cost is that
# `chars` walks the UTF-8, so a padded string must be valid UTF-8; the win is
# that `pad_start("café", 6, ' ')` adds two spaces, not one. It is still a
# *character* count and not a true display width — a double-width or combining
# character counts as one — the same ASCII-exact limit `std::char` documents.
#
# The count is a `for` over `chars` rather than `array::len(chars(s))` for the
# same reason `join` counts nothing at all: reaching `std::array` would reach
# `Option` and close the `string → option → cmp → string` cycle. Padding never
# truncates — a string already at least `width` wide is returned unchanged —
# because narrowing is `slice`'s job and it cuts in bytes, a different question.

# how many characters `s` is, walking its scalar values. Private: the three
# pad functions each need it, and factoring it keeps the byte/character choice
# in one place rather than three.
fun char_width(s: String) -> Int {
    var n = 0;
    for _ in chars(s) {
        n = n + 1;
    }
    return n;
}

# `s` at the left of a `width`-wide field, `fill` on the right (left-aligned).
pub fun pad_end(s: String, width: Int, fill: Char) -> String {
    var cur = char_width(s);
    if cur >= width {
        return s;
    }
    var b = new();
    push(b, s);
    for _ in cur..width {
        push_char(b, fill);
    }
    return build(b);
}

# `fill` on the left, `s` at the right of a `width`-wide field (right-aligned).
pub fun pad_start(s: String, width: Int, fill: Char) -> String {
    var cur = char_width(s);
    if cur >= width {
        return s;
    }
    var b = new();
    for _ in cur..width {
        push_char(b, fill);
    }
    push(b, s);
    return build(b);
}

# `s` centred in a `width`-wide field. An odd remainder puts the extra `fill` on
# the right, so `pad_center("x", 4, '-')` is `-x--`: the text sits left of centre
# when it cannot sit on it, which is the convention a reader expects for a label.
pub fun pad_center(s: String, width: Int, fill: Char) -> String {
    var cur = char_width(s);
    if cur >= width {
        return s;
    }
    var total = width - cur;
    var left = total / 2;
    var b = new();
    for _ in 0..left {
        push_char(b, fill);
    }
    push(b, s);
    for _ in 0..(total - left) {
        push_char(b, fill);
    }
    return build(b);
}
