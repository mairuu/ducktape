# std::string — operations on `String`, and the buffers one is built with.
#
# A `String` is an interned, immutable heap object, so `slice` allocates: it
# is the module that exercises the native calling convention's one real rule,
# that arguments stay on the VM stack across the call and so remain rooted
# through any collection the native triggers.
#
# `slice` is also the one native here that can *fail*. A native reports a
# runtime error by setting `ctx->error`, which the VM turns into an error at
# the call site — the closest thing the language has to a panic until there is
# a real one (roadmap: `std::result`).
#
# The operations *on* a String are **methods** (milestone 40): `s.len()`,
# `s.slice(from, to)`, `s.chars()`, `s.compare(other)`, `s.repeat(n)`. The
# collection→String *builders* below (`join`, `concat`, `from_chars`) stay free
# functions, because their receiver is an array, not a String; and the three
# `pad_*` functions stay free because they are lang items the `{v:>8}` format
# spec desugars into (see `check_interpol_seg`), so their meaning cannot depend
# on what a program imported.
#
# `std::string` reaches only `std::strbuf` — the buffer these builders run
# through — and `std::strbuf` imports nothing, shipping only methods on its own
# `StringBuf`, so importing any of `std::string` still hands a program no impls
# for a type it did not itself name. That is the property `std::cmp` leans on by
# building `impl Ord for String` on `compare` here, and it is what `std::array`
# stopped being able to promise once `pop` started answering with an `Option`.

use std::strbuf;

impl String {
    @native("string_len")
    fun len(self) -> Int;

    # `self[from..to)`, indexed in bytes. A runtime error if the range is not
    # within the string.
    @native("string_slice")
    fun slice(self, from: Int, to: Int) -> String;

    # Byte order: <0 if `self` sorts before `other`, 0 if equal, >0 if after.
    # This is what `impl Ord for String` is written on, and it has to be a native
    # for the same reason `push` does — it is a thing a String cannot express
    # about itself. The only handle ducktape has on a String's contents is
    # `slice`, and comparing two one-byte slices needs string ordering, which is
    # what was being defined.
    #
    # Interning contributes nothing here beyond the equal case, which is the
    # limit of the gift it made to `==`: two equal strings are one pointer, but
    # pointer order is allocation order.
    @native("string_cmp")
    fun compare(self, other: String) -> Int;

    # The characters `self` is made of, in order. This is the one crossing
    # between the two views of text the language has — bytes here, scalar values
    # in `std::char` — and it is a *conversion* on purpose: there is no
    # `char_at(i)`, because `i` would be a byte offset and a byte offset is not a
    # character position. Offering that spelling would make confusing the two the
    # default.
    #
    # A runtime error if `self` is not valid UTF-8, which a program can reach:
    # `slice` cuts at byte offsets, so it can halve a multi-byte sequence. A
    # String is a byte string; only a Char promises to be a character.
    @native("string_chars")
    fun chars(self) -> [Char];

    # `n` copies of `self`. Nothing here allocates a String per copy — the bytes
    # go straight into the buffer — which is the difference a buffer makes that
    # an array of parts could not.
    fun repeat(self, n: Int) -> String {
        var b = StringBuf::new();
        var i = 0;
        while i < n {
            b.push(self);
            i = i + 1;
        }
        return b.build();
    }
}

# ── building a string ────────────────────────────────────────────────────────
#
# The buffer these build through lives in `std::strbuf`; here they are only the
# String-shaped conveniences on top of it. They stay free functions because the
# thing they operate on is a `[String]` / `[Char]`, not a `String`.

# `sep` between each pair of parts. The buffer is what makes this one pass:
# the same loop written with `+` would intern every prefix along the way.
pub fun join(parts: [String], sep: String) -> String {
    var b = StringBuf::new();
    var first = true;
    for p in parts {
        if not first {
            b.push(sep);
        }
        b.push(p);
        first = false;
    }
    return b.build();
}

pub fun concat(parts: [String]) -> String {
    return join(parts, "");
}

# `chars` the other way round. Ordinary ducktape rather than a fifth native,
# because `push_char` already put the one operation a buffer could not express
# within reach: a String is built out of Chars exactly the way it is built out
# of anything else.
pub fun from_chars(cs: [Char]) -> String {
    var b = StringBuf::new();
    for c in cs {
        b.push_char(c);
    }
    return b.build();
}

# ── padding to a width ─────────────────────────────────────────────────────────
#
# A rendered value laid out in a field of a given *character* width, `fill`
# making up the difference. Width is a character count rather than a byte count
# because alignment is a display question, and a display question is about
# characters — the same fork `std::text` answered this way (a classification
# crosses to `chars`, only a position stays a byte offset). The cost is that
# `chars` walks the UTF-8, so a padded string must be valid UTF-8; the win is
# that `pad_start("café", 6, ' ')` adds two spaces, not one. It is still a
# *character* count and not a true display width — a double-width or combining
# character counts as one — the same ASCII-exact limit `std::char` documents.
#
# These stay free functions, unlike the operations above, because they are lang
# items: the `{v:>8}` format spec desugars in the checker to a `pad_*` call (see
# `check_interpol_seg`), and the user never writes the name, so its meaning
# cannot be left to whatever a program imported. Padding never truncates — a
# string already at least `width` wide is returned unchanged — because narrowing
# is `slice`'s job and it cuts in bytes, a different question.

# how many characters `s` is, walking its scalar values. Private: the three
# pad functions each need it, and factoring it keeps the byte/character choice
# in one place rather than three.
fun char_width(s: String) -> Int {
    var n = 0;
    for _ in s.chars() {
        n = n + 1;
    }
    return n;
}

# `s` at the left of a `width`-wide field, `fill` on the right (left-aligned).
@lang("pad_end")
pub fun pad_end(s: String, width: Int, fill: Char) -> String {
    var cur = char_width(s);
    if cur >= width {
        return s;
    }
    var b = StringBuf::new();
    b.push(s);
    for _ in cur..width {
        b.push_char(fill);
    }
    return b.build();
}

# `fill` on the left, `s` at the right of a `width`-wide field (right-aligned).
@lang("pad_start")
pub fun pad_start(s: String, width: Int, fill: Char) -> String {
    var cur = char_width(s);
    if cur >= width {
        return s;
    }
    var b = StringBuf::new();
    for _ in cur..width {
        b.push_char(fill);
    }
    b.push(s);
    return b.build();
}

# `s` centred in a `width`-wide field. An odd remainder puts the extra `fill` on
# the right, so `pad_center("x", 4, '-')` is `-x--`: the text sits left of centre
# when it cannot sit on it, which is the convention a reader expects for a label.
@lang("pad_center")
pub fun pad_center(s: String, width: Int, fill: Char) -> String {
    var cur = char_width(s);
    if cur >= width {
        return s;
    }
    var total = width - cur;
    var left = total / 2;
    var b = StringBuf::new();
    for _ in 0..left {
        b.push_char(fill);
    }
    b.push(s);
    for _ in 0..(total - left) {
        b.push_char(fill);
    }
    return b.build();
}
