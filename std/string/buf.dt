# std::string::buf — a growable text buffer, the object a `string` is built from.
#
# `a + b` allocates a whole new string and interns it, so growing one a piece at
# a time re-interns the entire accumulation at every step. A `StringBuf` is the
# way out, and it is a distinct *type* rather than a mutable `string` because
# interning is precisely what makes a string immutable: two equal strings are
# one pointer, so an object filed under the hash of its bytes cannot have its
# bytes change underneath it. So a buffer is the object deliberately kept out of
# that table, `build` is the one-way door back in, and the natives below are the
# whole of what the buffer cannot express about itself in ducktape.
#
# The operations are **methods** (milestone 40): `b.len()`, `b.push(s)`,
# `b.build()`. A method resolves on its receiver's type, so `b.len()`,
# `s.len()` and `xs.len()` coexist with nothing aliased apart — the collision
# the free-function spelling once had to dodge (`buf_len`, `push_str`) and then
# disambiguate with a qualifier is gone, since a method names the operation and
# the receiver names which one. The impl this ships is on the module's own
# `StringBuf`, so it costs no other program a name: nothing else adds methods to
# a type only this module defines.

impl StringBuf {
    @native("strbuf_new")
    fun new() -> StringBuf;

    # Append the bytes of `s`, growing the buffer when it is full. Like a `[T]`,
    # a `StringBuf` is a reference to one growable object, so every name bound to
    # it sees the append — which is why this takes the receiver by value and
    # needs no way to spell "by reference".
    @native("strbuf_push")
    fun push(self, s: string);

    # Append one character's UTF-8 bytes. This is the append that an array of
    # parts could never have offered, and so the one that shows why a buffer was
    # worth a new object kind: the bytes go straight in, with no string interned
    # along the way to carry them.
    @native("strbuf_push_char")
    fun push_char(self, c: char);

    # Append an int's decimal digits, without first interning a string to carry
    # them. `b.push("{n}")` would build a throwaway string for the digits — the
    # re-interning a buffer exists to avoid — so this is `push_char`'s sibling
    # for numbers: the bytes go straight in.
    @native("strbuf_push_int")
    fun push_int(self, n: int);

    # The bytes written so far.
    @native("strbuf_len")
    fun len(self) -> int;

    # Empty the buffer, keeping the capacity it has grown to. A buffer can be
    # reused across a loop this way rather than allocating a fresh `new()` each
    # round; the bytes are not released, only forgotten, so the next `push`
    # reuses the space.
    @native("strbuf_clear")
    fun clear(self);

    # intern the bytes written so far into a `string`. Non-destructive: the
    # buffer is unchanged and may be appended to again, so `build` inside a loop
    # is a snapshot rather than a handover.
    @native("strbuf_build")
    fun build(self) -> string;

    fun is_empty(self) -> bool {
        return self.len() == 0;
    }
}
