# std::text — searching, splitting and parsing text, above the leaf.
#
# Everything here is ordinary ducktape over the primitives `std::string` and
# `std::char` already offer. What it is *not* is part of `std::string`, and the
# reason is a dependency cycle rather than taste: `std::cmp` imports
# `std::string` (for `compare`, since milestone 25), `std::option` imports
# `std::cmp`, and every function below either answers with an `Option` or builds
# a `[String]`. So `std::string` importing `Option` or array `push` would close
# the loop `string → option → cmp → string`, which the dependency graph rejects
# outright. `std::string` reaches nothing above the buffer it builds through, so
# the operations that reach past it live one module up.
#
# They are still *methods on `String`* (milestone 41): a second `impl String`,
# one module up from the leaf's. Two inherent impls for one type coexist because
# their method names are disjoint and neither is a trait impl, so coherence has
# no say — the impl index simply finds each method by name in whichever visible
# impl declares it. So `s.trim()` and `s.parse_int()` read like `s.len()` even
# though the cycle forces them to live in a different file, and the module
# boundary the cycle draws is invisible at the call site: a program writes
# `use std::text;` and calls the methods, never naming one.
#
# Two views of text meet here, and the split between them is the milestone-26
# rule that `std::string` and `std::char` were built around:
#   - a *position* is a byte offset, because a position is one you will `slice`
#     at — `find` and `split` search by comparing at one, and never look at a
#     byte on its own;
#   - a *character* is classified by its value, so `trim` and `parse_int` cross
#     to the `chars` view — whether something is a space or a digit is a fact
#     about a character, not a byte.
# `starts_with` needs neither a position nor a classification, so it is the bare
# `matches_at`.
#
# Searching is `matches_at` rather than `slice`+`==` as of milestone 101, and
# the change was forced rather than chosen: a search compares *speculatively*,
# at offsets it has no reason to believe in yet, and a String that guarantees
# its own UTF-8 cannot be cut at one of those. The compare is total where the
# cut is not, and it also deletes the interned candidate window every position
# used to allocate.
#
# `s.len()` (bytes) and `cs.len()` (elements) both appear below, told apart by
# their receiver's type rather than by a module qualifier. The impls those
# receivers need — `String`, `[T]`, `StringBuf`, `char` — arrive transitively
# through the two imports below rather than being named here: an import that
# binds a name nothing writes is reported as unused (milestone 92), and
# reachability cannot tell a deliberate restatement from a leftover.
#
# The crossing is a *walk* as of milestone 61, so `std::iter` joins them and the
# two functions that cross say `.chars().collect()`. They collect rather than
# stream because both want the characters by index from either end — `trim`
# scans in from both, `parse_int` looks at the first before the rest — and the
# array a walk builds on request is exactly what that needs. What changed for
# them is only where it comes from.

use std::option::Option;
use std::iter;

impl String {
    # ── searching, by byte position ──────────────────────────────────────────

    # Does `self` begin with `prefix`? `matches_at` answers a prefix longer than
    # `self` on its own — running off the end is `false`, not an error — so the
    # length test the cutting version needed is gone, and the empty prefix
    # matches everywhere including at 0.
    fun starts_with(self, prefix: String) -> bool {
        return self.matches_at(0, prefix);
    }

    # The one place a *position* is computed rather than scanned to, and the one
    # that has to stay guarded: `n - sl` is only an offset in the string when the
    # suffix is no longer than it.
    fun ends_with(self, suffix: String) -> bool {
        var sl = suffix.len();
        var n = self.len();
        if sl > n {
            return false;
        }
        return self.matches_at(n - sl, suffix);
    }

    # The byte offset of the first occurrence of `needle` in `self`, or `None`.
    # The empty needle is found at 0, matching `starts_with`'s reading of it.
    #
    # The scan visits every byte offset, including ones inside a character, and
    # does not have to skip them: a non-empty needle starts with a lead byte, so
    # those offsets answer `false` of their own accord. Which is also why an
    # offset this returns is always a character boundary, and so always safe to
    # `slice` at.
    fun find(self, needle: String) -> Option<int> {
        var nl = needle.len();
        if nl == 0 {
            return Option::Some(0);
        }
        var n = self.len();
        var i = 0;
        while i + nl <= n {
            if self.matches_at(i, needle) {
                return Option::Some(i);
            }
            i = i + 1;
        }
        return Option::None;
    }

    fun contains(self, needle: String) -> bool {
        return self.find(needle).is_some();
    }

    # `self` cut at every occurrence of `sep`, in order. Adjacent separators, and
    # a leading or trailing one, each yield an empty piece, so the result always
    # has one more element than there were separators — `"a,b".split(",")` is
    # `["a", "b"]` and `",".split(",")` is `["", ""]`.
    #
    # An empty separator has no occurrences to cut at, so `self` comes back whole
    # in a one-element array rather than one character per element: there is no
    # position at which `""` is *not*, so the loop that finds them would never
    # end.
    #
    # This is the one function that both searches and cuts, so it is where the
    # two halves meet: every `slice` below is at a match position or at an end,
    # and a match position is a character boundary (see `find`), so a separator
    # can never split a character in half. The empty separator is turned away
    # before the loop for its own reason, but it is also the only needle that
    # could have matched inside one.
    fun split(self, sep: String) -> [String] {
        var parts: [String] = [];
        var sl = sep.len();
        if sl == 0 {
            parts.push(self);
            return parts;
        }
        var n = self.len();
        var start = 0;
        var i = 0;
        while i + sl <= n {
            if self.matches_at(i, sep) {
                parts.push(self.slice(start, i));
                i = i + sl;
                start = i;
            } else {
                i = i + 1;
            }
        }
        parts.push(self.slice(start, n));
        return parts;
    }

    # ── trimming and parsing, by character ───────────────────────────────────

    # `self` with leading and trailing whitespace removed. This is the crossing
    # to the character view: whitespace is a `char` classification, and an ASCII
    # space is a single byte only by luck of the encoding — so the honest
    # spelling walks characters, not bytes, and rebuilds the middle through a
    # buffer rather than assuming a trimmed edge lands on a byte boundary.
    fun trim(self) -> String {
        var cs = self.chars().collect();
        var n = cs.len();
        var lo = 0;
        while lo < n {
            if not cs[lo].is_whitespace() {
                break;
            }
            lo = lo + 1;
        }
        var hi = n;
        while hi > lo {
            if not cs[hi - 1].is_whitespace() {
                break;
            }
            hi = hi - 1;
        }
        var b = StringBuf::new();
        var i = lo;
        while i < hi {
            b.push_char(cs[i]);
            i = i + 1;
        }
        return b.build();
    }

    # The integer `self` spells, or `None` if it spells none. An optional leading
    # `+` or `-`, then one or more digits, and nothing else — an empty string, a
    # bare sign, or a stray character each answer `None` rather than a partial
    # parse.
    #
    # Overflow is not detected: a value past what an `int` holds wraps rather
    # than failing, which is the one thing this cannot promise without a widening
    # multiply the language has no way to spell.
    fun parse_int(self) -> Option<int> {
        var cs = self.chars().collect();
        var n = cs.len();
        if n == 0 {
            return Option::None;
        }
        var i = 0;
        var neg = false;
        if cs[0] == '-' {
            neg = true;
            i = 1;
        } else if cs[0] == '+' {
            i = 1;
        }
        if i == n {
            return Option::None;
        }
        var acc = 0;
        while i < n {
            var c = cs[i];
            if not c.is_digit() {
                return Option::None;
            }
            acc = acc * 10 + c.to_digit();
            i = i + 1;
        }
        if neg {
            return Option::Some(-acc);
        }
        return Option::Some(acc);
    }
}
