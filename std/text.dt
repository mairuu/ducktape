# std::text — searching, splitting and parsing text, above the leaf.
#
# Everything here is ordinary ducktape over the primitives `std::string` and
# `std::char` already offer. What it is *not* is part of `std::string`, and the
# reason is a dependency cycle rather than taste: `std::cmp` imports
# `std::string` (for `compare`, since milestone 25), `std::option` imports
# `std::cmp`, and every function below either answers with an `Option` or builds
# a `[String]`. So `std::string` importing `Option` or array `push` would close
# the loop `string → option → cmp → string`, which the dependency graph rejects
# outright. `std::string` reaches nothing above the buffer it builds through, so
# the operations that reach past it live one module up.
#
# Two views of text meet here, and the split between them is the milestone-26
# rule that `std::string` and `std::char` were built around:
#   - a *position* is a byte offset, because a position is one you will `slice`
#     at — `find` and `split` are written on `slice` and `==`, and never look at
#     a byte on its own;
#   - a *character* is classified by its value, so `trim` and `parse_int` cross
#     to the `chars` view — whether something is a space or a digit is a fact
#     about a character, not a byte.
# `starts_with` needs neither a position nor a classification, so it is the pure
# `slice`+`==` one.
#
# `string::len` (bytes) and `array::len` (elements) both appear below, told apart
# by their module rather than aliased apart at the `use` — the reason a module is
# bound as a qualifier here rather than its items imported by name.

use std::string;
use std::strbuf;
use std::array;
use std::option::Option;
use std::char::{is_whitespace, is_digit, to_digit};

# ── searching, by byte position ──────────────────────────────────────────────

# Does `s` begin with `prefix`? A prefix longer than `s` cannot match, and the
# empty prefix always does — `slice(s, 0, 0)` is `""`, which interns to the same
# pointer `""` does, so `==` answers yes without a special case.
pub fun starts_with(s: String, prefix: String) -> Bool {
    var pl = string::len(prefix);
    if pl > string::len(s) {
        return false;
    }
    return string::slice(s, 0, pl) == prefix;
}

pub fun ends_with(s: String, suffix: String) -> Bool {
    var sl = string::len(suffix);
    var n = string::len(s);
    if sl > n {
        return false;
    }
    return string::slice(s, n - sl, n) == suffix;
}

# The byte offset of the first occurrence of `needle` in `s`, or `None`. The
# empty needle is found at 0, matching `starts_with`'s reading of it.
#
# This slices and interns a candidate substring at every position, so it is
# O(len(s) * len(needle)) allocations — the honest cost of a String whose only
# reader is `slice`, since there is no way to compare a window without cutting
# it out first. A byte-level scan would need a `byte_at` the language declines
# to offer (see `std::char`).
pub fun find(s: String, needle: String) -> Option<Int> {
    var nl = string::len(needle);
    if nl == 0 {
        return Option::Some(0);
    }
    var n = string::len(s);
    var i = 0;
    while i + nl <= n {
        if string::slice(s, i, i + nl) == needle {
            return Option::Some(i);
        }
        i = i + 1;
    }
    return Option::None;
}

pub fun contains(s: String, needle: String) -> Bool {
    return find(s, needle).is_some();
}

# `s` cut at every occurrence of `sep`, in order. Adjacent separators, and a
# leading or trailing one, each yield an empty piece, so the result always has
# one more element than there were separators — `split("a,b", ",")` is
# `["a", "b"]` and `split(",", ",")` is `["", ""]`.
#
# An empty separator has no occurrences to cut at, so `s` comes back whole in a
# one-element array rather than one character per element: there is no position
# at which `""` is *not*, so the loop that finds them would never end.
pub fun split(s: String, sep: String) -> [String] {
    var parts: [String] = [];
    var sl = string::len(sep);
    if sl == 0 {
        array::push(parts, s);
        return parts;
    }
    var n = string::len(s);
    var start = 0;
    var i = 0;
    while i + sl <= n {
        if string::slice(s, i, i + sl) == sep {
            array::push(parts, string::slice(s, start, i));
            i = i + sl;
            start = i;
        } else {
            i = i + 1;
        }
    }
    array::push(parts, string::slice(s, start, n));
    return parts;
}

# ── trimming and parsing, by character ───────────────────────────────────────

# `s` with leading and trailing whitespace removed. This is the crossing to the
# character view: whitespace is a `Char` classification, and an ASCII space is a
# single byte only by luck of the encoding — so the honest spelling walks
# characters, not bytes, and rebuilds the middle through a buffer rather than
# assuming a trimmed edge lands on a byte boundary.
pub fun trim(s: String) -> String {
    var cs = string::chars(s);
    var n = array::len(cs);
    var lo = 0;
    while lo < n {
        if not is_whitespace(cs[lo]) {
            break;
        }
        lo = lo + 1;
    }
    var hi = n;
    while hi > lo {
        if not is_whitespace(cs[hi - 1]) {
            break;
        }
        hi = hi - 1;
    }
    var b = strbuf::new();
    var i = lo;
    while i < hi {
        strbuf::push_char(b, cs[i]);
        i = i + 1;
    }
    return strbuf::build(b);
}

# The integer `s` spells, or `None` if it spells none. An optional leading `+`
# or `-`, then one or more digits, and nothing else — an empty string, a bare
# sign, or a stray character each answer `None` rather than a partial parse.
#
# Overflow is not detected: a value past what an `Int` holds wraps rather than
# failing, which is the one thing this cannot promise without a widening
# multiply the language has no way to spell.
pub fun parse_int(s: String) -> Option<Int> {
    var cs = string::chars(s);
    var n = array::len(cs);
    if n == 0 {
        return Option::None;
    }
    var i = 0;
    var neg = false;
    if cs[0] == '-' {
        neg = true;
        i = 1;
    } else if cs[0] == '+' {
        i = 1;
    }
    if i == n {
        return Option::None;
    }
    var acc = 0;
    while i < n {
        var c = cs[i];
        if not is_digit(c) {
            return Option::None;
        }
        acc = acc * 10 + to_digit(c);
        i = i + 1;
    }
    if neg {
        return Option::Some(-acc);
    }
    return Option::Some(acc);
}
