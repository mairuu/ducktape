#! expect: does not satisfy 'I.Item = int'
# A binding may name a concrete type, which makes `I: Iterator<Item = int>`
# read as "an iterator of ints" — a signature that can then use its elements as
# ints. The promise is discharged where `I` is bound, so an iterator of anything
# else is refused at the call rather than inside the body.
use std::iter::Iterator;
use std::option::Option;
use std::io::print;

struct Words { i: int }

impl Iterator for Words {
    type Item = String;
    fun next(self) -> Option<String> {
        self.i += 1;
        if self.i > 2 { return Option::None; }
        return Option::Some("w");
    }
}

fun sum_of<I: Iterator<Item = int>>(it: I) -> int {
    var t = 0;
    for v in it { t += v; }
    return t;
}

fun main() {
    print(sum_of(Words { i: 0 }));
}
