#! expect: is bound twice, to 'Int' and to 'String'
# Two bindings for one associated type are a contradiction rather than a
# refinement — the projection is one type, and the second spelling would
# silently win whichever way the list happened to be walked.
use std::iter::Iterator;
use std::option::Option;

fun f<J: Iterator<Item = Int> + Iterator<Item = String>>(j: J) -> Int {
    return 1;
}
