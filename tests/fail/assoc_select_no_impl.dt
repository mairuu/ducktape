#! expect: no implementation of 'from' for 'Steps' takes arguments (bool)
# Milestone 30 — when the argument matches none of the several `From` impls
# for a type, selection reports what it could not satisfy and lists what each
# candidate does take, rather than picking the first impl and blaming its
# parameter type.
use std::convert::From;

struct Steps { n: int }

impl From<int> for Steps {
    fun from(value: int) -> Steps { return Steps { n: value }; }
}
impl From<char> for Steps {
    fun from(value: char) -> Steps { return Steps { n: 0 }; }
}

fun main() {
    var b = Steps::from(true);
}
