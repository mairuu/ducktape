#! expect: type mismatch: expected 'Int' but got 'String'
# The tail is an exit like any break, so it joins with them — which is exactly
# what a `while` has not got and why only a `loop` and a block take a value.
fun main() {
    var _x = 'a: {
        if true { break 'a 1; }
        "not an Int"
    };
}
