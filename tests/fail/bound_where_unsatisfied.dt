#! expect: does not implement trait 'B'
trait A {
    fun a(self) -> Int;
}

trait B {
    fun b(self) -> Int;
}

struct Only {
    v: Int,
}

impl A for Only {
    fun a(self) -> Int {
        self.v
    }
}

# Only implements A but not B; a `where T: B` predicate must reject it.
fun needs_b<T>(t: T) -> Int where T: B {
    0
}

fun main() {
    var o = Only { v: 1 };
    var bad = needs_b(o);
}
