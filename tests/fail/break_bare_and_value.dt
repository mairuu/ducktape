#! expect: type mismatch: expected '()' but got 'Int'
# A bare `break` is not "no opinion" — it leaves with `()`, which is a type like
# any other, so it joins against a later value the same way two `if` arms do.
fun main() {
    var n = 0;
    var x = loop {
        n += 1;
        if n == 1 { break; }
        break 1;
    };
}
