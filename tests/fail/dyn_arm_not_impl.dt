#! expect: type mismatch: expected 'dyn Shape' but got 'Blob'
# An arm is checked against the expectation rather than against the other arm,
# so a branch that implements nothing is named on its own terms — where the
# arms unifying with each other would have reported 'Sq' vs 'Blob'.
trait Shape { fun name(self) -> String; }
struct Sq;
struct Blob;
impl Shape for Sq { fun name(self) -> String { return "sq"; } }

fun main() {
    var c = true;
    var a: dyn Shape = if c { Sq } else { Blob };
}
