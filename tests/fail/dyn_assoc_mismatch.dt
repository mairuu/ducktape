#! expect: it implements 'Iterator' with 'Item' = 'string'
# Implementing the trait is no longer the whole question at a coercion: the
# trait object states what the associated type *is*, so an impl that binds a
# different one satisfies the trait and still cannot be this type. Reported
# here rather than as a plain type mismatch, which could only say the two
# types differ and not that it is the binding that disagrees.

use std::io::print;

trait Iterator {
    type Item;
    fun next(self) -> Self.Item;
}

struct Words { w: string }

impl Iterator for Words {
    type Item = string;
    fun next(self) -> string { "{self.w}!" }
}

fun main() {
    var it: dyn Iterator<Item = int> = Words { w: "hi" };
}
