#! expect: trait 'Iterator' takes 0 type arguments but 1 was given
# The bracket list after a `dyn` holds the trait's type arguments and its
# associated-type bindings, which are two different questions sharing one pair
# of angle brackets. `Iterator` declares no type parameters, so a positional
# argument to it is an arity mistake — and `Item` still has to be bound by
# name, which dyn_assoc_missing.dt covers.

use std::io::print;

trait Iterator {
    type Item;
    fun next(self) -> Self.Item;
}

struct Counter { n: int }

impl Iterator for Counter {
    type Item = int;
    fun next(self) -> int { self.n + 1 }
}

fun main() {
    var it: dyn Iterator<int> = Counter { n: 1 };
}
