#! expect: cannot apply '+' to 'dyn Shape' and 'Tri': 'dyn Shape' does not implement 'Add<Tri>'
# A plain `=` into a `dyn` place coerces (milestone 82); a compound `+=` does
# not, and since milestone 83 it says why — the right operand feeds an operator
# on the place's own type, so the question asked is whether `dyn Shape` has an
# `Add`, not whether a `Tri` can become one.
use std::ops::Add;

trait Shape { fun name(self) -> String; }
struct Sq;
struct Tri;
impl Shape for Sq { fun name(self) -> String { return "sq"; } }
impl Shape for Tri { fun name(self) -> String { return "tri"; } }

fun main() {
    var x: dyn Shape = Sq;
    x += Tri;
}
