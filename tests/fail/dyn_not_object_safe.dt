#! expect: is not object-safe
# `-> Self` needs the caller to know the concrete type, which is exactly what
# the coercion to a trait object throws away. Checked where `dyn` is written,
# not at the trait: the trait itself is perfectly usable as a bound.

use std::io::print;

trait Pick {
    fun area(self) -> int;
    fun bigger(self, other: Self) -> Self;
}

struct Sq { s: int }

impl Pick for Sq {
    fun area(self) -> int { self.s * self.s }
    fun bigger(self, other: Sq) -> Sq { self }
}

fun use_it(x: dyn Pick) -> int {
    return x.area();
}

fun main() {
    print(use_it(Sq { s: 2 }));
}
