#! expect: type mismatch: expected 'Int' but got 'String'
# Unifying a `dyn`'s arguments is what makes them able to *disagree*: the
# first argument solves `T`, so the second is checked against it. The message
# names the one argument that differs, as it does for any other composite.
trait Src<T> { fun get(self) -> T; }

struct Five;
struct Word;
impl Src<Int> for Five { fun get(self) -> Int { return 5; } }
impl Src<String> for Word { fun get(self) -> String { return "w"; } }

fun both<T>(a: dyn Src<T>, b: dyn Src<T>) -> T { return b.get(); }

fun main() {
    var s: dyn Src<Int> = Five;
    var w: dyn Src<String> = Word;
    var x = both(s, w);
}
