#! expect: expected 'dyn Src<String>' but got 'dyn Twice<int>'
# The right supertrait at the wrong argument: `Twice<int>`'s super is
# `Src<int>`, so `dyn Src<String>` is not something it can become.
trait Src<T> { fun get(self) -> T; }
trait Twice<T>: Src<T> { fun again(self) -> T; }

struct Five;
impl Src<int> for Five { fun get(self) -> int { return 5; } }
impl Twice<int> for Five { fun again(self) -> int { return 10; } }

fun main() {
    var t: dyn Twice<int> = Five;
    var s: dyn Src<String> = t;
}
