#! expect: arithmetic operator requires numeric types, got 'T' and 'T'
# There is no operator overloading: `+` wants a concrete numeric type, so it
# cannot apply to a bare generic. The diagnostic names the parameter rather
# than silently poisoning (which is what the removed `// todo:` did).
fun sum<T>(a: T, b: T) -> T {
    return a + b;
}

fun main() {
    sum(1, 2);
}
