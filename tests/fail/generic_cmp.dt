#! expect: comparison requires numeric types, got 'T' and 'T'
# `<` stays a numeric opcode, so ordering a generic goes through `T: Ord` and
# `.cmp`, never the operator. Reported against the parameter, not swallowed.
fun less<T>(a: T, b: T) -> Bool {
    return a < b;
}

fun main() {
    less(1, 2);
}
