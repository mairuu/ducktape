#! expect: no method named 'tag' found for type 'Box<T>'
struct Box<T> {
    v: T,
}

impl Box<Int> {
    fun tag(self) -> Int {
        1
    }
}

impl<T> Box<T> {
    # `self` here is the generic Box<T>; `tag` only exists on Box<Int>, so this
    # must not resolve. Selecting an impl by method name is only allowed for a
    # bare path (`Box::tag`), never for a method-call receiver.
    fun leak(self) -> Int {
        self.tag()
    }
}

fun main() {
    var b = Box { v: true };
    var x = b.leak();
}
