#! expect: this program does not import 'std::fmt'
# `Display` is the one std name the compiler knows, and it only learns it when
# some module in the program loads `std::fmt`. Without that there is no trait
# to check against, so the diagnostic says which import is missing rather than
# claiming the type failed a bound that was never in play.
use std::io::print;

struct Point { x: Int, y: Int }

fun main() {
    var p = Point { x: 1, y: 2 };
    print("{p}");
}
