#! expect: conflicting implementations of trait 'into' for type 'S'
# What importing `std::convert` costs: the blanket `impl<T, U: From<T>> into<U>
# for T` applies to every self type, and coherence is deliberately blind to an
# impl's own bounds — so it overlaps any `into` impl a program could write.
#
# That is the rule working as designed rather than a wart of it: the free
# direction is free because there is exactly one implementation of it. A
# program writes `From` and gets `into`.

use std::io::print;
use std::convert::{From, into};

struct S { n: int }

impl into<int> for S {
    fun into(self) -> int {
        return self.n;
    }
}

fun main() {
    print(0);
}
