#! expect: no method named 'into' found for type 'Int'
# The limit of the blanket impl, and it is inherent rather than an oversight:
# `impl<T, U: From<T>> Into<U> for T` is chosen by neither the receiver nor a
# written trait reference, so `U` is pinned only by the type the result flows
# into. A `print` argument is not that — `print<T>` accepts anything — so there
# is nothing to pin it with and the impl does not apply.
#
# `var n: Int = 7.into();` is the same call with an answer.

use std::io::print;
use std::convert::{From, Into};

struct Meters { n: Int }

impl From<Int> for Meters {
    fun from(value: Int) -> Meters {
        return Meters { n: value };
    }
}

fun main() {
    print(7.into());
}
