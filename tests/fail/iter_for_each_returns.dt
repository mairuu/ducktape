#! expect: expected '()' but got 'int'
# `for_each` takes a `fun(Self.Item) -> Unit`, and there is no discard
# coercion: a shorthand closure *is* its expression, so `|x| x * 2` has type
# `fun(int) -> int` and does not fit. The escape hatch is the block form, where
# a trailing `;` is what drops the value — `|x| { x * 2; }` — which is the same
# rule every other block in the language follows rather than a special case
# bought for this method.
use std::iter::Iterator;
use std::option::Option;

struct Span { lo: int, hi: int }

impl Iterator for Span {
    type Item = int;
    fun next(self) -> Option<int> {
        if self.lo >= self.hi { return Option::None; }
        var v = self.lo;
        self.lo += 1;
        return Option::Some(v);
    }
}

fun main() {
    Span { lo: 0, hi: 3 }.for_each(|x| x * 2);
}
