#! expect: nothing labelled 'outer is in scope
# A closure is its own body: the enclosing loops are not its to leave, so their
# labels are out of scope inside it exactly as they are for a bare `break`.
fun call(f: fun() -> Int) -> Int { f() }

fun main() {
    'outer: for _i in 0..3 {
        call(|| { break 'outer; });
    }
}
