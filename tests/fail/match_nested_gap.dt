#! expect: match is not exhaustive
# the outer enum is fully covered; the gap is one level down, inside Some.
use std::io::print;

enum Opt<T> {
    Some(T),
    None,
}

fun pick(o: Opt<bool>) -> int {
    return match o {
        Opt::Some(true) => 1,
        Opt::None => 0,
    };
}

fun main() {
    print(pick(Opt::Some(false)));
}
