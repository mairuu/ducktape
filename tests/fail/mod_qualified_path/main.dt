#! expect: to qualify a path by module
# `use lib::Point;` imports the *item* Point — it does not bind `lib` as a
# module qualifier. So `lib::Point` names nothing: to qualify a path you bind
# the module itself with `use lib;`.
mod lib;

use lib::Point;

fun f(p: lib::Point) -> int {
  return p.x;
}

fun main() {}
