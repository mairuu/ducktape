#! expect: requires 'P: Ord'
# `sort` lives in an `impl<T: Ord> [T]` block, so an array whose element has no
# order simply does not have the method — and the diagnostic names the
# obligation rather than only the missing name, which is the difference between
# "no such method" and "you have not said how these compare".
#
# The comparator form is what such a program wants: `ps.sort_by(|a, b| ...)`
# needs no `Ord` at all.
use std::sort;

struct P { n: Int }

fun main() {
    var ps = [P { n: 2 }, P { n: 1 }];
    ps.sort();
}
