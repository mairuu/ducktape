#! expect: expected 'String' but got 'StringBuf'
# The two are distinct types on purpose, and this is the whole reason: a String
# is interned, so it is filed under the hash of its bytes and two equal strings
# are one pointer. A buffer whose bytes change cannot be that. `build` is the
# only way across.
use std::string::{builder, push_str};

fun main() {
    var b = builder();
    push_str(b, "hello");
    var s: String = b;
}
