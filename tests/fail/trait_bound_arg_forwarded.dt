#! expect: type 'S' does not implement trait 'into<String>'
# `U: into<T>` is checked with `T`'s own solution substituted in: the bound is
# opened alongside the parameter it mentions, so what reaches the check is
# `into<String>` and not the literal `into<T>`, which no impl heads and which
# would have made every such bound vacuous.

trait into<T> {
    fun into(self) -> T;
}

struct S { n: int }

impl into<int> for S {
    fun into(self) -> int { self.n }
}

fun conv<T, U: into<T>>(v: U) -> T {
    return v.into();
}

fun main() {
    var x: String = conv(S { n: 5 });
}
