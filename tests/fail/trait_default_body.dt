#! expect: type mismatch: expected 'int' but got 'String'
# default method bodies are checked once, against the abstract Self.
trait Named {
    fun name(self) -> String;

    fun id(self) -> int {
        return self.name();
    }
}

struct P {
    x: int,
}

impl Named for P {
    fun name(self) -> String {
        "p"
    }
}

fun main() {
    var p = P { x: 1 };
}
