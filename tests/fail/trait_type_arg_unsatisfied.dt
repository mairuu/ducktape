#! expect: does not implement trait 'into<string>'
# A trait's type arguments are part of what a bound asks for: implementing
# `into<int>` does not answer `T: into<string>`. Trait references are interned,
# so the bound check is the same pointer comparison it always was — the
# arguments come along for free.

trait into<T> {
    fun into(self) -> T;
}

struct S { n: int }

impl into<int> for S {
    fun into(self) -> int { self.n }
}

fun want<T: into<string>>(v: T) -> string {
    return v.into();
}

fun main() {
    var s = want(S { n: 1 });
}
