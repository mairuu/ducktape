#! expect: a bound on 'Self' belongs on the trait, not on a method
# `where Self: Ord` on a trait method is a supertrait, and since milestone 58
# supertraits exist — but they are a property of the *trait*, not of one method:
# every impl owes the super, and every bound on the trait may lean on it. So
# there is one spelling for it (`trait Sized2: Ord`), and this stays an error
# rather than becoming a second way to say the same thing. What a method's
# `where` can still constrain is what an impl binds an associated type to,
# which is a question each call site answers about its own receiver.
use std::cmp::Ord;
use std::option::Option;

trait Sized2 {
    type Item;
    fun first(self) -> Option<Self.Item> where Self: Ord;
}
