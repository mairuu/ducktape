#! expect: expected at least one type argument between '<' and '>'
# `::<>` names nothing. The bracket is consumed before the complaint is filed:
# leaving the `>` behind handed it back to the expression grammar as an
# operator, and the error that eventually arrived was about a token several
# further on. One spelling of the mistake, one diagnostic, on the brackets that
# are the mistake.
struct H {
    n: int,
}

impl H {
    fun width(self) -> int {
        return self.n;
    }
}

fun main() {
    var h = H { n: 1 };
    var x = h.width::<>();
}
