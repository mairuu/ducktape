#! expect: a type parameter default is only allowed on a trait
# A default is read where the declaration is *named* with arguments after it is
# declared, and only a trait is. A function's or a struct's type parameters are
# solved from the values, so a default there would be a second answer to a
# question inference already has.
fun pick<T = int>(v: T) -> T { return v; }

fun main() {
    var x = pick(1);
}
