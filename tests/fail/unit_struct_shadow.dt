#! expect: expected struct type in struct pattern, got 'int'
# the consequence of a bare unit struct name being a constructor in patterns:
# the name can no longer be bound as a variable, since `Marker` here is a
# pattern that tests for the struct rather than a fresh binding.

use std::io::print;

struct Marker;

fun main() {
  var Marker = 7;
  print(Marker);
}
