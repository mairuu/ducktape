# a generic function has no body of its own — it is compiled once per
# instantiation, and those copies are compiled after every module has been
# walked. The diagnostic must still come from *this* file, the one the body
# was written in, not from the module that instantiated it.
pub trait Show {
  fun show(self) -> Int;
  fun twice(self) -> Int { return self.show() + self.show(); }
}

pub fun show_twice<T: Show>(v: T) -> Int {
  # an inherited default body has no FunDef to instantiate — the last
  # construct the VM still refuses.
  return v.twice();
}
