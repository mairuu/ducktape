#! expect: string slice is out of bounds
# a native reports a runtime error by setting ctx->error; the VM turns it into
# an error at the call site.
#
# This is the one of `slice`'s three checks still reachable from safe source
# after milestone 102. Both positions are this string's own, so both are in
# bounds and both are boundaries — what a `StrPos` cannot carry is the *order*
# they are used in.
use std::io::print;
use std::text;

fun main() {
  var s = "ab";
  print(s.slice(s.end(), s.start()));
}
