#! expect: string is not valid UTF-8
# A width spec pads to a *character* count, so it has no answer for bytes that
# are not characters — `slice` cuts in bytes and this one halved a two-byte
# sequence.
#
# The check is the `pad_*` lang items' own (`string_char_count`, milestone 61)
# rather than the `chars` walk's: they cannot reach the walk, since `std::cmp`
# imports `std::string` and the reverse edge would be a cycle. So padding still
# validates the whole string eagerly, where a walk fails only on reaching the
# bad bytes.
use std::io::print;

fun main() {
    var bad = "é".slice(0, 1);
    print("{bad:>4}");
}
