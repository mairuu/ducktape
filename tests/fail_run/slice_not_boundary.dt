#! expect: string slice does not cut at a character boundary
# The cut that used to make a malformed string and let it travel (milestone
# 101). `é` is two bytes, so a cut at 1 is inside it.
#
# Since milestone 102 no safe source reaches this: a `StrPos` cannot be built
# from an `int`, and every position a string mints is one of its own boundaries.
# So the guard is tested the only way left — by binding the raw native, which is
# the escape hatch `@native` has always been rather than a hole in the type.
use std::io::print;

@native("string_slice")
fun raw_slice(s: string, from: int, to: int) -> string;

fun main() {
    print(raw_slice("é", 0, 1));
}
