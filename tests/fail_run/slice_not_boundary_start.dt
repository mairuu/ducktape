#! expect: string slice does not cut at a character boundary
# The other end. Both offsets are checked, and `len` is a boundary like any
# other — so this range is in bounds and still refused. Reached through the raw
# native for the reason its sibling explains.
use std::io::print;

@native("string_slice")
fun raw_slice(s: string, from: int, to: int) -> string;

fun main() {
    print(raw_slice("é", 1, 2));
}
