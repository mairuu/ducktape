# Which ways of naming a binding count as *reading* it. Only a plain `=` into a
# bare name does not, so everything here is silent — and stderr being empty is
# the point: this is what stops the store rule from widening.
use std::io::print;

struct Point { x: int, y: int }

fun ignores(seed: int) -> int {
    seed = 99;
    return seed;
}

fun main() {
    # a compound assignment consults the old value, so its target is read
    var counted = 0;
    counted += 1;
    counted <<= 1;

    # a field or an element store needs the object in hand first
    var p = Point { x: 1, y: 2 };
    p.x = 9;
    var xs = [1, 2];
    xs[0] = 9;

    # a store followed by a read is the ordinary case
    var live = 1;
    live = 2;

    # the underscore hatch covers a binding whose whole life is the store, which
    # with no `drop` in the language is how a reference is released
    var _dropped = 1;
    _dropped = 2;

    print("{counted}{p.x}{xs[0]}{live}{ignores(1)}");
}
