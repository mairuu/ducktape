# associated types in impls, resolved via Self.Name and Type.Name
struct Point {
    x: int,
    y: int,
}

trait Drawable {
    type Color;
    fun draw(self);
}

impl Drawable for Point {
    type Color = String;

    fun draw(self) {}

    fun color_of(self) -> Self.Color {
        "red"
    }
}

fun main() {
    var p = Point { x: 1, y: 2 };
    p.draw();
    var _c: Point.Color = p.color_of();
}
