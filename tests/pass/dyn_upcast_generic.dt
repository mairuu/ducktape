# The upcast restates the supertrait in the source's type arguments: a
# `dyn Twice<int>` is a `dyn Src<int>`, and the closure entry is what says so.
trait Src<T> { fun get(self) -> T; }
trait Twice<T>: Src<T> { fun again(self) -> T; }

struct Five;
impl Src<int> for Five { fun get(self) -> int { return 5; } }
impl Twice<int> for Five { fun again(self) -> int { return 10; } }

fun take(s: dyn Src<int>) -> int { return s.get(); }

fun main() {
    var t: dyn Twice<int> = Five;
    var s: dyn Src<int> = t;
    take(t);
    take(s);
}
