# the full-language showcase from .vscode/ref/in.dt, adapted to current syntax:
#   fun(x) => ...   ->  |x| ...      (pipe closures)
#   fun f(): T      ->  fun f() -> T
#   for w < 10      ->  while w < 10
#   inline trait bounds (T: Drawable) are enforced at instantiation
use std::io::print;
use std::string as strings;    # aliased: the type `string` owns the bare name
use std::fmt::Display;
use std::convert::From;
use std::iter::DoubleEnded;   # `Iterator` is preluded; a supertrait of it is not
use std::text;                # cutting and counting text, since milestone 102

enum Result<T, E> {
    Ok(T),
    Err(E),
}

enum Status {
    Active,
    Inactive,
}

pub struct Point<T> {
    x: T,
    y: T,
}

struct Wrapper<T>(T, int)

trait Drawable {
    type Color;

    fun draw(self) -> Self.Color;

    fun is_visible(self) -> bool {
        return true;
    }
}

impl<T> Drawable for Point<T> {
    type Color = string;

    fun draw(self) -> Self.Color {
        "Blue"
    }
}

impl Point<int> {
    fun new(x: int, y: int) -> Self {
        return Point { x: x, y: y };
    }
}

# a type deciding how it renders: `"{p}"` on anything but a primitive is
# checked against `Display` and compiled as the call `p.to_string()`.
impl Display for Point<int> {
    fun to_string(self) -> string {
        return "({self.x}, {self.y})";
    }
}

# `Drawable` mentions `Self.Color`, which a trait object can keep by naming it:
# `dyn Drawable<Color = string>` below. `Weigh` mentions no associated type at
# all, so it needs no bindings — the two spellings are the same rule, since the
# binding list is one entry per associated type the trait declares.
trait Weigh {
    fun weight(self) -> int;

    fun heavy(self) -> bool {
        return self.weight() > 10;
    }
}

struct Brick { kg: int }
struct Feather { grams: int }

impl Weigh for Brick {
    fun weight(self) -> int { self.kg }
}

impl Weigh for Feather {
    fun weight(self) -> int { 1 }
    fun heavy(self) -> bool { false }
}

# one collection, several concrete types — what static dispatch cannot express
pub fun total_weight(items: [dyn Weigh]) -> int {
    var sum = 0;
    for item in items {
        if item.heavy() {
            sum += item.weight();
        }
    }
    return sum;
}

# and the coercion asked backwards: `as?` recovers one concrete type from a
# trait object, `Option<T>` because it may not be that one. The test is vtable
# identity — a table is memoised per (trait reference, concrete type) — so it
# needs no runtime type tag, and it can only name a type that implements the
# trait, since otherwise there would be no table to recognise.
pub fun bricks_only(items: [dyn Weigh]) -> int {
    var kg = 0;
    for item in items {
        match item as? Brick {
            Option::Some(b) => { kg += b.kg; },
            Option::None => {},
        }
    }
    return kg;
}

# a subtrait's object is usable as its supertrait's, implicitly and with no
# `Option`: the declaration below is the proof, so there is nothing to test at
# runtime. It is still a table swap rather than a re-reading, because the two
# tables are laid out over two different closures.
trait Crated: Weigh {
    fun crates(self) -> int;
}

impl Crated for Brick {
    fun crates(self) -> int { 1 }
}

pub fun crated_weight(c: dyn Crated) -> int {
    var one: dyn Weigh = c;
    return one.weight() * c.crates();
}

# every branch of an `if` or a `match` is a coercion site of its own, so the
# arms need not agree on a concrete type — and a body's tail expression is one
# too, which is the `return` below written without the keyword.
pub fun heavier(kg: int) -> dyn Weigh {
    if kg > 10 { Brick { kg: kg } } else { Feather { grams: kg } }
}

pub fun by_name(which: int) -> dyn Weigh {
    match which {
        0 => Feather { grams: 1 },
        _ => Brick { kg: 3 },
    }
}

# `a op= b` is `a = a op b`, so the operator is the one the operands' types
# decide: an opcode for two numbers, `a.add(b)` for a type with an impl. The
# place is compiled once either way, so `bricks[pick()]` picks once.
pub fun stacked(bricks: [Brick], pick: fun() -> int) -> int {
    var total = 0;
    total += bricks[pick()].kg;
    total %= 100;
    return total;
}

# a trait may take type parameters of its own. They are supplied wherever the
# trait is *named* — this impl head, the bound on `packed` below, a `dyn` — and
# a trait reference is what carries them, so the signatures a trait declares
# are generic over them exactly as a function's are over its own.
trait Pack<T> {
    fun pack(self, item: T) -> int;

    fun pack_two(self, a: T, b: T) -> int {
        return self.pack(a) + self.pack(b);
    }
}

impl Pack<int> for Brick {
    fun pack(self, item: int) -> int { self.kg + item }
}

# `Brick` implements the trait twice, at two different arguments: the
# reference is what tells them apart, so coherence lets both stand.
impl Pack<string> for Brick {
    fun pack(self, _item: string) -> int { self.kg }
}

pub fun packed<P: Pack<int>>(packer: P) -> int {
    return packer.pack_two(1, 2);
}

# a trait may declare an *associated function* — no `self`, so there is no
# receiver to say which impl runs. A path qualified by the type parameter says
# it instead, and which body that means waits for `M` to be concrete, exactly
# as a method call on a bounded receiver does.
trait Mark {
    fun blank() -> Self;
    fun weight(self) -> int;
}

impl Mark for Brick {
    fun blank() -> Brick { return Brick { kg: 0 }; }
    fun weight(self) -> int { return self.kg; }
}

pub fun blank_weight<M: Mark>() -> int {
    var m: M = M::blank();
    return m.weight();
}

# `float::from(7)` — a builtin type qualifies a path like a declared one, which
# is what makes the conversions `std::convert` ships for the primitives
# reachable by name as well as through `into`.
pub fun widened(n: int) -> float {
    return float::from(n);
}

# two `From` impls for one type: the qualified call reads its *argument* to pick
# between them (milestone 30), where the single-impl `float::from` above has
# nothing to choose. Neither the self type nor a written reference tells them
# apart — only `5` vs `true` does.
struct Tick { at: int }
impl From<int> for Tick { fun from(v: int) -> Tick { return Tick { at: v }; } }
impl From<bool> for Tick { fun from(_v: bool) -> Tick { return Tick { at: 0 }; } }

pub fun ticks() -> int {
    var a = Tick::from(5);    # the int impl
    var b = Tick::from(true); # the bool impl, chosen by the argument
    return a.at + b.at;
}

# the receiver-side dual (milestone 31): `Brick` implements `Pack` twice, and a
# bare `brick.pack(..)` cannot say which — the receiver is `Brick` either way.
# The trait reference qualifying the call is what tells them apart, the same
# `(self type, trait reference)` pair `impl Pack<int> for Brick` is filed under.
pub fun packs() -> int {
    var brick = Brick { kg: 10 };
    var by_int = Pack::<int>::pack(brick, 5);      # the int impl: 10 + 5
    var by_str = Pack::<string>::pack(brick, "x"); # the string impl: 10
    return by_int + by_str;
}

# a bounded generic: the argument type must implement Drawable, and the bound
# is also what makes `item.draw()` (and the projection `T.Color`) resolve
pub fun render<T: Drawable>(item: T) -> T.Color {
    return item.draw();
}

# the same method reached dynamically instead. The receiver's type is gone, so
# `Self.Color` has nowhere to come from — unless the trait object says, which
# is what makes a trait with an associated type object-safe at all.
pub fun render_dyn(item: dyn Drawable<Color = string>) -> string {
    return item.draw();
}

pub fun process_data<T>(_data: T) -> Result<int, string> {
    var p = Point::new(10, 20);
    var _shown: string = render(p);
    # `is_visible` has a default body the impl omits — inherited from the trait
    var _visible: bool = p.is_visible();
    var _packed_kg: int = packed(Brick { kg: 5 });
    # a `var` binding is an irrefutable pattern: tuples, named-field structs,
    # tuple structs, nesting and `_` all bind the same way a match arm does
    var (a, b) = (1, 2.5);
    var Point { x: px, y: _ } = p;
    var Wrapper(_inner, tag) = Wrapper(true, 7);
    var (_nested, (_deep, _)) = (a, (px, tag));
    var _unit_val: () = ();
    # a char is a primitive like int or bool: a literal, an annotation, an
    # equality, and interpolation with no `Display` impl in sight
    var initial: char = 'd';
    var _newline = '\n';
    var snowman = '\u{2603}';
    var _greeting = "{initial}{snowman} is a {initial == 'd'}";

    var count = 0;
    count += 1;
    count -= 1;
    count *= 2;
    count /= 1;
    count %= 7;
    count &= 255;
    count |= 1;
    count ^= 3;
    count <<= 2;
    count >>= 1;
    count >>>= 1;

    var logic = true and false or not false;
    var _cmp = (5 >= 4) == (3 != 2) and (1 < 2) and (3 <= 3);
    var _math = -5 + 10 - 2 * 3 / 1 % 2;
    var _bits = ~(1 << 4) & 255 | 3 ^ 9;
    var _signed_shift = -16 >> 2;
    var _unsigned_shift = -16 >>> 2;

    var _r1 = 1..10;
    var _r2 = 0..=100;

    var inline_adder: fun(int, int) -> int = |x, y| x + y;
    var closure_res = inline_adder(1, 2);

    # closure capturing an enclosing local (upvalue)
    var captured_base = 10;
    var add_base: fun(int) -> int = |x| x + captured_base;
    var _captured_res = add_base(closure_res);

    var _drawn = p.draw();
    var _casted = 10 as float;

    var _if_val = if logic {
        1
    } else {
        var fallback = 0;
        fallback
    };

    var w = 0;
    while w < 10 {
        w += 1;
        if w == 5 { continue; }
        if w == 9 { break; }
    }

    for i in 1..=5 {
        var _s = "Iter: {i}";
    }

    var spins = 0;
    loop {
        spins += 1;
        if spins == 3 { break; }
    }

    # a `loop`'s value is the join of its breaks
    var _spun = loop {
        spins += 1;
        if spins > 5 { break spins * 2; }
    };

    # a label lets a `break`/`continue` name a loop other than the innermost
    var _pair = 'hunt: loop {
        'rows: for a in 0..4 {
            for b in 0..4 {
                if a + b == 5 { break 'hunt a * 10 + b; }
                if b == 2 { continue 'rows; }
            }
        }
        break -1;
    };

    # a label on a block makes it a `break` target too — its type is the join of
    # the breaks and the tail, the exit a `loop` has not got
    var _graded = 'grade: {
        if spins < 0 { break 'grade "impossible"; }
        if spins > 100 { break 'grade "huge"; }
        "ordinary"
    };

    var xs = [1, 2, 3];
    var _first = xs[0];

    var _match_res = match p {
        Point { x: 10, y: val } if val > 0 => true,
        _ => false,
    };

    var _tuple_match = match (a, b) {
        (1, 2.5) => "exact",
        (_val_a, _val_b) => "bound",
    };

    var seed: Result<int, string> = Result::Ok(5);
    var _enum_match = match seed {
        Result::Ok(v) => v,
        Result::Err(_) => 0,
    };

    # a conditional binding: one pattern, and the branch where it fails
    var _one_arm = if var Result::Ok(v) = seed { v } else { 0 };
    if var Point { x: 10, y: py } = p {
        var _only_here = py;
    } else if var (1, second) = (a, b) {
        var _also_bound = second;
    }
    var pump = Countdown::from(3);
    while var Option::Some(v) = pump.next() {
        var _per_turn = v;
    }

    # the same refutability with the branches the other way round: the `else`
    # leaves, so the name below it is an ordinary local rather than one nested
    # inside an `if var`
    var Result::Ok(unwrapped) = seed else { return Result::Err("no seed"); };
    var _after_else = unwrapped + 1;

    var _helper = || -> Result<int, string> {
        var val = process_data(10)?;
        return Result::Ok(val);
    };

    Result::Ok(count)
}

# `Iterator` (milestone 46): `for x in it` over a user type drives its `next()`
# until `None`. The cursor is a private field that advances in place (milestones
# 43/44); `Iterator`, `Option`, and the loop's unwrap are all lang items the
# program never spells — and all preluded, so none is imported.
pub struct Countdown { n: int, stop: int }

impl Countdown {
    fun from(n: int) -> Countdown { Countdown { n: n, stop: 0 } }
}

impl Iterator for Countdown {
    type Item = int;
    fun next(self) -> Option<int> {
        if self.n <= self.stop { return Option::None; }
        var cur = self.n;
        self.n -= 1;
        return Option::Some(cur);
    }
}

# a **supertrait** (milestone 58): `DoubleEnded: Iterator` says every
# implementing type already implements `Iterator`, which is what lets
# `next_back` return an `Option<Self.Item>` at all — `Item` belongs to the
# super, and only a supertrait makes it `Self`'s as well. The obligation runs
# the other way too: this impl is legal only because the `impl Iterator for
# Countdown` above exists. Unlike `Iterator` it is not a lang item, so it is
# imported by name.
impl DoubleEnded for Countdown {
    fun next_back(self) -> Option<int> {
        if self.n <= self.stop { return Option::None; }
        self.stop += 1;
        return Option::Some(self.stop);
    }
}

# a projection handed to a generic (milestone 50). `I.Item` is abstract while
# the checker looks at this body — the bound is all it needs — but `unwrap<T>`
# is instantiated on it, and an instantiation is keyed by a *real* type. Codegen
# collapses the projection through the impl once `I` is bound, so this compiles
# for any iterator rather than only where the element type is written out.
fun head<I: Iterator>(it: I) -> I.Item {
    return it.next().unwrap();
}

# a bound on an *associated* type (milestone 52). A plain bound constrains the
# parameter; only a `where` can constrain what an impl binds its associated type
# to — which is what makes an element comparable, so a reduce like this one can
# be written at all. It is discharged where `I` is bound to a real type.
fun largest<I: Iterator>(it: I) -> Option<I.Item> where I.Item: Ord {
    var best = it.next();
    while true {
        match it.next() {
            Option::Some(v) => {
                match best {
                    Option::Some(b) => { if v > b { best = Option::Some(v); } },
                    Option::None => { best = Option::Some(v); },
                }
            },
            Option::None => { return best; },
        }
    }
    return best;
}

fun main() {
    var _r = process_data(1);
    # coercion at a call site, mixing two concrete types in one array
    var _w = total_weight([Brick { kg: 20 }, Feather { grams: 1 }, Brick { kg: 3 }]);
    # the same coercion into a trait object that names its associated type
    var _c = render_dyn(Point::new(3, 4));
    # native methods (milestone 40): an @intrinsic method lowered to an opcode,
    # an @native method called into C — the receiver at the self position
    var n = [1, 2, 3].len();
    var s = "showcase".take_chars(4);
    # a module-qualified path names a still-free item without importing it:
    # `join` and `concat` stay free functions because their receiver is a
    # `[string]`, not a string, so they keep the qualified spelling
    var _sl = strings::concat([s, "!"]);
    # a Display impl reached by interpolation, beside a primitive segment
    var _shown = "{Point::new(1, 2)} #{n}";
    # an associated function through a bound, and the conversion the blanket
    # `impl<T, U: From<T>> into<U> for T` supplies — pinned by the annotation,
    # since a conversion is the one call its receiver cannot decide
    var _blank = blank_weight::<Brick>();
    var wide: float = 7.into();
    # a format spec (milestone 35): a width aligns a Display value, a precision
    # fixes a float's decimals — both desugar to std::string::pad_* / fmt::float
    var _padded = "{Point::new(1, 2):>12} {wide:.2}";
    # a user Iterator driven by `for`: next() advances a private cursor to None
    var acc = 0;
    for k in Countdown::from(3) {
        acc += k;
    }
    # combinators (milestone 48): `map`/`filter`/`collect` are provided methods
    # on `Iterator`, so the pipeline reads left to right — `map`/`filter` lazy
    # adapters, `collect` draining into an array. The closures are typed by the
    # source's `Item`.
    var _evens = Countdown::from(6).map(|k| k * 2).filter(|v| v > 4).collect();
    # more combinators (milestone 49): `take`/`enumerate`/`zip` are lazy adapters,
    # `fold` an eager consumer. The `filter(..).fold(..)` here also leans on the
    # projection fix that shipped with them — a closure over a pass-through
    # adapter's element now sees the real element type.
    var _total = Countdown::from(10).filter(|k| k % 2 == 0).take(3).fold(0, |a, k| a + k);
    var _paired = Countdown::from(3).enumerate().collect();
    var _zipped = Countdown::from(4).zip(Countdown::from(2)).collect();
    # and the element type reached through a bound (milestone 50): the base is a
    # `Filter`, so `I.Item` is a projection over a projection, collapsed at the
    # instantiation rather than left abstract
    var _biggest = head(Countdown::from(9).filter(|k| k % 3 == 0));
    # `flat_map`/`skip` (milestone 51). `flat_map` maps each element to a whole
    # iterator and yields those end to end — its adapter's `Item` is `J.Item`,
    # a projection over a type *parameter*, which is what milestone 50 unblocked
    var _flat = Countdown::from(3).flat_map(|k| Countdown::from(k)).skip(1).collect();
    # the associated-type bound discharged: `Countdown.Item` is `int`, which is
    # `Ord`, so `largest`'s `where` is satisfied at this call
    var _peak = largest(Countdown::from(4).filter(|k| k % 2 == 0));
    # the same bound on a trait *method's* signature (milestone 53), which is
    # what lets the reduce above be a combinator instead of a free function.
    # Discharged at the call, against this receiver rather than at an
    # instantiation — `Self` is decided by whoever calls
    var _peak2 = Countdown::from(4).filter(|k| k % 2 == 0).max();
    var _trough = Countdown::from(4).min();
    # an *equality* binding (milestone 54): `chain`'s `J: Iterator<Item =
    # Self.Item>` says the second source's element type *is* this one's, which
    # is a statement about which type a projection is rather than which traits
    # it satisfies — and the only kind of predicate that lets the two sequences
    # be yielded from one `next`
    var _joined = Countdown::from(2).chain(Countdown::from(3)).collect();
    # `rev` (milestone 58) is a method on the *supertrait* `DoubleEnded`, and
    # `map` a method on `Iterator` — one receiver reaches both, because a bound
    # offers its whole supertrait closure. `Map` forwards `DoubleEnded`, so the
    # pipeline stays reversible across it
    var _backwards = Countdown::from(4).rev().collect();
    var _mapped_back = Countdown::from(3).map(|k| k * 10).rev().collect();
    # the short-circuiting consumers and the two `*_while` adapters
    # (milestone 59) — breadth over `next()`, no language feature behind them.
    # Each stops where its answer is, so the cursor is left mid-sequence and
    # the same source can be driven on
    var _seen = Countdown::from(5).any(|k| k == 3);
    var _every = Countdown::from(5).all(|k| k > 0);
    var _hit = Countdown::from(5).find(|k| k % 2 == 0);
    var _at = Countdown::from(5).position(|k| k % 2 == 0);
    var _how_many = Countdown::from(5).filter(|k| k % 2 == 1).count();
    Countdown::from(2).for_each(|k| print(k));
    var _while_big = Countdown::from(6).take_while(|k| k > 3).collect();
    var _after_big = Countdown::from(6).skip_while(|k| k > 3).collect();
    # iterator *sources* (milestone 60): every pipeline above starts from a
    # `Countdown` this file had to write, because an array and a range reach
    # `for` by a desugaring rather than by the trait. `iter()` is the seed that
    # puts all of the above within reach of the two sequence types a program
    # already has — and `range` is a nameable type now, the way `string` is
    var numbers = [1, 2, 3, 4];
    var _doubled = numbers.iter().map(|k| k * 2).collect();
    var _counted = (0..10).iter().filter(|k| k % 3 == 0).count();
    var _last_two = numbers.iter().rev().take(2).collect();
    var _descending = (1..=4).iter().rev().collect();
    var _spanned = span_len(2..7);
}

# a range as a parameter rather than only a loop header
fun span_len(r: range) -> int {
    return r.iter().count();
}
