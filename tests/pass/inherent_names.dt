# Milestone 68: what inherent coherence must *not* reject. The rule is one
# inherent name per type, and each block below is a way for a name to repeat
# without two bodies ever competing for one receiver.
# nothing here is called; the declarations *are* the test.
#! flags: -Wno-unused_item
use std::cmp::Ord;

struct P {
  x: int,
}

# Splitting a type's methods across blocks: ordinary, and how std ships string.
impl P {
  fun width(self) -> int {
    return self.x;
  }
}

impl P {
  fun height(self) -> int {
    return self.x + 1;
  }
}

# Two traits may both declare `go` for one type: a bound or a trait-qualified
# path says which body was meant, so neither is unreachable.
trait Rolls {
  fun go(self) -> int;
}

trait Flies {
  fun go(self) -> int;
}

impl Rolls for P {
  fun go(self) -> int {
    return 1;
  }
}

impl Flies for P {
  fun go(self) -> int {
    return 2;
  }
}

# An inherent name may coincide with a trait-declared one for the same reason —
# `a < b` gates on Ord before it rewrites, so this `cmp` cannot silently qualify.
struct Q {
  v: int,
}

impl Q {
  fun cmp(self, n: int) -> int {
    return self.v - n;
  }
}

impl Ord for Q {
  fun cmp(self, other: Q) -> int {
    return self.v - other.v;
  }
}

# Disjoint heads: no receiver is accepted by both, so the name repeats freely.
struct W<T> {
  v: T,
}

impl W<int> {
  fun tag(self) -> int {
    return 1;
  }
}

impl W<string> {
  fun tag(self) -> int {
    return 2;
  }
}

fun main() {}
