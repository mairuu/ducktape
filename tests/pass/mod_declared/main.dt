# A path means what the declarations say, not what the filesystem holds. Both
# of these used to change meaning when an unrelated file appeared beside them:
# `use a::b;` became module `a::b` the moment `a/b.dt` existed, and
# `use Event::A;` stopped naming this file's own enum the moment `Event.dt`
# did. Both files exist here, and neither is declared, so neither is anything.
# `a/b.dt` sits in a directory `a` owns, so keeping it undeclared on purpose is
# exactly what the allow is for; `Event.dt` is beside a root, which owns nothing.
@allow("orphan_module")
mod a;

use a::b;
use Event::A;

pub enum Event { A, B }

# nothing calls it: this file has no `main`, the resolution above is the test.
@allow("unused_item")
fun pick() -> int {
  var e = A;
  return match e {
    Event::A => b(),
    Event::B => 0,
  };
}
