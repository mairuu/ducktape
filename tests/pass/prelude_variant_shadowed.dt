# A module's own `Some` beats the prelude's, silently — the prelude is the
# lowest-priority binding and yields to anything the file writes.
fun Some(n: int) -> int { return n + 1; }

enum Mine { Ok, Nope }
use Mine::Ok;

fun main() {
  var _a = Some(1);
  match Ok {
    Ok => { },
    Mine::Nope => { },
  }
}
