# calls through trait bounds: a bounded type parameter can call the methods its
# bounds declare, `T.Assoc` names an associated type through a bound, default
# method bodies are checked once against the abstract `Self`, and an impl that
# omits a defaulted method still inherits it.
trait Shape {
    type Unit;

    fun area(self) -> Self.Unit;
    fun name(self) -> string;

    # default bodies are checked against the abstract Self: `self.area()`
    # dispatches through the trait's own signatures.
    fun doubled(self) -> Self.Unit {
        return self.area();
    }

    fun describe(self) -> string {
        var n = self.name();
        return "shape {n}";
    }
}

struct Circle {
    r: int,
}

impl Shape for Circle {
    type Unit = int;

    fun area(self) -> Self.Unit {
        self.r * self.r * 3
    }

    fun name(self) -> string {
        "circle"
    }
}

struct Boxed<T> {
    v: T,
}

impl<T> Shape for Boxed<T> {
    type Unit = T;

    fun area(self) -> Self.Unit {
        self.v
    }

    fun name(self) -> string {
        "boxed"
    }
}

# the callee is the bound's signature, not any impl's method
fun label<T: Shape>(s: T) -> string {
    s.name()
}

# ... and `T.Unit` is the projection that signature returns
fun measure<T: Shape>(s: T) -> T.Unit {
    s.area()
}

fun main() {
    var c = Circle { r: 2 };
    var _l: string = label(c);
    var _a: int = measure(c);

    # `doubled` and `describe` are inherited: neither impl overrides them.
    var _d: int = c.doubled();
    var _t: string = c.describe();

    # through a generic impl, `Self.Unit` is the impl's own type param
    var b = Boxed { v: 7 };
    var _e: int = b.doubled();
}
