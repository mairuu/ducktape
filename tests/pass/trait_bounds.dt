# trait bounds on generic params: inline `<T: A + B>`, `where T: C`, and
# multiple bounds are resolved and enforced at instantiation. A concrete type
# passed to a bounded generic must implement every bound.
struct Point {
    x: int,
}

trait A {
    fun a(self) -> int;
}

trait B {
    fun b(self) -> int;
}

impl A for Point {
    fun a(self) -> int {
        self.x
    }
}

impl B for Point {
    fun b(self) -> int {
        self.x
    }
}

fun need_a<T: A>(_t: T) -> int {
    0
}

fun need_both<T: A + B>(_t: T) -> int {
    0
}

fun need_where<T>(_t: T) -> int where T: B {
    0
}

fun main() {
    var p = Point { x: 5 };
    var _r1 = need_a(p);
    var _r2 = need_both(p);
    var _r3 = need_where(p);
}
