# trait item signatures + impl conformance: an impl must supply every
# associated type and every required method with a matching signature; methods
# with a default body may be omitted.
struct Circle {
    radius: int,
}

trait Shape {
    type Unit;

    fun area(self) -> int;
    fun scaled(self, factor: int) -> Self.Unit;

    # default method — impls may omit it
    fun describe(self) -> bool {
        return true;
    }
}

impl Shape for Circle {
    type Unit = int;

    fun area(self) -> int {
        self.radius * self.radius * 3
    }

    fun scaled(self, factor: int) -> Self.Unit {
        self.radius * factor
    }
}

fun main() {
    var c = Circle { radius: 2 };
    var _a = c.area();
}
