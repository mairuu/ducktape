# The parser grows its lists rather than capping them.
#
# Two fixed-size buffers were lifted for milestone 72, both reached by ordinary
# code rather than by anything contrived:
#
# - **an impl's items were capped at 16**, in a stack array. `std::map`'s
#   `HashMap` hit it by gaining a third capacity method, which is the whole
#   story: 16 methods is not a lot for a container type. It is a diagnostic
#   ("too many items in impl"), so it was an abort on a valid program rather
#   than anything unsafe.
# - **a module's declarations were capped at 1024**, in a stack array guarded by
#   an `assert`. An assert is not a guard: the release build defines NDEBUG, so
#   the check vanished and a 1025th declaration wrote past the end of the array.
#   A release-built compiler took SIGSEGV on this file; the debug build aborted
#   on the assertion. Both are now a grown buffer and neither has a limit.
#
# The impl below has 20 items, and the file has well over 1024 declarations —
# packed several to a line, since the parser counts declarations and not lines.
struct Wide;

impl Wide {
    fun m0(self) -> Int { return 0; }
    fun m1(self) -> Int { return 1; }
    fun m2(self) -> Int { return 2; }
    fun m3(self) -> Int { return 3; }
    fun m4(self) -> Int { return 4; }
    fun m5(self) -> Int { return 5; }
    fun m6(self) -> Int { return 6; }
    fun m7(self) -> Int { return 7; }
    fun m8(self) -> Int { return 8; }
    fun m9(self) -> Int { return 9; }
    fun m10(self) -> Int { return 10; }
    fun m11(self) -> Int { return 11; }
    fun m12(self) -> Int { return 12; }
    fun m13(self) -> Int { return 13; }
    fun m14(self) -> Int { return 14; }
    fun m15(self) -> Int { return 15; }
    fun m16(self) -> Int { return 16; }
    fun m17(self) -> Int { return 17; }
    fun m18(self) -> Int { return 18; }
    fun m19(self) -> Int { return 19; }
}

