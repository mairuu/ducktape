# basic arithmetic, casts, comparisons
#> 7
#> 1
#> 12
#> 2
#> 1
#> 2.5
#> 3
#> true
#> false
#> ()
fun main() {
    print(3 + 4);
    print(3 - 2);
    print(3 * 4);
    print(5 / 2);
    print(5 % 2);
    print(5 / 2.0);
    print(2.5 as Int + 1);
    print(3 > 2 and not (1 == 2));
    print(1.5 < 1.0 or false);
    print(());
}
