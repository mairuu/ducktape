# heap arrays: literals, indexing, index assignment, for-in, structural ==
#> [1, 2, 3]
#> 2
#> [1, 20, 3]
#> [1, 25, 3]
#> 29
#> 0
#> true
#> false
#> [[1, 2], [3, 4]]
#> 3
#> 3
#> 9
fun main() {
    var arr = [1, 2, 3];
    print(arr);
    print(arr[1]);
    arr[1] = 20;
    print(arr);
    arr[1] += 5;
    print(arr);

    var total = 0;
    for x in arr {
        total += x;
    }
    print(total);

    var empty: [Int] = [];
    var seen = 0;
    for x in empty {
        seen += 1;
    }
    print(seen);

    var a = [1, 2, 3, 4, 5];
    var b = [1, 2, 3, 4, 5];
    print(a == b);
    b[0] = 9;
    print(a == b);

    var nested = [[1, 2], [3, 4]];
    print(nested);
    print(nested[1][0]);

    var stop_at = 0;
    for x in a {
        if x == 3 { break; }
        stop_at += x;
    }
    print(stop_at);

    var odd_sum = 0;
    for x in a {
        if x % 2 == 0 { continue; }
        odd_sum += x;
    }
    print(odd_sum);
}
