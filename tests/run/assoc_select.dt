# Milestone 30 — selection by argument type. A qualified associated call
# `Steps::from(v)` now reads its argument to choose among several `From` impls
# for one produced type. Before this, the first registered impl won and every
# other argument was a type error against it (milestone 29's one remaining gap).
# The mechanism is not `From`-specific: any generic trait implemented more than
# once for one type, called through the `Type::method(args)` spelling, is
# disambiguated by what its arguments are.

#> 26
#> 97
#> 3
#> 1
#> 42
#> 7.0

use std::io::print;
use std::convert::From;

struct Steps { n: int }

# two `From` impls for one type, differing only in the source they consume —
# and the qualified path `Steps::from` names neither.
impl From<int> for Steps {
    fun from(value: int) -> Steps { return Steps { n: value }; }
}
impl From<char> for Steps {
    fun from(value: char) -> Steps { return Steps { n: int::from(value) }; }
}

trait Make<T> { fun make(value: T) -> Self; }

struct Tally { total: int }
impl Make<int> for Tally {
    fun make(value: int) -> Tally { return Tally { total: value }; }
}
impl Make<bool> for Tally {
    fun make(flag: bool) -> Tally {
        if flag { return Tally { total: 1 }; }
        return Tally { total: 0 };
    }
}

# a struct-typed argument, so disambiguation runs through `impl_type_match` on a
# composite rather than a primitive.
struct Amount { cents: int }
impl Make<Amount> for Tally {
    fun make(value: Amount) -> Tally { return Tally { total: value.cents }; }
}

fun main() {
    print(Steps::from(26).n);   # int  -> 26
    print(Steps::from('a').n);  # char -> 97 (the scalar value of 'a')

    print(Tally::make(3).total);                    # int    -> 3
    print(Tally::make(true).total);                 # bool   -> 1
    print(Tally::make(Amount { cents: 42 }).total); # Amount -> 42

    # a type with a single `From` impl still resolves the old way, untouched.
    var f: float = float::from(7);
    print(f); # 7.0
}
