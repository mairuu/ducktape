# A loop's `break`/`continue` unwinds to a *stack* position, not to a count of
# locals: reaching one with a callee or an operand pushed since the loop began
# means those are live and no one's local. Counting locals left them behind, so
# the loop's value was the leaked temporary.
#> 20
#> 20
#> 7
use std::io::print;

fun id(n: Int) -> Int { n }

# the break is reached with `id`'s callee already pushed, waiting for its
# argument — the loop's value must be the break's, not that callee
fun break_past_a_callee() -> Int {
    loop { id({ var b = 1; break b + 19; }) }
}

# the same for a plain `break` out of a `while`, where the leak would instead
# leave the stack one deep every turn
fun break_past_an_operand() -> Int {
    var n = 0;
    while n < 100 {
        n += id({ var b = 5; if b == 5 { break; } 0 });
    }
    return n + 20;
}

# `continue` unwinds the same way, and runs many times rather than once, so a
# leak here grows the stack until the frame runs out
fun continue_past_a_callee() -> Int {
    var n = 0;
    var turns = 0;
    while turns < 7 {
        turns += 1;
        n += id({ var b = 1; if b == 1 { continue; } 100 });
    }
    return turns;
}

fun main() {
    print(break_past_a_callee());
    print(break_past_an_operand());
    print(continue_past_a_callee());
}
