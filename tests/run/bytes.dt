# Bytes: a packed byte buffer, and the checked door back to `string`.
# Pins that the door is one-way-checked — every string encodes, only valid
# UTF-8 decodes — and that equality is structural rather than by identity.
use std::io::print;

fun main() {
    var b = Bytes::new();
    print(b.is_empty());
#> true

    b.push(104);
    b.push(105);
    print(b.len());
#> 2
    print(b.get(0));
#> 104
    print(b);
#> Bytes[104, 105]
    print(b.is_utf8());
#> true

    b.set(0, 72);
    print(string::from_utf8(b));
#> Some(Hi)

    # a reference to one growable object, like a `[T]`: both names see the push
    var alias = b;
    alias.push(33);
    print(b.len());
#> 3

    # equal bytes are equal buffers — not interned, so this is a comparison
    var other = Bytes::new();
    other.push(72);
    other.push(105);
    other.push(33);
    print(b == other);
#> true

    b.clear();
    print(b.len());
#> 0
    print(b == other);
#> false

    # every string encodes; the byte count is not the character count
    var s = "héllo";
    var enc = s.to_utf8();
    print(enc.len());
#> 6
    print(string::from_utf8(enc));
#> Some(héllo)

    # a lone continuation byte is not an encoding of anything
    var bad = Bytes::new();
    bad.push(255);
    # read back above 127: an octet is an int in 0..255, never a signed char
    print(bad.get(0));
#> 255
    print(bad.is_utf8());
#> false
    var decoded = string::from_utf8(bad);
    print(decoded.is_none());
#> true

    # the empty buffer decodes to the empty string, allocation or no
    var empty = Bytes::new();
    print(string::from_utf8(empty));
#> Some()
}
