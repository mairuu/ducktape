# A `Char` is a Unicode scalar value, and a `String` is bytes. The two are
# different things, so the crossing between them is a conversion (`chars` /
# `from_chars`) and never an index — which is what this file is mostly about.
#> x
#> é
#> 😀
#> 	.
#> '
#> "
#> \
#> x é 😀 !
#> true
#> false
#> matched x
#> other
#> 65
#> 128512
#> ☃
#> true
#> 17
#> 15
#> [h, é, l, l, o, ,,  , w, ö, r, l, d,  , 4, 2]
#> true
#> HéLLO, WöRLD 42
#> héllo, wörld 42
#> true true true true
#> false false false
#> 7
#> -1
#> 1
#> 0
#> a
#> Z
#> Z:a
#> abc
#> Tag { c: Z, n: 1 }
#> q
#> a
#> 1
#> s

use std::io::print;
use std::string::from_chars;
use std::strbuf;
use std::char;
use std::cmp::{max, min};
use std::array;
use std::fmt::Display;

struct Tag { c: Char, n: Int }

fun id<T>(v: T) -> T {
    return v;
}

fun shout(s: String) -> String {
    var b = StringBuf::new();
    for c in s.chars() {
        b.push_char(c.to_upper());
    }
    return b.build();
}

fun quiet(s: String) -> String {
    var b = StringBuf::new();
    for c in s.chars() {
        b.push_char(c.to_lower());
    }
    return b.build();
}

fun main() {
    # literals: ASCII, a multi-byte character written directly, and the escape
    # for one that cannot be typed
    print('x');
    print('é');
    print('\u{1F600}');
    print("{'\t'}.");
    print('\'');
    print('"');
    print('\\');

    # a Char is a primitive, so interpolation renders it with no `Display` impl
    # in sight — the same built-in path an Int takes
    var emoji = '\u{1F600}';
    print("{'x'} {'é'} {emoji} !");

    # equality is on the scalar value, so it works for a multi-byte character
    # exactly as it does for an ASCII one
    print('é' == '\u{E9}');
    print('a' == 'A');

    match 'x' {
        'q' => print("q"),
        'x' => print("matched x"),
        _ => print("other"),
    }
    # a Char column is never exhaustive without a wildcard, like an Int
    match '?' {
        'q' => print("q"),
        _ => print("other"),
    }

    print('A'.code());
    print('😀'.code());
    print(Char::from_code(9731));
    print(Char::from_code('é'.code()) == 'é');

    # the whole point: `len` counts bytes and `chars` counts characters, and
    # for anything but ASCII those are different numbers
    var s = "héllo, wörld 42";
    print(s.len());
    print(s.chars().len());
    print(s.chars());
    print(from_chars(s.chars()) == s);

    print(shout(s));
    print(quiet(shout(s)));

    print("{'7'.is_digit()} {'x'.is_alpha()} {'7'.is_alnum()} {'\n'.is_whitespace()}");
    # the classifications are ASCII-only, and say so
    print("{'é'.is_alpha()} {'é'.is_ascii()} {'É'.is_upper()}");
    print('7'.to_digit());

    # `impl Ord for Char` is code-point order: 'Z' (90) sorts before 'a' (97)
    print('a'.cmp('b'));
    print('b'.cmp('a'));
    print('a'.cmp('a'));
    print(max('a', 'Z'));
    print(min('a', 'Z'));
    print("{min('a', 'Z')}:{max('a', 'Z')}");

    # a buffer takes Chars and Strings alike, which is what `from_chars` is
    var b = StringBuf::new();
    b.push_char('a');
    b.push_char('b');
    b.push_char('c');
    print(b.build());

    # a Char is a primitive everywhere a primitive goes: a struct field, a
    # type argument keying an instantiation, and a `dyn Display` element
    print(Tag { c: 'Z', n: 1 });
    print(id('q'));
    var mixed: [dyn Display] = ['a', 1, "s"];
    for m in mixed {
        print(m.to_string());
    }
}
