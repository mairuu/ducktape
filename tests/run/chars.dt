# A `Char` is a Unicode scalar value, and a `String` is bytes. The two are
# different things, so the crossing between them is a conversion (`chars` /
# `from_chars`) and never an index — which is what this file is mostly about.
#> x
#> é
#> 😀
#> 	.
#> '
#> "
#> \
#> x é 😀 !
#> true
#> false
#> matched x
#> other
#> 65
#> 128512
#> ☃
#> true
#> 17
#> 15
#> [h, é, l, l, o, ,,  , w, ö, r, l, d,  , 4, 2]
#> true
#> HéLLO, WöRLD 42
#> héllo, wörld 42
#> true true true true
#> false false false
#> 7
#> -1
#> 1
#> 0
#> a
#> Z
#> Z:a
#> abc
#> Tag { c: Z, n: 1 }
#> q
#> a
#> 1
#> s

use std::io::print;
use std::string::{chars, from_chars, len, builder, push_char, build};
use std::char::{code, from_code, is_ascii, is_digit, is_alpha, is_alnum};
use std::char::{is_lower, is_upper, is_whitespace, to_upper, to_lower, to_digit};
use std::cmp::{max, min};
use std::array::len as alen;
use std::fmt::Display;

struct Tag { c: Char, n: Int }

fun id<T>(v: T) -> T {
    return v;
}

fun shout(s: String) -> String {
    var b = builder();
    for c in chars(s) {
        push_char(b, to_upper(c));
    }
    return build(b);
}

fun quiet(s: String) -> String {
    var b = builder();
    for c in chars(s) {
        push_char(b, to_lower(c));
    }
    return build(b);
}

fun main() {
    # literals: ASCII, a multi-byte character written directly, and the escape
    # for one that cannot be typed
    print('x');
    print('é');
    print('\u{1F600}');
    print("{'\t'}.");
    print('\'');
    print('"');
    print('\\');

    # a Char is a primitive, so interpolation renders it with no `Display` impl
    # in sight — the same built-in path an Int takes
    var emoji = '\u{1F600}';
    print("{'x'} {'é'} {emoji} !");

    # equality is on the scalar value, so it works for a multi-byte character
    # exactly as it does for an ASCII one
    print('é' == '\u{E9}');
    print('a' == 'A');

    match 'x' {
        'q' => print("q"),
        'x' => print("matched x"),
        _ => print("other"),
    }
    # a Char column is never exhaustive without a wildcard, like an Int
    match '?' {
        'q' => print("q"),
        _ => print("other"),
    }

    print(code('A'));
    print(code('😀'));
    print(from_code(9731));
    print(from_code(code('é')) == 'é');

    # the whole point: `len` counts bytes and `chars` counts characters, and
    # for anything but ASCII those are different numbers
    var s = "héllo, wörld 42";
    print(len(s));
    print(alen(chars(s)));
    print(chars(s));
    print(from_chars(chars(s)) == s);

    print(shout(s));
    print(quiet(shout(s)));

    print("{is_digit('7')} {is_alpha('x')} {is_alnum('7')} {is_whitespace('\n')}");
    # the classifications are ASCII-only, and say so
    print("{is_alpha('é')} {is_ascii('é')} {is_upper('É')}");
    print(to_digit('7'));

    # `impl Ord for Char` is code-point order: 'Z' (90) sorts before 'a' (97)
    print('a'.cmp('b'));
    print('b'.cmp('a'));
    print('a'.cmp('a'));
    print(max('a', 'Z'));
    print(min('a', 'Z'));
    print("{min('a', 'Z')}:{max('a', 'Z')}");

    # a buffer takes Chars and Strings alike, which is what `from_chars` is
    var b = builder();
    push_char(b, 'a');
    push_char(b, 'b');
    push_char(b, 'c');
    print(build(b));

    # a Char is a primitive everywhere a primitive goes: a struct field, a
    # type argument keying an instantiation, and a `dyn Display` element
    print(Tag { c: 'Z', n: 1 });
    print(id('q'));
    var mixed: [dyn Display] = ['a', 1, "s"];
    for m in mixed {
        print(m.to_string());
    }
}
