# Ord for `[T]` and `(A, B)`: the two containers with no module of their own get
# their ordering beside the trait, the way `std::fmt` ships their `Display`.
# Arrays compare lexicographically, tuples field by field, and both reach the
# element's own `Ord` through the bound — so an array of tuples of strings has a
# total order without a line of it written per program.
#> -1
#> 1
#> -1
#> 1
#> 0
#> true
#> true
#> true
#> true
#> -1
#> 1
#> 0
#> true
#> [1, 3]
#> [1, 2]
#> (1, 3)
#> [2]
#> -1
#> -1
#> 1

use std::io::print;
use std::cmp::{max, min, clamp};

fun main() {
    # arrays: lexicographic, first differing element decides
    print([1, 2, 3].cmp([1, 2, 4]));   # a differing element
    print([1, 2, 4].cmp([1, 2, 3]));
    print([1, 2].cmp([1, 2, 3]));      # a prefix sorts before what extends it
    print([1, 2, 3].cmp([1, 2]));
    print([1, 2, 3].cmp([1, 2, 3]));   # equal

    # the inherited defaults come for free on the container impl
    print([1, 2].lt([1, 3]));
    print([1, 3].gt([1, 2]));
    print([1, 2].le([1, 2]));
    print([1, 2].ge([1, 2]));

    # tuples: field by field, .0 before .1
    print((1, 2).cmp((1, 3)));
    print((2, 1).cmp((1, 9)));         # the first field settles it
    print((1, 2).cmp((1, 2)));
    print((1, 2).lt((2, 1)));

    # std::cmp's own generics, now instantiated at a container type
    print(max([1, 2], [1, 3]));
    print(min([1, 2], [1, 3]));
    print(max((1, 2), (1, 3)));
    print(clamp([2], [1], [3]));

    # nesting: the element's own container impl is reached through the bound
    print([(1, 9), (1, 2)].cmp([(1, 9), (1, 3)]));
    print([[1, 2], [3]].cmp([[1, 2], [4]]));

    # String elements, so the array impl reaches impl Ord for String
    print(["apple", "pear"].cmp(["apple", "peach"]));
}
