# std::convert (milestone 29): `From` and `Into` are one relation written from
# two ends. A program writes `From` impls and gets `Into` through the blanket,
# which needs an associated function dispatched through a bound (`U::from`) and
# an impl parameter pinned by the expected type rather than by the receiver.

#> 212
#> 212
#> 7.0
#> 65
#> 12.0
#> 100.0
#> 26
#> 97

use std::io::print;
use std::convert::{From, Into};

struct Celsius { deg: Int }
struct Fahrenheit { deg: Int }

impl From<Celsius> for Fahrenheit {
    fun from(value: Celsius) -> Fahrenheit {
        return Fahrenheit { deg: value.deg * 9 / 5 + 32 };
    }
}

# `T: Into<Float>` writes the trait reference down, so `v.into()` inside needs
# no annotation: the bound is what names the impl.
fun scaled<T: Into<Float>>(v: T) -> Float {
    var f: Float = v.into();
    return f * 2.0;
}

# a bound naming an earlier parameter of the same list, which is the shape a
# conversion trait exists for: `U` converts into whatever `T` turns out to be.
fun convert<T, U: Into<T>>(v: U) -> T {
    return v.into();
}

# a type reachable from two sources: which `From` impl the blanket uses is
# decided by the receiver, since `U: From<T>` is asked with `T` already pinned.
struct Steps { n: Int }

impl From<Int> for Steps {
    fun from(value: Int) -> Steps { return Steps { n: value }; }
}

impl From<Char> for Steps {
    fun from(value: Char) -> Steps { return Steps { n: Int::from(value) }; }
}

fun main() {
    # the `from` spelling: the type produced qualifies the path, so nothing
    # else has to say which conversion is meant.
    var f = Fahrenheit::from(Celsius { deg: 100 });
    print(f.deg);

    # the `into` spelling, through the blanket impl. Neither the receiver
    # (`Celsius`) nor a written trait reference decides which impl applies —
    # the annotation does, and the impl's own `U: From<T>` bound confirms it.
    var back: Fahrenheit = Celsius { deg: 100 }.into();
    print(back.deg);

    # a builtin type may qualify a path like any other.
    var i: Float = Float::from(7);
    print(i);

    var n: Int = 'A'.into();
    print(n);

    print(scaled(6));

    var t: Float = convert(100);
    print(t);

    var a: Steps = 26.into();
    print(a.n);
    var b: Steps = 'a'.into();
    print(b.n);
}
