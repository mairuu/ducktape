# The inverse of what this file used to assert. Object safety is partitioned
# per method (milestone 48): a provided method that isn't dispatchable is
# excluded from the vtable rather than sinking the trait. Until milestone 56
# that exclusion also meant the method could not be *called* on a trait object,
# because the vtable was the only way in.
#
# It is not. An excluded method is a generic function over `Self`, so codegen
# instantiates its body at `Self = dyn Iterator<Item = Int>` exactly as it
# would at any other receiver, and the `self.next()` inside it dispatches
# through the table on its own. So the object-safe subset governs the vtable,
# not the bound — and `map` runs here.
#
# Keeping the old rejection would have made `d.map(f)` an error while
# `doubled(d)` below compiled the very same body.
#> [0, 2, 4]
#> [0, 2, 4]
use std::iter::Iterator;
use std::option::Option;
use std::io::print;

struct Counter { n: Int, max: Int }

impl Iterator for Counter {
    type Item = Int;
    fun next(self) -> Option<Int> {
        if self.n >= self.max { return Option::None; }
        var v = self.n;
        self.n += 1;
        return Option::Some(v);
    }
}

fun doubled<I: Iterator<Item = Int>>(it: I) -> [Int] {
    return it.map(|x| => x * 2).collect();
}

fun main() {
    var d: dyn Iterator<Item = Int> = Counter { n: 0, max: 3 };
    print(d.map(|x| => x * 2).collect());

    var e: dyn Iterator<Item = Int> = Counter { n: 0, max: 3 };
    print(doubled(e));
}
