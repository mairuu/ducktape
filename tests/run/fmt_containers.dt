# std::fmt — the containers.
#
# An impl for `[T]`, `(A, B)`, `Option<T>` and `Result<T, E>` needs nothing new
# from the compiler: each is an ordinary generic impl whose elements go through
# `Display` in turn. What milestone 19 supplied was permission to *ship* them —
# an impl is no longer program-global, so claiming the rendering of `[T]` only
# affects a module that imports the trait — and what milestone 20 supplied is
# the check that makes them safe: an impl's own `T: Display` is enforced where
# the impl is *selected*, so a `[Widget]` fails at the interpolation rather
# than inside std's source.
#
# The nesting cases are the interesting ones: the element's impl for `[[int]]`
# is this same impl one level down, which is what the recursive bound check has
# to terminate on.
#> [1, 2, 3]
#> []
#> [a, b]
#> [(1, 2), (3, 4)]
#> [[1, 2], [3]]
#> (1, hi)
#> ([1], (2, 3))
#> Some((5, 6))
#> None
#> Ok(7)
#> Err(nope)
#> pts = [Some((5, 6))]
#> pair = (1, hi)
#> [1, 2]
#> [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
use std::io::print;
use std::fmt::{Display, to_string};
use std::option::Option;
use std::result::Result;

# A user type with a rendering of its own — the whole point of routing a
# container's elements through `Display` rather than the runtime's structural
# walk is that this is what shows up inside the brackets.
struct Point { x: int, y: int }

impl Display for Point {
  fun to_string(self) -> string {
    return "({self.x}, {self.y})";
  }
}

# Rendering a container from behind a bound: the impl is selected at the
# instantiation, exactly as for any other `T: Display`.
fun describe<T: Display>(label: string, value: T) {
  print("{label} = {value}");
}

fun main() {
  # primitives, which take the built-in path element by element
  var nums = [1, 2, 3];
  print("{nums}");

  var empty: [int] = [];
  print("{empty}");

  # a string element renders bare — `Display` is "render for a reader", and
  # quoting is a debugging affordance `print` keeps for itself
  var words = ["a", "b"];
  print("{words}");

  # a user type inside a container uses *its* to_string
  var pts = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
  print("{pts}");

  # nesting: the element's own impl is this same impl, one level down
  var grid = [[1, 2], [3]];
  print("{grid}");

  # tuples, and a tuple whose elements are themselves containers
  var pair = (1, "hi");
  print("{pair}");

  var nested = ([1], (2, 3));
  print("{nested}");

  # Option and Result, whose impls live beside their own definitions rather
  # than in std::fmt — an impl belongs with the type it is for
  var some = Option::Some(Point { x: 5, y: 6 });
  print("{some}");

  var none: Option<int> = Option::None;
  print("{none}");

  var ok: Result<int, string> = Result::Ok(7);
  print("{ok}");

  var err: Result<int, string> = Result::Err("nope");
  print("{err}");

  # through a bound, at a container of a container of a user type
  describe("pts", [some]);
  describe("pair", pair);

  # the trait as a function, on a container
  print(to_string([1, 2]));

  # `print` still renders structurally, and disagrees with `Display` exactly
  # where a type has an opinion: Point's impl says "(1, 2)", the walk says
  # "Point { x: 1, y: 2 }"
  print(pts);
}
