# A `{v:>8}` format spec (milestone 35) is pure front-end sugar: the checker
# desugars it into the `std::string::pad_*` and `std::fmt::float` calls it would
# otherwise nest in the braces, so nothing downstream of the checker changes. The
# value is rendered to a string first — through `float` for a precision, through
# the ordinary segment path otherwise — and then padded, which is why a spec is
# only ever shorthand and never a new runtime. The imports below are what the
# desugaring needs *present in the program*; a user need not name them, and here
# they are only to make the modules reachable.
#> [    42]
#> [42    ]
#> [  42   ]
#> [    hi]
#> [---x---]
#> [--ab---]
#> [3.14]
#> [      3.14]
#> [café  ]
#> a   |1  |
#> bb  |22 |
#> ccc |333|

use std::io::print;

fun main() {
    # the three alignments, brackets making the padding visible
    print("[{42:>6}]");
    print("[{42:<6}]");
    print("[{42:^7}]");

    # a string value pads the same way a number does
    print("[{"hi":>6}]");

    # a fill character, written as a char literal so it tokenises unambiguously;
    # an odd remainder puts the extra fill on the right, as `pad_center` does
    print("[{"x":'-'^7}]");
    print("[{"ab":'-'^7}]");

    # a precision renders a float to fixed decimals; alone it is just `float`
    print("[{3.14159:.2}]");
    # a width and a precision fuse (`>10.2`): render to 2 places, then pad to 10
    print("[{3.14159:>10.2}]");

    # width is a character count, not a byte count: "café" is five bytes but
    # four characters, so padding to six adds two spaces
    print("[{"café":<6}]");

    # the loop the feature is for: two columns laid out without nesting a call
    var rows = ["a", "bb", "ccc"];
    var vals = ["1", "22", "333"];
    var i = 0;
    for r in rows {
        print("{r:<4}|{vals[i]:<3}|");
        i = i + 1;
    }
}
