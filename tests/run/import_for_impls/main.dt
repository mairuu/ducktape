# An import that binds a name nothing writes and is still load-bearing: `ext`
# is never spelled as a qualifier, but it is the only module that can put
# `impl int` in reach, and `n.doubled()` spends it. The unused-import warning
# has to stay silent here — hence a `tests/run` file, which demands empty
# stderr — and it does because the question it asks is not "was a name
# written" but "would removing this line lose an impl that was selected".
#
# Delete the `use` and the program stops compiling: that is the negative
# control this file exists to make cheap.
mod ext;

use std::io::print;
use ext;

fun main() {
    var n = 21;
    print("{n.doubled()}");
#> 42
}
