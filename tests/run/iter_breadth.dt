# Iterator breadth (milestone 59): the six short-circuiting consumers and the
# two `*_while` adapters. All eight are ordinary `.dt` code over `next()` — the
# design questions were spent by milestones 47–58, and this one adds no
# language feature at all.
#
# What the file pins is *where each stops*. Short-circuiting is not an
# optimisation here but part of the meaning: the cursor is left where the answer
# was found, so a caller may keep driving the same source — which is what
# `Noisy` below observes, by printing each element as it is pulled.
use std::iter::Iterator;
use std::option::Option;
use std::io::print;

struct Span { lo: Int, hi: Int }

impl Span {
    fun of(lo: Int, hi: Int) -> Span { Span { lo: lo, hi: hi } }
}

impl Iterator for Span {
    type Item = Int;
    fun next(self) -> Option<Int> {
        if self.lo >= self.hi { return Option::None; }
        var v = self.lo;
        self.lo += 1;
        return Option::Some(v);
    }
}

# a source that says what it has been asked for, so "stopped early" is an
# output diff rather than a claim
struct Noisy { n: Int, max: Int }

impl Iterator for Noisy {
    type Item = Int;
    fun next(self) -> Option<Int> {
        if self.n >= self.max { return Option::None; }
        var v = self.n;
        self.n += 1;
        print("pulled {v}");
        return Option::Some(v);
    }
}

fun main() {
    # ── the predicates ──────────────────────────────────────────────────────
    print(Span::of(0, 5).any(|x| => x > 3));
#> true
    print(Span::of(0, 5).any(|x| => x > 9));
#> false
    print(Span::of(0, 5).all(|x| => x < 5));
#> true
    print(Span::of(0, 5).all(|x| => x < 3));
#> false

    # an empty sequence: `any` has nothing that passes, `all` nothing that
    # fails — the only pair of answers that keeps them mirrors
    print(Span::of(0, 0).any(|x| => true));
#> false
    print(Span::of(0, 0).all(|x| => false));
#> true

    # ── the searches ────────────────────────────────────────────────────────
    print(Span::of(10, 20).find(|x| => x % 7 == 0));
#> Some(14)
    print(Span::of(10, 20).find(|x| => x > 99));
#> None
    print(Span::of(10, 20).position(|x| => x % 7 == 0));
#> Some(4)
    print(Span::of(10, 20).position(|x| => x > 99));
#> None

    print(Span::of(0, 6).count());
#> 6
    print(Span::of(0, 0).count());
#> 0

    Span::of(1, 4).for_each(|x| => print(x * 100));
#> 100
#> 200
#> 300

    # ── where each one stops ────────────────────────────────────────────────
    #
    # `any` pulls until something passes and no further; the cursor is left
    # right there, so the same source answers again from where it stopped.
    var src = Noisy { n: 0, max: 6 };
    print(src.any(|x| => x == 2));
#> pulled 0
#> pulled 1
#> pulled 2
#> true
    print(src.next());
#> pulled 3
#> Some(3)

    # `all` stops at the first failure, in the same way
    var src2 = Noisy { n: 0, max: 6 };
    print(src2.all(|x| => x < 1));
#> pulled 0
#> pulled 1
#> false

    # ── the two adapters ────────────────────────────────────────────────────
    #
    # `take_while` is spent at the first failure and stays spent — a later
    # element the predicate would accept is *not* yielded, which is the whole
    # difference from `filter`
    print(Span::of(0, 8).take_while(|x| => x < 3).collect());
#> [0, 1, 2]
    print(Span::of(0, 8).map(|x| => x % 4).take_while(|x| => x < 3).collect());
#> [0, 1, 2]
    print(Span::of(0, 8).filter(|x| => x % 4 < 3).collect());
#> [0, 1, 2, 4, 5, 6]

    # `skip_while` yields the element that ended the skipping — dropping it
    # would silently eat one element of every sequence
    print(Span::of(0, 6).skip_while(|x| => x < 3).collect());
#> [3, 4, 5]
    print(Span::of(0, 6).skip_while(|x| => true).collect());
#> []
    print(Span::of(0, 6).skip_while(|x| => false).collect());
#> [0, 1, 2, 3, 4, 5]

    # and once it has stopped skipping it stays stopped
    print(Span::of(0, 8).map(|x| => x % 4).skip_while(|x| => x < 2).collect());
#> [2, 3, 0, 1, 2, 3]

    # ── lazily, in a pipeline ───────────────────────────────────────────────
    print(Span::of(0, 100).take_while(|x| => x * x < 50).count());
#> 8
    print(Span::of(0, 20).skip_while(|x| => x < 5).take_while(|x| => x < 9).collect());
#> [5, 6, 7, 8]
    Span::of(0, 10).filter(|x| => x % 2 == 0).for_each(|x| => print(x));
#> 0
#> 2
#> 4
#> 6
#> 8

    # ── through a trait object ──────────────────────────────────────────────
    #
    # All six consumers sit in the `dyn Iterator` vtable: none returns a
    # `Self`-shaped type, has a type parameter of its own, or bounds the
    # element. `find`'s `Option<Self.Item>` is a projection the object pins,
    # exactly as `collect`'s `[Self.Item]` is.
    var d: dyn Iterator<Item = Int> = Span::of(0, 6);
    print(d.any(|x| => x == 2));
#> true
    # the cursor was left at 3, so the same object answers from there
    print(d.count());
#> 3

    var e: dyn Iterator<Item = Int> = Span::of(0, 6);
    print(e.position(|x| => x > 3));
#> Some(4)

    # `take_while` and `skip_while` are *excluded* from that vtable — they
    # return `TakeWhile<Self>` — and are still callable, because an excluded
    # provided method is a generic function over `Self` that monomorphises at
    # `Self = dyn Iterator` instead of dispatching (milestone 56)
    var f: dyn Iterator<Item = Int> = Span::of(0, 8);
    print(f.take_while(|x| => x < 3).collect());
#> [0, 1, 2]
    var g: dyn Iterator<Item = Int> = Span::of(0, 6);
    print(g.skip_while(|x| => x < 3).collect());
#> [3, 4, 5]
}
