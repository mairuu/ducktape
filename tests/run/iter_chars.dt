# `s.chars()` is a walk, not a conversion (milestone 61): the third `std::iter`
# source, after an array's and a range's. What it holds is two *byte* offsets
# into an immutable string — so unlike `ArrayIter` it can snapshot its end, and
# unlike either of the others it has to decode to move.
#> 10
#> 4
#> [a, é, ☃, 😀]
#> 😀☃éa
#> a
#> é
#> ☃
#> 😀
#> [a, é]
#> [😀]
#> Some(a)
#> Some(😀)
#> Some(é)
#> Some(☃)
#> None
#> None
#> None
#> None
#> HELLOWRLD
#> 3
#> [(7, w), (8, ö)]
#> 3
#> 2
use std::io::print;
use std::string::from_chars;

fun main() {
    # every UTF-8 width in one string: 1, 2, 3 and 4 bytes. Walking it forwards
    # steps by the width the character's own value implies, and backwards by
    # the boundary the encoding's tag marks — the widths are what tell the two
    # apart from a byte count.
    var s = "aé☃😀";
    print(s.len());
    print(s.chars().count());
    print(s.chars().collect());
    print(from_chars(s.chars().rev().collect()));

    for c in s.chars() {
        print(c);
    }

    # lazy like every other adapter: `take` decodes two characters and stops,
    # `skip` decodes past three without building anything
    print(s.chars().take(2).collect());
    print(s.chars().skip(3).collect());

    # one iterator driven from both ends until they meet
    var it = s.chars();
    print(it.next());
    print(it.next_back());
    print(it.next());
    print(it.next_back());
    print(it.next());
    print(it.next_back());

    # empty from either end, and an empty string is the same walk with nothing
    # in it rather than a case of its own
    var e = "".chars();
    print(e.next());
    print(e.next_back());

    # the combinators are the ones every other source gets; none of this is
    # about text. `is_alpha` is ASCII-only and says so, which is why `ö` is
    # missing from the shout and why the reverse walk stops at three.
    var t = "hello, wörld";
    print(from_chars(t.chars().filter(|c| c.is_alpha()).map(|c| c.to_upper()).collect()));
    print(t.chars().filter(|c| c == 'l').count());
    print(t.chars().enumerate().skip(7).take(2).collect());
    print(t.chars().rev().take_while(|c| c.is_alpha()).count());

    # a slice is still a byte range, and one that lands on boundaries is the
    # only kind there is now (milestone 101), so a walk over one is a walk like
    # any other. What used to stand here was half a character and a walk that
    # answered only by stopping short of it.
    var head = s.slice(0, 3);
    print(head.chars().count());
}
