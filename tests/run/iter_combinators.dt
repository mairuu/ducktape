# Iterator combinators as methods (milestone 48): `it.map(f).filter(p).collect()`
# reads left to right, each a provided method on the `Iterator` trait. `map` and
# `filter` are lazy adapters, `collect` drains into an array, and a chain pulls
# one element at a time. Also the `for`-through-a-bound cases (milestone 47) — a
# generic `I: Iterator` and a `dyn Iterator` — and the new one milestone 48 adds:
# `collect` is dispatchable, so a `dyn Iterator` can `.collect()` (while `.map`
# and `.filter` are excluded from the vtable — see iter_dyn_combinator_fail).
use std::iter::Iterator;
use std::option::Option;
use std::io::print;

# a private advancing cursor, yielding 0, 1, ... max-1
struct Counter { n: int, max: int }

impl Counter {
    fun to(max: int) -> Counter { Counter { n: 0, max: max } }
}

impl Iterator for Counter {
    type Item = int;
    fun next(self) -> Option<int> {
        if self.n >= self.max { return Option::None; }
        var v = self.n;
        self.n += 1;
        return Option::Some(v);
    }
}

# `for x in it` over a bounded generic drives it through the Iterator bound —
# the receiver is only known abstractly here, so codegen makes it concrete and
# re-selects `next` (the same move a bounded method call makes).
fun count<I: Iterator>(it: I) -> int {
    var n = 0;
    for _x in it {
        n += 1;
    }
    return n;
}

fun main() {
    # map + collect
    print(Counter::to(5).map(|x| x * 10).collect());
#> [0, 10, 20, 30, 40]

    # filter + collect
    print(Counter::to(8).filter(|v| v % 2 == 0).collect());
#> [0, 2, 4, 6]

    # a full pipeline reads left to right: square, keep > 3, drain — nothing
    # intermediate allocates
    print(Counter::to(6).map(|x| x * x).filter(|v| v > 3).collect());
#> [4, 9, 16, 25]

    # a lazy adapter is itself an iterator, so `for` drives it directly
    for y in Counter::to(3).map(|x| x + 100) {
        print(y);
    }
#> 100
#> 101
#> 102

    # break/continue work through a filtered adapter
    for w in Counter::to(20).filter(|v| v % 3 == 0) {
        if w == 0 { continue; }
        if w > 9 { break; }
        print(w);
    }
#> 3
#> 6
#> 9

    # `for` over a bounded generic (Part 1)
    print(count(Counter::to(4)));
#> 4

    # `for` over a `dyn Iterator` — the trait object carries its own vtable
    var d: dyn Iterator<Item = int> = Counter::to(5);
    var total = 0;
    for x in d {
        total += x;
    }
    print(total);
#> 10

    # `collect` is dispatchable (returns `[Self.Item]`, which the trait object
    # names), so it survives object safety and a `dyn Iterator` keeps it — even
    # though `map`/`filter` were excluded from the same vtable.
    var e: dyn Iterator<Item = int> = Counter::to(4);
    print(e.collect());
#> [0, 1, 2, 3]
}
