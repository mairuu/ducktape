# More iterator combinators (milestone 49): `take`, `enumerate`, `zip` are lazy
# adapters and `fold` is an eager consumer, all provided methods on `Iterator`.
# This file also pins the projection fix that shipped with them: a closure typed
# by the element of a *pass-through* adapter — `Filter<Counter>.Item` is
# `Counter.Item`, a projection over a projection — now collapses to the real
# element type, so `filter(..).map(..)` and `filter(..).fold(..)` check.
use std::iter::Iterator;
use std::option::Option;
use std::io::print;

struct Counter { n: Int, max: Int }

impl Counter {
    fun to(max: Int) -> Counter { Counter { n: 0, max: max } }
}

impl Iterator for Counter {
    type Item = Int;
    fun next(self) -> Option<Int> {
        if self.n >= self.max { return Option::None; }
        var v = self.n;
        self.n += 1;
        return Option::Some(v);
    }
}

fun main() {
    # take: at most the first n
    print(Counter::to(100).take(3).collect());
#> [0, 1, 2]

    # take past the end just stops with the source
    print(Counter::to(2).take(5).collect());
#> [0, 1]

    # enumerate: (index, element) pairs
    print(Counter::to(3).enumerate().collect());
#> [(0, 0), (1, 1), (2, 2)]

    # zip: lockstep, the shorter source sets the length
    print(Counter::to(5).zip(Counter::to(2)).collect());
#> [(0, 0), (1, 1)]

    # fold: reduce left to right into an accumulator
    print(Counter::to(5).fold(0, |acc, x| => acc + x));
#> 10

    # fold with a different accumulator type
    print(Counter::to(4).fold("", |s, x| => "{s}{x}"));
#> 0123

    # a lazy take is itself an iterator, so `for` drives it directly
    for y in Counter::to(10).map(|x| => x * x).take(4) {
        print(y);
    }
#> 0
#> 1
#> 4
#> 9

    # the projection fix: a closure over a filtered iterator's element. Here the
    # receiver is `Filter<Counter>`, whose `Item` is `Counter.Item` — one hop
    # short of `Int` until the fix collapsed it.
    print(Counter::to(6).filter(|v| => v % 2 == 0).map(|x| => x + 1).collect());
#> [1, 3, 5]

    print(Counter::to(6).filter(|v| => v % 2 == 0).fold(1, |a, x| => a * (x + 1)));
#> 15

    # a full pipeline mixing lazy adapters and an eager fold
    print(Counter::to(10).map(|x| => x * 10).take(4).fold(0, |a, x| => a + x));
#> 60
}
