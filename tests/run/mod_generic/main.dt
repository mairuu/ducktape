# instantiating a dependency's generics: the instances share the importer's
# one program-wide slot space, and `tag` dispatches to an impl declared here,
# in a module `util` never sees.
#> 1
#> 2
#> b
#> <int 7>
#> <bool true>
#> int 7!
#> bool true!
mod util;

use std::io::print;
use util::{Pair, swap, tag, loud, Label};

impl Label for int {
  fun label(self) -> string {
    return "int {self}";
  }
}

impl Label for bool {
  fun label(self) -> string {
    return "bool {self}";
  }
}

fun main() {
  var p = Pair::<int>::new(1, 2);
  print(p.left());
  print(swap(p).left());

  var s = Pair::<string>::new("a", "b");
  print(swap(s).left());

  print(tag(7));
  print(tag(true));

  # `shout` has a default body no impl here overrides
  var n = 7;
  print(n.shout());
  print(loud(true));
}
