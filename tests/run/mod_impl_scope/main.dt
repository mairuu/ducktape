use std::io::print;
use shape::{Show, sum_twice};
use pair::{Pair, mk};

# `impl Show for Pair` lives in pair.dt and is invisible inside shape.dt, yet
# shape::sum_twice compiles at T = Pair: the impl set travels with the
# instantiation request, not with the definition.
pub fun main() {
  print(sum_twice(mk(1, 2), mk(3, 4)));
#> 20
}
