pub trait Show {
  fun show(self) -> Int;

  fun twice(self) -> Int {
    return self.show() + self.show();
  }
}

# generic over any Show. This module cannot see a single impl of its own
# trait — the witness for `T: Show` is written wherever `sum_twice` is called.
pub fun sum_twice<T: Show>(a: T, b: T) -> Int {
  return a.twice() + b.twice();
}
