# a dependency with everything that needs a program-wide slot or a GC root of
# its own: a struct, an enum, impl methods, and string constants living in
# *this* module's chunks (interpolation text segments).

pub struct Rect {
  pub w: int,
  pub h: int,
}

pub enum Kind {
  Square,
  Oblong,
}

impl Rect {
  fun new(w: int, h: int) -> Rect {
    return Rect { w: w, h: h };
  }

  fun area(self) -> int {
    return self.w * self.h;
  }

  # the interpolation's text segments are constants of this method's chunk;
  # the GC only reaches them through the linked globals table.
  fun label(self) -> string {
    return "rect {self.w}x{self.h}";
  }

  fun kind(self) -> Kind {
    if self.w == self.h {
      return Kind::Square;
    }
    return Kind::Oblong;
  }
}
