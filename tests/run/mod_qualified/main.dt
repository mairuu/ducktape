# Module-qualified paths (milestone 33): `use a::b;` binds the module `b` as a
# path qualifier, so `b::thing` names an item of b without importing it by name.
# Its original motivation was two modules spelling the same name — `string::len`
# and `array::len` — but milestone 40 retired *that* collision a level deeper:
# both are methods now, told apart by their receiver's type, so no qualifier is
# needed for them at all. What a qualifier still buys is here — a qualified free
# function (`io::print`), a user module's types, associated calls and free
# functions (`geo::`), and an alias (`g`) — while the primitives' operations use
# the method spelling the milestone gave them.
mod geo;

use std::io;
use geo;
use geo as g; # a module may also be bound under an alias

fun quadrant_code(q: geo::Quadrant) -> int {
  match q {
    geo::Quadrant::First => 1,
    geo::Quadrant::Other => 0,
  }
}

# a qualified free function (`io::print`), a qualified type `geo::Quadrant` in a
# signature, a qualified associated call and free function, the alias `g`, and
# the primitives' `len`/`slice` as methods.
#> 11
#> 4
#> 8
#> 1
#> 0
#> world
fun main() {
  var s = "hello world";
  var xs = [1, 2, 3, 4];

  io::print(s.len());
  io::print(xs.len());

  var p = geo::Point::new(3, 5);
  io::print(p.manhattan());

  io::print(quadrant_code(geo::classify(p)));
  io::print(quadrant_code(g::classify(geo::Point::new(0, 0))));

  io::print(s.slice(6, 11));
}
