# Native functions: a bodyless declaration whose body is in C. A native is an
# ordinary global, so it is first-class — passable, storable, capturable — and
# that is the property this file exercises. `std::string` and `std::array` spell
# these operations as methods now (milestone 40), and a method is *not* a
# path-value, so the first-class demonstration declares its own free natives
# binding the very same C bodies. `@intrinsic` is the exception either way: it is
# an opcode, so it can only be called directly, never named as a value.
use std::io::print;

@native("string_len")
fun str_len(s: String) -> Int;

@native("string_slice")
fun str_slice(s: String, from: Int, to: Int) -> String;

@intrinsic("array_len")
fun alen<T>(xs: [T]) -> Int;

# a native is an ordinary global, so it is first-class: passable, storable,
# capturable. Only its *body* is unusual.
fun apply(f: fun(String) -> Int, s: String) -> Int => f(s)

fun main() {
    print("printed by a native");
#> printed by a native

    # @intrinsic: lowered to OP_LEN inline, no call frame at all
    print(alen([10, 20, 30]));
#> 3
    print(alen(["only one"]));
#> 1

    # @native: an ordinary OP_CALL into C
    print(str_len("abcd"));
#> 4
    print(str_slice("hello world", 6, 11));
#> world
    print(str_slice("hello", 0, 0));
#>

    # first-class, three ways
    var measure = str_len;
    print(measure("as a value"));
#> 10
    print(apply(str_len, "as an argument"));
#> 14
    var fs = [str_len, str_len];
    print(fs[1]("in an array"));
#> 11
    var doubled: fun(String) -> Int = |s| => str_len(s) * 2;
    print(doubled("captured"));
#> 16

    # an allocating native under repeated collection: the arguments stay on
    # the VM stack across the call, so the source string cannot be swept out
    # from under it.
    var total = 0;
    for i in 0..10 {
        total = total + str_len(str_slice("abcdefghij", 0, i));
    }
    print(total);
#> 45
}
