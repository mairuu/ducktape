# Milestone 39: a method's body may be `@native`/`@intrinsic`, so a primitive's
# operation can be spelled `s.len()` rather than as a free `string::len(s)`.
# `self` is an ordinary parameter to the C function, so the runtime dispatches a
# native method through the same OP_CALL as any other native — nothing below the
# signature changes. This file writes the attributes directly against the
# compiler's native/intrinsic registry rather than through std, which is left to
# spell its operations as it already does.
#
# The names below are deliberately ones std does not spend. Milestone 68 found
# this file calling `len` and `slice` from `std::string`/`std::array` rather
# than its own: the declarations were byte-identical, so the tautology printed
# the right answers for years. An inherent name is one per type, and these are
# the file's own.

use std::io::print;

# A native method: its body is the C function `string_len`, reached by name.
impl String {
    @native("string_len") fun byte_count(self) -> int;
    @native("string_slice") fun sub(self, from: int, to: int) -> String;
}

# An intrinsic method: `self.elem_count()` lowers to the OP_LEN opcode inline,
# with no global slot and no call frame — the same tier the `for` desugaring
# uses, now nameable on a receiver. Works over the generic `impl<T> [T]` too.
impl<T> [T] {
    @intrinsic("array_len") fun elem_count(self) -> int;
}

# A native method satisfying a trait: it takes an ordinary vtable slot, so a
# `dyn` receiver dispatches to it dynamically like any other method.
trait Measure { fun size(self) -> int; }
impl Measure for String {
    @native("string_len") fun size(self) -> int;
}

fun total(items: [dyn Measure]) -> int {
    var acc = 0;
    for it in items {
        acc = acc + it.size();
    }
    return acc;
}

fun main() {
    var s = "hello";
    print(s.byte_count());
    print(s.sub(1, 3));

    var xs = [10, 20, 30, 40];
    print(xs.elem_count());

    # dispatch through a native method carried in a `dyn Measure` vtable
    print(total(["ab", "cde", "f"]));
}

#> 5
#> el
#> 4
#> 6
