# Milestone 75 — a heterogeneous operator. `V2 * Float` had no spelling before,
# because the `std::ops` traits took `other: Self`: an operator would have had
# to pick an impl by its *right* operand, and selection by argument type existed
# only through the written `Meters::from(x)` / `Into::<U>::into(x)` forms.
#
# The traits now read `trait Mul<Rhs = Self>`, and the two halves of that answer
# the two halves of the problem. `Rhs` is what lets one type implement `Mul`
# more than once. The **default** is what keeps every existing use working: a
# bare `Mul` still means `Mul<Self>`, so `impl Mul for V2` and `fun twice<T:
# Add>` say exactly what they said before, and nothing in `std` moved.
#
# Every result here is the left operand's type, which was all milestone 75 could
# say: `V2 * 2.0` is a `V2` because scaling a vector does not change what it is.
# The `type Output` lines are milestone 76's, and each one here writes down the
# answer this file already had. What that milestone *adds* — a result that is
# neither operand's type — is `ops_output.dt`.

#> 3.0
#> 4.5
#> 2.25
#> 3.0
#> -2.0
#> 4.5
#> 30

use std::io::print;
use std::ops::{Add, Mul, Neg};
use std::convert::From;

struct V2 { x: Float, y: Float }

# the homogeneous spelling, unchanged by the milestone: `Add` with no argument
# is `Add<Self>`, which is `Add<V2>` here.
impl Add for V2 {
    type Output = V2;
    fun add(self, other: V2) -> V2 {
        return V2 { x: self.x + other.x, y: self.y + other.y };
    }
}

impl Mul for V2 {
    type Output = V2;
    fun mul(self, other: V2) -> V2 {
        return V2 { x: self.x * other.x, y: self.y * other.y };
    }
}

# three impls of one trait for one type, told apart by the right operand alone.
# Coherence lets them stand for milestone 28's reason — they differ in the
# trait's argument — and the operator now *reads* that argument.
impl Mul<Float> for V2 {
    type Output = V2;
    fun mul(self, k: Float) -> V2 {
        return V2 { x: self.x * k, y: self.y * k };
    }
}

impl Mul<Int> for V2 {
    type Output = V2;
    fun mul(self, k: Int) -> V2 {
        var f = Float::from(k);
        return V2 { x: self.x * f, y: self.y * f };
    }
}

# `Neg` has no right operand, so it never grew a parameter: it is the one
# operator trait still spelled exactly as milestone 55 wrote it.
impl Neg for V2 {
    type Output = V2;
    fun neg(self) -> V2 { return V2 { x: 0.0 - self.x, y: 0.0 - self.y }; }
}

# a bound with no argument still means the homogeneous impl, which is the whole
# point of the default. The `Output = T` is milestone 76's cost: there is no
# default for an associated type, so a bound that does not name the result gets
# an opaque `T.Output` back and cannot return it as a `T`.
fun twice<T: Add<Output = T>>(v: T) -> T { return v + v; }

# and a bound may *name* its subject — in both halves. `Add<T, Output = T>` is
# the argument and the binding both pointing back at the bounded parameter,
# which is what the defaults expand to and what milestone 75 made expressible.
fun thrice<T: Add<T, Output = T>>(v: T) -> T { return v + v + v; }

struct Cents { v: Int }

# heterogeneity is not only about a scalar: two unrelated types, one operator.
impl Add<Int> for Cents {
    type Output = Cents;
    fun add(self, n: Int) -> Cents { return Cents { v: self.v + n }; }
}

fun main() {
    var v = V2 { x: 1.5, y: 2.0 };

    print((v * 2.0).x);  # Mul<Float> -> 3.0
    print((v * 3).x);    # Mul<Int>   -> 4.5
    print((v * v).x);    # Mul<V2>    -> 2.25
    print(twice(v).x);   # Add<V2>    -> 3.0
    print((-v).y);       # Neg        -> -2.0
    print(thrice(v).x);  # Add<V2>    -> 4.5

    var c = Cents { v: 25 };
    print((c + 5).v);    # Add<Int>   -> 30
}
