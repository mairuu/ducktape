# `Some`, `None`, `Ok` and `Err` are preluded: no `use` for any of them here.
use std::io::print;

fun half(n: Int) -> Option<Int> {
  if n % 2 == 0 {
    return Some(n / 2);
  }
  return None;
}

fun parse(s: String) -> Result<Int, String> {
  if s == "1" {
    return Ok(1);
  }
  return Err("not a one");
}

pub fun main() {
  match half(8) {
    Some(v) => { print("half {v}"); },
#> half 4
    None => { print("odd"); },
  }
  match parse("x") {
    Ok(v) => { print("ok {v}"); },
    Err(e) => { print("err {e}"); },
#> err not a one
  }
  if var Some(n) = half(4) {
    print(n);
#> 2
  }
  var o: Option<Int> = None;
  print(o.unwrap_or(7));
#> 7
}
