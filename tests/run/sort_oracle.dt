# The sort checked against an oracle rather than against a written-down answer.
#
# `sort.dt` next door pins the API — what each call answers, and that the order
# is stable. What it cannot pin is the *algorithm*: a merge sort's bugs live in
# the tail run of an odd-length pass and in the parity of the copy-back, which
# only appear at lengths nobody writes an expected array for. So this walks
# every length up to 40, sorts a pseudo-random array with duplicates, and
# compares against a quadratic insertion sort written out here — trivially
# correct, and independent of everything `std::sort` does.
#
# `==` on two arrays is structural (milestone 5c-i), so one comparison checks
# the whole result: same elements, same order, same length.
#> mismatches: 0
use std::io::print;
use std::sort;
use std::array;

# a deterministic stream, so a failure is reproducible rather than a story
fun lcg(seed: Int) -> Int {
    return (seed * 1103515245 + 12345) % 2147483648;
}

fun insertion(xs: [Int]) {
    var i = 1;
    while i < xs.len() {
        var j = i;
        while j > 0 and xs[j - 1] > xs[j] {
            var t = xs[j - 1];
            xs[j - 1] = xs[j];
            xs[j] = t;
            j = j - 1;
        }
        i = i + 1;
    }
}

fun main() {
    var bad = 0;
    var n = 0;
    while n <= 40 {
        var xs: [Int] = [];
        var seed = n * 31 + 3;
        var i = 0;
        while i < n {
            seed = lcg(seed);
            # a small range on purpose: duplicates are where stability and the
            # merge's tie-breaking are decided
            xs.push(seed % 20);
            i = i + 1;
        }
        var oracle = xs.iter().collect();
        insertion(oracle);
        xs.sort();
        if not (xs == oracle) {
            print("MISMATCH n={n}: {xs} vs {oracle}");
            bad = bad + 1;
        }
        n = n + 1;
    }
    print("mismatches: {bad}");
}
