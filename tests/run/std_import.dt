# `use std::..` names an embedded module: same registry, same dependency
# graph, same `pub` rules as a user import — only the bytes come from the
# binary rather than the filesystem. An alias works because the import is
# ordinary all the way down.
use std::io::print as show;

fun main() {
  show(1);
  show("two");
}
#> 1
#> two
