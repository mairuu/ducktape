# std modules nest, and a `pub use` carries a type *out* of a private one:
# `HashMap` and `HashSet` live in `std::collections::hashmap` and
# `::hashset`, which nothing outside the group may name, so the facade's
# re-export is the only path to them. `StringBuf`'s impl arrives the same way,
# through `std::string`, which is the module `join` is an item of.
#> 7
#> 2
#> ab-c

use std::io::print;
use std::collections::{HashMap, HashSet};
use std::string::join;

fun main() {
    var s: HashSet<int> = HashSet::new();
    s.insert(7);
    s.insert(7);
    print(s.to_array()[0]);

    var counts: HashMap<String, int> = HashMap::new();
    counts.insert("a", 1);
    counts.insert("b", 2);
    print(counts.len());

    var b = StringBuf::new();
    b.push("a");
    b.push("b");
    print(join([b.build(), "c"], "-"));
}
