# std::option — the module, and the unit-variant inference it needs.
#> true
#> false
#> 3
#> 7
#> 9
#> 6
#> v=3
#> none
#> Some(4)
#> None
#> Some(15)
#> Some(1)
#> true
#> false
#> -1

use std::io::print;
use std::option::Option;
use std::cmp::min;

fun halve(n: int) -> Option<int> {
    if n % 2 == 0 {
        return Option::Some(n / 2);
    }
    # a bare unit variant of a generic enum, inferred from the return type
    return Option::None;
}

fun takes(o: Option<int>) -> int {
    return o.unwrap_or(7);
}

fun main() {
    var some = Option::Some(3);
    print(some.is_some());
    print(some.is_none());
    print(some.unwrap_or(0));

    # inferred from the parameter type of a non-generic function
    print(takes(Option::None));
    # ... and from the annotation
    var none: Option<int> = Option::None;
    print(none.unwrap_or_else(|| 9));

    print(some.map(|x| x * 2).unwrap_or(0));
    print(some.map(|x| "v={x}").unwrap_or("none"));
    print(none.map(|x| "v={x}").unwrap_or("none"));

    print(halve(8));
    print(halve(7));
    print(some.and_then(|x| halve(x * 10)).otherwise(Option::Some(0)));
    print(none.otherwise(Option::Some(1)));

    print(some.filter(|x| x > 2).is_some());
    print(some.filter(|x| x > 3).is_some());

    # Option is ordered where its contents are: None sorts first.
    print(min(some, none).cmp(some));
}
