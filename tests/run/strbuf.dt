# A `StringBuf` is the object a `String` cannot be: uninterned, so it can be
# appended to in place. interning is what makes a String immutable — two equal
# strings are one pointer — so the two are different kinds, and `build` is the
# one-way door between them. Both spell `len`; a method resolves on its
# receiver, so `b.len()` and `s.len()` coexist with no qualifier needed.
#> true
#> 0
#> []
#> 12
#> hello, world
#> hello, world!
#> 13
#> StringBuf("hello, world!")
#> 14
#> 200
#> abab
#> true
#> true
#> false
#> a, b, c
#> []
#> ab
#> =====
#> []
#> 11
#> 42
#> 42/-7/0
#> n=1
#> n=2
#> n=3
#> true

use std::io::print;
use std::string::{join, concat};

fun main() {
    var b = StringBuf::new();
    print(b.is_empty());
    print(b.len());
    print("[{b.build()}]"); # an empty buffer has no allocation at all

    b.push("hello");
    b.push(", ");
    b.push("world");
    print(b.len());
    print(b.build());

    # `build` is a snapshot rather than a handover: the buffer is unchanged and
    # can still be appended to
    b.push("!");
    print(b.build());
    print(b.len());

    # `print` is the debug view, so it says which of the two kinds it has —
    # the one place the difference is visible without calling `build`
    print(b);

    # a buffer is a reference to one growable object, exactly like a `[T]`
    var alias = b;
    alias.push("?");
    print(b.len());

    # 100 pushes from a floor of 16 doubles the buffer four times, so every
    # byte survives being copied. Nothing here allocates a String per copy,
    # which is the difference a buffer makes.
    var line = "ab".repeat(100);
    print(line.len());
    print(line.slice(0, 4));

    # equality is the other place the kinds differ: a String compares by
    # pointer because it is interned, a buffer has to compare its bytes
    var x = StringBuf::new();
    x.push("ab");
    var y = StringBuf::new();
    y.push("ab");
    print(x == y);
    print(x.build() == y.build());
    y.push("c");
    print(x == y);

    var sep = ", ";
    print(join(["a", "b", "c"], sep));
    var none: [String] = [];
    print("[{join(none, sep)}]");
    print(concat(["a", "b"]));
    print("=".repeat(5));
    var zero = "x".repeat(0);
    print("[{zero}]");

    # an ordinary value: it goes in containers like anything else
    var bs = [StringBuf::new(), StringBuf::new()];
    bs[0].push("in an array");
    print(bs[0].len());

    # the loop the buffer exists for: with `+` this interns every prefix on
    # the way, so it is quadratic in the bytes it touches
    var out = StringBuf::new();
    for i in 0..26 {
        out.push("{i}");
    }
    print(out.build().len());

    # `push_int` puts an int's decimal digits straight in — no throwaway "{n}"
    # String interned to carry them, the same saving `push_char` makes for a char
    var nums = StringBuf::new();
    nums.push_int(42);
    nums.push("/");
    nums.push_int(-7);
    nums.push("/");
    nums.push_int(0);
    print(nums.build());

    # `clear` empties a buffer but keeps the capacity it grew to, so one buffer
    # serves a whole loop instead of a fresh `new()` each round
    var row = StringBuf::new();
    for i in 1..4 {
        row.clear();
        row.push("n=");
        row.push_int(i);
        print(row.build());
    }
    row.clear();
    print(row.is_empty());
}
