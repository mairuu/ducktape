# A `StringBuf` is the object a `String` cannot be: uninterned, so it can be
# appended to in place. Interning is what makes a String immutable — two equal
# strings are one pointer — so the two are different kinds, and `build` is the
# one-way door between them. `std::strbuf` and `std::string` both spell `len`;
# the qualifier is what lets `strbuf::len(b)` sit beside `string::len` here.
#> true
#> 0
#> []
#> 12
#> hello, world
#> hello, world!
#> 13
#> StringBuf("hello, world!")
#> 14
#> 200
#> abab
#> true
#> true
#> false
#> a, b, c
#> []
#> ab
#> =====
#> []
#> 11
#> 42
#> 42/-7/0
#> n=1
#> n=2
#> n=3
#> true

use std::io::print;
use std::strbuf;
use std::string::{join, concat, repeat, len, slice};

fun main() {
    var b = strbuf::new();
    print(strbuf::is_empty(b));
    print(strbuf::len(b));
    print("[{strbuf::build(b)}]"); # an empty buffer has no allocation at all

    strbuf::push(b, "hello");
    strbuf::push(b, ", ");
    strbuf::push(b, "world");
    print(strbuf::len(b));
    print(strbuf::build(b));

    # `build` is a snapshot rather than a handover: the buffer is unchanged and
    # can still be appended to
    strbuf::push(b, "!");
    print(strbuf::build(b));
    print(strbuf::len(b));

    # `print` is the debug view, so it says which of the two kinds it has —
    # the one place the difference is visible without calling `build`
    print(b);

    # a buffer is a reference to one growable object, exactly like a `[T]`
    var alias = b;
    strbuf::push(alias, "?");
    print(strbuf::len(b));

    # 100 pushes from a floor of 16 doubles the buffer four times, so every
    # byte survives being copied. Nothing here allocates a String per copy,
    # which is the difference a buffer makes.
    var line = repeat("ab", 100);
    print(len(line));
    print(slice(line, 0, 4));

    # equality is the other place the kinds differ: a String compares by
    # pointer because it is interned, a buffer has to compare its bytes
    var x = strbuf::new();
    strbuf::push(x, "ab");
    var y = strbuf::new();
    strbuf::push(y, "ab");
    print(x == y);
    print(strbuf::build(x) == strbuf::build(y));
    strbuf::push(y, "c");
    print(x == y);

    var sep = ", ";
    print(join(["a", "b", "c"], sep));
    var none: [String] = [];
    print("[{join(none, sep)}]");
    print(concat(["a", "b"]));
    print(repeat("=", 5));
    var zero = repeat("x", 0);
    print("[{zero}]");

    # an ordinary value: it goes in containers like anything else
    var bs = [strbuf::new(), strbuf::new()];
    strbuf::push(bs[0], "in an array");
    print(strbuf::len(bs[0]));

    # the loop the buffer exists for: with `+` this interns every prefix on
    # the way, so it is quadratic in the bytes it touches
    var out = strbuf::new();
    for i in 0..26 {
        strbuf::push(out, "{i}");
    }
    print(len(strbuf::build(out)));

    # `push_int` puts an Int's decimal digits straight in — no throwaway "{n}"
    # String interned to carry them, the same saving `push_char` makes for a Char
    var nums = strbuf::new();
    strbuf::push_int(nums, 42);
    strbuf::push(nums, "/");
    strbuf::push_int(nums, -7);
    strbuf::push(nums, "/");
    strbuf::push_int(nums, 0);
    print(strbuf::build(nums));

    # `clear` empties a buffer but keeps the capacity it grew to, so one buffer
    # serves a whole loop instead of a fresh `new()` each round
    var row = strbuf::new();
    for i in 1..4 {
        strbuf::clear(row);
        strbuf::push(row, "n=");
        strbuf::push_int(row, i);
        print(strbuf::build(row));
    }
    strbuf::clear(row);
    print(strbuf::is_empty(row));
}
