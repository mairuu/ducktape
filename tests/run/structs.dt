# struct instances: named + tuple structs, field access, printing,
# structural ==
#> Point { x: 1, y: 2 }
#> 1
#> 2
#> Wrapper(10, 20)
#> 10
#> 20
#> true
#> false
#> 2
use std::io::print;

struct Point {
    x: Int,
    y: Int,
}

struct Wrapper(Int, Int)

fun main() {
    var p = Point { x: 1, y: 2 };
    print(p);
    print(p.x);
    print(p.y);

    var w = Wrapper(10, 20);
    print(w);
    print(w.0);
    print(w.1);

    print(p == Point { x: 1, y: 2 });
    print(p == Point { x: 1, y: 3 });

    var moved = Point { x: p.x + 1, y: p.y };
    print(moved.x);
}
