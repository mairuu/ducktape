# A supertrait obligation is *discharged*, not merely checked: an impl of a
# trait implements the trait's whole supertrait closure, taking each of a
# super's items from the block if it writes one and from the super's default
# body otherwise. What neither supplies is still the error
# (tests/fail/supertrait_partial.dt).
use std::io::print;
use std::cmp::Ord;
use std::fmt::Display;

# ── the block supplies the super's method ────────────────────────────────────

trait Greet {
    fun name(self) -> string;
    fun hi(self) -> string { return "hi {self.name()}"; }
}

trait Loud: Greet {
    fun shout(self) -> string;
    fun loud_hi(self) -> string { return "{self.hi()}!"; }
}

struct P;

# no `impl Greet for P` anywhere: this block is where `name` lives, and the
# `impl Greet for P` it implies is derived from it.
impl Loud for P {
    fun name(self) -> string { return "p"; }
    fun shout(self) -> string { return "HI"; }
}

# the derived impl has to be a real one, not a relaxed check: a bound and a
# `dyn` both search the impl index and neither can see a method the block
# happens to contain.
fun greet_bound<T: Greet>(x: T) -> string { return x.name(); }
fun greet_dyn(x: dyn Greet) -> string { return x.name(); }

# ── the derivation is transitive, because it walks the closure ───────────────

trait A { fun a(self) -> int; }
trait B: A { fun b(self) -> int; }
trait C: B { fun c(self) -> int; }

struct Z;

impl C for Z {
    fun a(self) -> int { return 1; }
    fun b(self) -> int { return 2; }
    fun c(self) -> int { return 4; }
}

fun via_a<T: A>(x: T) -> int { return x.a(); }
fun via_b<T: B>(x: T) -> int { return x.a() + x.b(); }

# ── a generic impl derives a generic impl ────────────────────────────────────

struct W<T> { v: T }

# the derived `Greet` impl copies the parameters and their bounds, so it
# applies under exactly the conditions this one does.
impl<T: Ord + Display> Loud for W<T> {
    # the body is monomorphised per `T` through the *derived* impl, so the two
    # instantiations below must not collapse onto one another.
    fun name(self) -> string { return "w{self.v}"; }
    fun shout(self) -> string { return "W!"; }
}

# ── nothing to write: the super's defaults supply it on their own ────────────

trait Tagged {
    fun tag(self) -> string { return "generic"; }
}

trait Special: Tagged {
    fun kind(self) -> string;
}

struct S1;
struct S2;

# `impl Tagged for S1 {}` used to be required and could only ever be empty.
impl Special for S1 {
    fun kind(self) -> string { return "plain"; }
}

# the block may still override a defaulted super method — then the derived
# impl carries it, and the default is the one that goes unused.
impl Special for S2 {
    fun kind(self) -> string { return "custom"; }
    fun tag(self) -> string { return "S2"; }
}

fun tag_of<T: Tagged>(x: T) -> string { return x.tag(); }

# ── a marker super requires nothing, so it is always derivable ───────────────

trait Marker {}

trait Counted: Marker {
    fun count(self) -> int;
}

struct M;

impl Counted for M {
    fun count(self) -> int { return 9; }
}

fun marked<T: Marker>(_x: T) -> int { return 1; }

fun main() {
    print(P.name());
#> p
    print(P.shout());
#> HI
    print(greet_bound(P));
#> p
    print(greet_dyn(P));
#> p
    # a trait-qualified path names the super directly, so it goes through the
    # derived impl and nothing else.
    print(Greet::name(P));
#> p
    # the super's own default body dispatches to a method the *block* supplied,
    # and the sub's default reaches the super's through the same edge.
    print(P.hi());
#> hi p
    print(P.loud_hi());
#> hi p!

    print("{via_a(Z)}");
#> 1
    print("{via_b(Z)}");
#> 3
    print("{Z.c()}");
#> 4

    print(greet_bound(W { v: 1 }));
#> w1
    print(greet_bound(W { v: "x" }));
#> wx

    print(tag_of(S1));
#> generic
    print(tag_of(S2));
#> S2
    print(S2.kind());
#> custom

    print("{marked(M)}");
#> 1
    print("{M.count()}");
#> 9
}
