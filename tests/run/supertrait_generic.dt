# A *generic* trait as a supertrait: `trait Twice<T>: Src<T>`.
#
# The closure stores each entry in the terms of the trait whose closure it is,
# so `Src<T>` is recorded with `Twice`'s own `T`. Every reader then restates it
# through the reference that named the trait — `Twice<int>` makes the super
# `Src<int>` — which is the same substitution a call through a bound has always
# applied to a trait's signatures, one level out.
use std::io::print;

trait Src<T> {
    fun get(self) -> T;
}

trait Twice<T>: Src<T> {
    # a default body reaching the super's method through `Self`'s own bound
    fun pair(self) -> (T, T) {
        return (self.get(), self.get());
    }
}

struct Five;
struct Word;

impl Src<int> for Five {
    fun get(self) -> int { return 5; }
}
impl Twice<int> for Five {}

impl Src<string> for Word {
    fun get(self) -> string { return "hi"; }
}
impl Twice<string> for Word {}

# `S: Twice<T>` entails `S: Src<T>`, arguments and all — trait references are
# interned, so the comparison covers them without a special case
fun once<T, S: Src<T>>(s: S) -> T {
    return s.get();
}

fun both<T, S: Twice<T>>(s: S) -> (T, T) {
    return (once::<T, S>(s), s.pair().0);
}

fun main() {
    print(Five.pair());
#> (5, 5)
    print(Word.pair());
#> (hi, hi)
    print(both::<int, Five>(Five));
#> (5, 5)
    print(both::<string, Word>(Word));
#> (hi, hi)

    # and through a trait object, whose vtable carries the super's `get`
    var d: dyn Twice<int> = Five;
    print(d.get());
#> 5
}
