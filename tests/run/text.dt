# std::text — searching, splitting, trimming and parsing, as methods on String.
# Since milestone 102 it also owns cutting, because it owns the positions.

use std::io::print;
use std::option::Option;
use std::text::StrPos;   # names the type, and brings the module's impls with it

fun show_int_opt(label: String, o: Option<int>) {
    print("{label}: {o}");
}

# `find` answers a position, not a number, so a test that wants to print one
# has to say which question it is asking: `byte_offset` reads a position, and
# nothing turns the answer back into one.
fun show_pos_opt(label: String, o: Option<StrPos>) {
    var at = o.map(|p| p.byte_offset());
    print("{label}: {at}");
}

fun main() {
    # starts_with / ends_with, including the empty and too-long edges.
    var a = "hello".starts_with("he");
    print("{a}");
#> true
    var b = "hello".starts_with("lo");
    print("{b}");
#> false
    var c = "hi".starts_with("hello");
    print("{c}");
#> false
    var d = "hello".starts_with("");
    print("{d}");
#> true
    var e = "hello".ends_with("lo");
    print("{e}");
#> true
    var f = "hello".ends_with("he");
    print("{f}");
#> false

    # find: first hit as a position, miss, and the empty needle.
    show_pos_opt("f-l", "hello".find("l"));
#> f-l: Some(2)
    show_pos_opt("f-ell", "hello".find("ell"));
#> f-ell: Some(1)
    show_pos_opt("f-z", "hello".find("z"));
#> f-z: None
    show_pos_opt("f-empty", "hello".find(""));
#> f-empty: Some(0)

    var has = "hello world".contains("o w");
    print("{has}");
#> true
    var nope = "hello".contains("xyz");
    print("{nope}");
#> false

    # split: one more piece than separators; empty pieces at the edges and
    # between adjacent separators; the empty separator returns the whole.
    for p in "a,b,,c".split(",") {
        print("[{p}]");
    }
#> [a]
#> [b]
#> []
#> [c]
    for p in ",x,".split(",") {
        print("<{p}>");
    }
#> <>
#> <x>
#> <>
    for p in "whole".split("") {
        print("{p}");
    }
#> whole

    # trim: both ends, interior preserved, and all-whitespace to empty.
    var t1 = "  hi there  ".trim();
    print("[{t1}]");
#> [hi there]
    var t2 = "nospace".trim();
    print("[{t2}]");
#> [nospace]
    var t3 = "   ".trim();
    print("[{t3}]");
#> []

    # parse_int: signs, and the three ways to spell "not a number".
    show_int_opt("p", "42".parse_int());
#> p: Some(42)
    show_int_opt("pp", "+7".parse_int());
#> pp: Some(7)
    show_int_opt("pn", "-42".parse_int());
#> pn: Some(-42)
    show_int_opt("pe", "".parse_int());
#> pe: None
    show_int_opt("ps", "-".parse_int());
#> ps: None
    show_int_opt("px", "12x".parse_int());
#> px: None

    # parse_int composes with trim: parse after trimming leading space.
    show_int_opt("pt", "  99 ".trim().parse_int());
#> pt: Some(99)

    # positions: the two ends a string always has, and one from a search. The
    # only cuts a program can write are between positions it was handed.
    var kv = "key=value";
    if var Option::Some(eq) = kv.find("=") {
        var head = kv.slice(kv.start(), eq);
        var rest = kv.slice(eq, kv.end());
        print("[{head}][{rest}]");
    }
#> [key][=value]

    # split_once is the step *past* a match, which is the one piece of offset
    # arithmetic a program cannot do on a position of its own.
    if var Option::Some((k, v)) = kv.split_once("=") {
        print("{k} -> {v}");
    }
#> key -> value
    var none = "nosep".split_once("=").is_some();
    print("{none}");
#> false

    # counting is the other verb: characters off an end, and never a position.
    print("showcase".take_chars(4));
#> show
    print("showcase".drop_chars(4));
#> case
    var over = "hi".drop_chars(9);
    print("[{over}]");
#> []
}
