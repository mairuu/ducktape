# Searching text that is not ASCII, which is where a byte offset stops being a
# character position and the two have to agree anyway (milestone 101).
#
# The property everything below rests on is UTF-8's self-synchronisation: a
# valid needle begins with a lead byte, and a lead byte never appears where a
# continuation byte belongs. So a scan over *every* byte offset finds only real
# occurrences, and every offset it returns is a character boundary — which is
# what makes a `slice` at one safe when a `slice` at an arbitrary offset is an
# error.

use std::io::print;
use std::option::Option;
use std::text;

fun main() {
    # a(1) é(2) ☃(3) 😀(4) — every width, so every offset that is not a
    # boundary is one of five.
    var s = "aé☃😀";
    print(s.len());
#> 10

    # the compare, at the only positions a program can name: the two ends, and
    # one a search handed back. The mid-character offsets this used to check —
    # 2 inside é, 8 inside 😀 — cannot be written at all since milestone 102.
    # The native still answers `false` at one; `find` below is where that is
    # now observed from outside, because its scan still visits them.
    print(s.matches_at(s.start(), "a"));
#> true
    print(s.matches_at(s.start(), "☃"));
#> false
    print(s.matches_at(s.end(), ""));
#> true

    # find lands on boundaries, and the position it hands back is one `slice`
    # accepts — the two halves of the redesign meeting.
    if var Option::Some(at) = s.find("☃") {
        print(at.byte_offset());
        print(s.slice(s.start(), at));
        print(s.slice(at, s.end()));
        print(s.matches_at(at, "☃"));
    }
#> 3
#> aé
#> ☃😀
#> true

    # a needle whose first byte cannot be mistaken for one inside a character:
    # 日 and 本 both begin 0xE6, and the scan still reports 本 at 3 rather than
    # at either offset inside 日 — which is the mid-character `false` the test
    # above can no longer ask for directly.
    #
    # A position prints structurally, string and offset both: opacity is about
    # minting one, never about reading one. The string it names is the half that
    # makes the offset mean something.
    var jp = "日本語";
    print(jp.find("本"));
#> Some(StrPos { s: 日本語, off: 3 })
    print(jp.starts_with("日"));
#> true
    print(jp.starts_with("本"));
#> false
    print(jp.ends_with("語"));
#> true
    print(jp.contains("本語"));
#> true

    # cutting at a multi-byte separator, and cutting multi-byte pieces at an
    # ASCII one. Every piece is whole either way.
    for p in "a☃b☃c".split("☃") {
        print("[{p}]");
    }
#> [a]
#> [b]
#> [c]
    for p in "é,☃,😀".split(",") {
        print("<{p}>");
    }
#> <é>
#> <☃>
#> <😀>

    # the pads count characters, so a string of them is four wide and not ten.
    print("[{s:>6}]");
#> [  aé☃😀]
}
