# A trait object is the dual of monomorphisation: the choice of *which body a
# call resolves to* can't be made at compile time, so the value carries it.
#> square has area 9
#> a 2x5 rect
#> square has area 1
#> 20
#> 16
#> square
#> 9
#> 25
#> 9
#> true
#> false
#> Sq { s: 3 }
#> 3
#> 18
#> 9
#> 16

use std::io::print;

trait Shape {
    fun area(self) -> int;
    fun name(self) -> string;

    # a default body, reached through the vtable like any other method
    fun describe(self) -> string {
        return "{self.name()} has area {self.area()}";
    }
}

struct Sq { s: int }
struct Rect { w: int, h: int }

# a trait object in a struct field, and in a tuple
struct Slot { it: dyn Shape, tag: int }

impl Shape for Sq {
    fun area(self) -> int { self.s * self.s }
    fun name(self) -> string { "square" }
}

impl Shape for Rect {
    fun area(self) -> int { self.w * self.h }
    fun name(self) -> string { "rect" }
    # overrides the default: the vtable slot points here instead
    fun describe(self) -> string { "a {self.w}x{self.h} rect" }
}

# a heterogeneous collection — the thing static dispatch cannot express
fun total(xs: [dyn Shape]) -> int {
    var sum = 0;
    for s in xs {
        sum += s.area();
    }
    return sum;
}

# coercion in return position, from inside a branch
fun pick(big: bool) -> dyn Shape {
    if big {
        return Rect { w: 4, h: 4 };
    }
    return Sq { s: 2 };
}

# a generic function hands its own type parameter over as a trait object:
# the bound is the static witness, the vtable is the runtime one
fun as_object<T: Shape>(v: T) -> int {
    var obj: dyn Shape = v;
    return obj.area();
}

fun main() {
    var shapes: [dyn Shape] = [Sq { s: 3 }, Rect { w: 2, h: 5 }, Sq { s: 1 }];
    for s in shapes {
        print(s.describe());
    }
    print(total(shapes));

    # coercion in argument position, at a call site
    print(pick(true).area());
    print(pick(false).name());

    print(as_object(Sq { s: 3 }));
    print(as_object(Rect { w: 5, h: 5 }));

    # two coercions of the same type share one vtable; the value round-trips
    var a: dyn Shape = Sq { s: 3 };
    var b: dyn Shape = Sq { s: 3 };
    var c: dyn Shape = Rect { w: 1, h: 9 };
    print(a.area());
    print(a == b);
    print(a == c);

    # printing and field-free equality see through the wrapper
    print(a);

    # a closure capturing a trait object still dispatches dynamically
    var f: fun() -> int = || a.area() / 3;
    print(f());

    # a trait object passed on as a trait object — no re-wrapping
    print(total([a, c]));

    # coercion into a struct field and into a tuple element
    var slot = Slot { it: Rect { w: 3, h: 3 }, tag: 1 };
    print(slot.it.area());
    var pair: (dyn Shape, int) = (Sq { s: 4 }, 2);
    print(pair.0.area());
}
