# A trait-qualified call resolves through the `std::convert` blanket
# `impl<T, U: From<T>> into<U> for T`: `into` is never written for a type, yet
# `into::<Fahrenheit>::into(c)` selects the `From` impl the trait reference
# names — and monomorphises the blanket body `U::from(self)` at the concrete
# `U`, exactly as `x.into()` does. The trait reference is the only thing that
# disambiguates, since `Celsius` goes `into` two ways.
use std::io::print;
use std::convert::{From, into};

#> 212
#> 273

struct Celsius { deg: int }
struct Fahrenheit { deg: int }
struct Kelvin { deg: int }

impl From<Celsius> for Fahrenheit {
    fun from(c: Celsius) -> Fahrenheit {
        return Fahrenheit { deg: c.deg * 9 / 5 + 32 };
    }
}

impl From<Celsius> for Kelvin {
    fun from(c: Celsius) -> Kelvin {
        return Kelvin { deg: c.deg + 273 };
    }
}

fun main() {
    var boiling = Celsius { deg: 100 };
    var f = into::<Fahrenheit>::into(boiling);
    print("{f.deg}");

    var freezing = Celsius { deg: 0 };
    var k = into::<Kelvin>::into(freezing);
    print("{k.deg}");
}
