# A variant imported by name is written bare, as a constructor and as a
# pattern. The enum itself is a separate import: `Option` here, `Some`/`None`
# there.
use std::option::Option;
use std::option::Option::{Some, None};
use std::result::Result::Ok as Yes;
use std::io::print;

fun half(n: int) -> Option<int> {
  if n % 2 == 0 {
    return Some(n / 2);
  }
  return None;
}

pub fun main() {
  match half(6) {
    Some(v) => { print("half {v}"); },
#> half 3
    None => { print("odd"); },
  }
  match half(5) {
    Some(v) => { print("half {v}"); },
    None => { print("odd"); },
#> odd
  }

  # a unit variant as a value, and the qualified spelling beside the bare one.
  var o: Option<int> = None;
  print(o.is_none());
#> true
  print(Some(4).unwrap_or(0));
#> 4
  print(Option::Some(9).unwrap());
#> 9

  var r: Result<int, String> = Yes(2);
  print(r.unwrap());
#> 2
}
